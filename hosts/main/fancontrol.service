[Unit]
Description=Rust CPU/GPU motherboard fan controller
# Never order this unit after power-profiles-daemon: the daemon is ordered after
# multi-user.target, this unit is wanted by (and therefore ordered before)
# multi-user.target, and systemd deletes the fan start job when that becomes
# a boot ordering cycle. The controller follows the daemon over D-Bus.
After=systemd-modules-load.service lm_sensors.service
# Keep retrying failed starts: a fan failsafe must not give up.
StartLimitIntervalSec=0

[Service]
Type=notify-reload
Environment="FAN_HARDWARE=--controller nct6798 --channels 1,2,3,4"
RuntimeDirectory=main-fan-control
RuntimeDirectoryMode=0700
ExecStart=/usr/local/libexec/host-tools fan-control run $FAN_HARDWARE /etc/main-fan-control.json --status /run/main-fan-control/status.json
ExecStopPost=/usr/local/libexec/host-tools fan-control automatic $FAN_HARDWARE
WatchdogSec=10s
WatchdogSignal=SIGKILL
TimeoutStartSec=15s
Restart=always
RestartSec=2s
TimeoutStopSec=10s
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
