host=192.168.1.166
status=exit status: 0
script:
set -eu
test "$(systemctl show 'predator-pm-r-serial-q37-20261030-wake'.timer -p LoadState --value)" = not-found
test "$(systemctl show 'predator-pm-r-serial-q37-20261030-retry'.timer -p LoadState --value)" = not-found
test "$(systemctl show 'predator-pm-r-serial-q37-20261030-probe'.timer -p LoadState --value)" = not-found
test "$(systemctl show 'predator-pm-r-serial-q37-20261030-snapshot'.timer -p LoadState --value)" = not-found
systemd-run --unit='predator-pm-r-serial-q37-20261030-wake' --on-calendar=@1793379618 --timer-property=AccuracySec=1s --timer-property=RandomizedDelaySec=0 --timer-property=Persistent=no --property=Type=oneshot /usr/bin/python3 /home/mirsella/wol_predator.py
test "$(systemctl show 'predator-pm-r-serial-q37-20261030-wake'.timer -p SubState --value)" = waiting
systemctl cat 'predator-pm-r-serial-q37-20261030-wake'.timer 'predator-pm-r-serial-q37-20261030-wake'.service
systemd-run --unit='predator-pm-r-serial-q37-20261030-retry' --on-calendar=@1793379648 --timer-property=AccuracySec=1s --timer-property=RandomizedDelaySec=0 --timer-property=Persistent=no --property=Type=oneshot /usr/bin/python3 /home/mirsella/wol_predator.py
test "$(systemctl show 'predator-pm-r-serial-q37-20261030-retry'.timer -p SubState --value)" = waiting
systemctl cat 'predator-pm-r-serial-q37-20261030-retry'.timer 'predator-pm-r-serial-q37-20261030-retry'.service
systemd-run --unit='predator-pm-r-serial-q37-20261030-probe' --on-calendar=@1793379708 --timer-property=AccuracySec=1s --timer-property=RandomizedDelaySec=0 --timer-property=Persistent=no --property=Type=oneshot --property=TimeoutStartSec=20s /usr/bin/timeout 15s /usr/bin/ssh-keyscan -T 5 -t ed25519 192.168.1.19
test "$(systemctl show 'predator-pm-r-serial-q37-20261030-probe'.timer -p SubState --value)" = waiting
systemctl cat 'predator-pm-r-serial-q37-20261030-probe'.timer 'predator-pm-r-serial-q37-20261030-probe'.service
systemd-run --unit='predator-pm-r-serial-q37-20261030-snapshot' --on-calendar=@1793379798 --timer-property=AccuracySec=1s --timer-property=RandomizedDelaySec=0 --timer-property=Persistent=no --property=Type=oneshot /usr/bin/cp --no-clobber '/home/mirsella/dev/predator-pm-debug/netconsole-20261006.log' '/home/mirsella/dev/predator-pm-debug/.agents-local/r-serial-q37-20261030-result.log'
test "$(systemctl show 'predator-pm-r-serial-q37-20261030-snapshot'.timer -p SubState --value)" = waiting
systemctl cat 'predator-pm-r-serial-q37-20261030-snapshot'.timer 'predator-pm-r-serial-q37-20261030-snapshot'.service

stderr:
Running timer as unit: predator-pm-r-serial-q37-20261030-wake.timer
Will run service as unit: predator-pm-r-serial-q37-20261030-wake.service
Running timer as unit: predator-pm-r-serial-q37-20261030-retry.timer
Will run service as unit: predator-pm-r-serial-q37-20261030-retry.service
Running timer as unit: predator-pm-r-serial-q37-20261030-probe.timer
Will run service as unit: predator-pm-r-serial-q37-20261030-probe.service
Running timer as unit: predator-pm-r-serial-q37-20261030-snapshot.timer
Will run service as unit: predator-pm-r-serial-q37-20261030-snapshot.service
