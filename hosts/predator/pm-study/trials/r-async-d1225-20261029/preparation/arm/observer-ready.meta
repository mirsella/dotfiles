host=192.168.1.166
status=exit status: 0
script:
set -eu
test "$(timedatectl show -p NTPSynchronized --value)" = yes
systemctl is-active predator-netconsole-20261006.service
test "$(sha256sum /home/mirsella/wol_predator.py | cut -d' ' -f1)" = ca4666560dc9cd468f3b9b6c4c68a7dcb2675b561844ca5ef6a89fa9944722e8
grep -F 'nonce=1793217703' '/home/mirsella/dev/predator-pm-debug/netconsole-20261006.log'
cat /proc/sys/kernel/random/boot_id
date --iso-8601=seconds

