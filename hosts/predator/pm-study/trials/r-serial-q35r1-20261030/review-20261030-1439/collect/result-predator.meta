host=192.168.1.19
status=exit status: 0
script:
set -eu
date --iso-8601=seconds
cat /proc/sys/kernel/random/boot_id /proc/uptime
readlink -f /run/booted-system /run/current-system
for file in /var/lib/predator-pm-study/r-serial-q35r1-20261030-*.txt; do if test -f "$file"; then printf '\nARTIFACT=%s\n' "$file"; cat "$file"; fi; done
journalctl --boot='3c1873e4b86641e1b411702168ef90cf' -u 'predator-pm-r-serial-q35r1-20261030'.service -u systemd-suspend.service --no-pager -o short-iso-precise
journalctl --boot='3c1873e4b86641e1b411702168ef90cf' -k --no-pager -o short-monotonic
timedatectl status
timedatectl timesync-status
zpool status
findmnt -rn -t zfs -o SOURCE,TARGET
cat /sys/power/pm_async /sys/power/suspend_stats/success /sys/power/suspend_stats/fail

stderr:
