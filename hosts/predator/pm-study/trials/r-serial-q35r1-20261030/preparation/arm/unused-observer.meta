host=192.168.1.166
status=exit status: 0
script:
set -eu
test "$(systemctl show 'predator-pm-r-serial-q35r1-20261030-wake'.timer -p LoadState --value)" = not-found
test "$(systemctl show 'predator-pm-r-serial-q35r1-20261030-retry'.timer -p LoadState --value)" = not-found
test "$(systemctl show 'predator-pm-r-serial-q35r1-20261030-probe'.timer -p LoadState --value)" = not-found
test "$(systemctl show 'predator-pm-r-serial-q35r1-20261030-snapshot'.timer -p LoadState --value)" = not-found

stderr:
