host=192.168.1.19
status=exit status: 0
script:
set -eu
test "$(date +%s)" -lt 1793359774
test "$(systemctl show 'predator-pm-r-serial-q30-20261030'.service -p ActiveState --value)" = inactive
if test "$(systemctl show 'predator-pm-r-serial-q30-20261030'.timer -p LoadState --value)" != not-found; then systemctl stop 'predator-pm-r-serial-q30-20261030'.timer; fi
test "$(systemctl show 'predator-pm-r-serial-q30-20261030'.timer -p ActiveState --value)" = inactive
systemctl show 'predator-pm-r-serial-q30-20261030'.timer -p ActiveState -p SubState

stderr:
