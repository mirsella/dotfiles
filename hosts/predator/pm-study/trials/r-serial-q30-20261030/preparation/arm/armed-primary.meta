host=192.168.1.19
status=exit status: 1
script:
set -eu
test "$(date +%s)" -lt 1793359744
'/nix/store/l423y5sbmkgcl50cjfkxwhqg1im7b31q-predator-pm-study-0.1.0/bin/predator-pm-study' check-trial '/var/lib/predator-pm-study/r-serial-q30-20261030-plan.conf' '97ba58c433bf52024f86a342647ee5fba1ba667d5546ee96d9bba19ebd4524cf'
systemd-run --unit='predator-pm-r-serial-q30-20261030' --on-calendar=@1793359804 --timer-property=AccuracySec=1s --timer-property=RandomizedDelaySec=0 --timer-property=Persistent=no --property=Type=oneshot --property=TimeoutStartSec=25min --property=Environment=PATH=/run/current-system/sw/bin '--property=ExecStopPost=/nix/store/l423y5sbmkgcl50cjfkxwhqg1im7b31q-predator-pm-study-0.1.0/bin/predator-pm-study restore-trial /var/lib/predator-pm-study/r-serial-q30-20261030-plan.conf 97ba58c433bf52024f86a342647ee5fba1ba667d5546ee96d9bba19ebd4524cf' '/nix/store/l423y5sbmkgcl50cjfkxwhqg1im7b31q-predator-pm-study-0.1.0/bin/predator-pm-study' attempt-trial '/var/lib/predator-pm-study/r-serial-q30-20261030-plan.conf' '97ba58c433bf52024f86a342647ee5fba1ba667d5546ee96d9bba19ebd4524cf'
test "$(systemctl show 'predator-pm-r-serial-q30-20261030'.timer -p SubState --value)" = waiting
systemctl cat 'predator-pm-r-serial-q30-20261030'.timer 'predator-pm-r-serial-q30-20261030'.service

stderr:
