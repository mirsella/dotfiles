host=192.168.1.166
status=exit status: 0
script:
set -eu
test "$(systemctl show 'predator-pm-r-serial-q30-20261030-rehearsal'.timer -p LoadState --value)" = not-found
systemd-run --unit='predator-pm-r-serial-q30-20261030-rehearsal' --on-calendar=@1793358960 --timer-property=AccuracySec=1s --timer-property=RandomizedDelaySec=0 --timer-property=Persistent=no --property=Type=oneshot /usr/bin/true
test "$(systemctl show 'predator-pm-r-serial-q30-20261030-rehearsal'.timer -p SubState --value)" = waiting
systemctl cat 'predator-pm-r-serial-q30-20261030-rehearsal'.timer 'predator-pm-r-serial-q30-20261030-rehearsal'.service
systemctl stop 'predator-pm-r-serial-q30-20261030-rehearsal'.timer
test "$(systemctl show 'predator-pm-r-serial-q30-20261030-rehearsal'.timer -p ActiveState --value)" = inactive
systemctl show 'predator-pm-r-serial-q30-20261030-rehearsal'.timer -p ActiveState -p SubState

stderr:
Running timer as unit: predator-pm-r-serial-q30-20261030-rehearsal.timer
Will run service as unit: predator-pm-r-serial-q30-20261030-rehearsal.service
