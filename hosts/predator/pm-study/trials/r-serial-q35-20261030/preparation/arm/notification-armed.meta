host=192.168.1.166
status=exit status: 0
script:
set -euC
umask 077
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-notice-setup.service' <<'PM_NOTICE_EOF'
[Unit]
Description=Predator study Telegram notice
[Service]
Type=oneshot
TimeoutStartSec=25s
UMask=0077
ExecStart=/usr/bin/curl --silent --show-error --fail --connect-timeout 5 --max-time 20 --config "/run/predator-pm-r-serial-q35-20261030-telegram.conf" --data-urlencode "text=Predator / r-serial-q35-20261030 / Pi observer\nNotifications enabled. Test window: 2026-10-30 12:35:04 CET; first wake 12:51:04 CET, retry +30s. Keep the power graph. Schedule notices do not prove sleep entry."
PM_NOTICE_EOF
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-notice-start.service' <<'PM_NOTICE_EOF'
[Unit]
Description=Predator study Telegram notice
[Service]
Type=oneshot
TimeoutStartSec=25s
UMask=0077
ExecStart=/usr/bin/curl --silent --show-error --fail --connect-timeout 5 --max-time 20 --config "/run/predator-pm-r-serial-q35-20261030-telegram.conf" --data-urlencode "text=Predator / r-serial-q35-20261030 / Pi observer\nTest window is starting now. First wake: 12:51:04 CET. Suspend entry is not yet confirmed; preflight or inhibitors can refuse it. Watch the power graph."
PM_NOTICE_EOF
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-notice-wake-ok.service' <<'PM_NOTICE_EOF'
[Unit]
Description=Predator study Telegram notice
[Service]
Type=oneshot
TimeoutStartSec=25s
UMask=0077
ExecStart=/usr/bin/curl --silent --show-error --fail --connect-timeout 5 --max-time 20 --config "/run/predator-pm-r-serial-q35-20261030-telegram.conf" --data-urlencode "text=Predator / r-serial-q35-20261030 / Pi observer\nFirst WoL command completed successfully. Packet receipt and resume are not yet confirmed."
PM_NOTICE_EOF
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-notice-wake-failed.service' <<'PM_NOTICE_EOF'
[Unit]
Description=Predator study Telegram notice
[Service]
Type=oneshot
TimeoutStartSec=25s
UMask=0077
ExecStart=/usr/bin/curl --silent --show-error --fail --connect-timeout 5 --max-time 20 --config "/run/predator-pm-r-serial-q35-20261030-telegram.conf" --data-urlencode "text=Predator / r-serial-q35-20261030 / Pi observer\nFirst WoL command FAILED. The independent retry is still scheduled."
PM_NOTICE_EOF
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-notice-retry-ok.service' <<'PM_NOTICE_EOF'
[Unit]
Description=Predator study Telegram notice
[Service]
Type=oneshot
TimeoutStartSec=25s
UMask=0077
ExecStart=/usr/bin/curl --silent --show-error --fail --connect-timeout 5 --max-time 20 --config "/run/predator-pm-r-serial-q35-20261030-telegram.conf" --data-urlencode "text=Predator / r-serial-q35-20261030 / Pi observer\nRetry WoL command completed successfully. Reachability check follows."
PM_NOTICE_EOF
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-notice-retry-failed.service' <<'PM_NOTICE_EOF'
[Unit]
Description=Predator study Telegram notice
[Service]
Type=oneshot
TimeoutStartSec=25s
UMask=0077
ExecStart=/usr/bin/curl --silent --show-error --fail --connect-timeout 5 --max-time 20 --config "/run/predator-pm-r-serial-q35-20261030-telegram.conf" --data-urlencode "text=Predator / r-serial-q35-20261030 / Pi observer\nRetry WoL command FAILED. Keep the power graph and inspect the observer logs."
PM_NOTICE_EOF
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-notice-probe-ok.service' <<'PM_NOTICE_EOF'
[Unit]
Description=Predator study Telegram notice
[Service]
Type=oneshot
TimeoutStartSec=25s
UMask=0077
ExecStart=/usr/bin/curl --silent --show-error --fail --connect-timeout 5 --max-time 20 --config "/run/predator-pm-r-serial-q35-20261030-telegram.conf" --data-urlencode "text=Predator / r-serial-q35-20261030 / Pi observer\nSSH responded to the Pi probe. This is reachability only, not a suspend PASS. Kernel logs, timing and power graph still need review."
PM_NOTICE_EOF
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-notice-probe-failed.service' <<'PM_NOTICE_EOF'
[Unit]
Description=Predator study Telegram notice
[Service]
Type=oneshot
TimeoutStartSec=25s
UMask=0077
ExecStart=/usr/bin/curl --silent --show-error --fail --connect-timeout 5 --max-time 20 --config "/run/predator-pm-r-serial-q35-20261030-telegram.conf" --data-urlencode "text=Predator / r-serial-q35-20261030 / Pi observer\nSSH probe FAILED: Predator is unreachable. Possible hang; check power/LEDs. Preserve the graph and allow the snapshot at wake +3 minutes before attended recovery when practical."
PM_NOTICE_EOF
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-notice-snapshot-ok.service' <<'PM_NOTICE_EOF'
[Unit]
Description=Predator study Telegram notice
[Service]
Type=oneshot
TimeoutStartSec=25s
UMask=0077
ExecStart=/usr/bin/curl --silent --show-error --fail --connect-timeout 5 --max-time 20 --config "/run/predator-pm-r-serial-q35-20261030-telegram.conf" --data-urlencode "text=Predator / r-serial-q35-20261030 / Pi observer\nFull netconsole snapshot saved on Pi. Main-side collection follows. Preserve the power graph; final classification is pending."
PM_NOTICE_EOF
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-notice-snapshot-failed.service' <<'PM_NOTICE_EOF'
[Unit]
Description=Predator study Telegram notice
[Service]
Type=oneshot
TimeoutStartSec=25s
UMask=0077
ExecStart=/usr/bin/curl --silent --show-error --fail --connect-timeout 5 --max-time 20 --config "/run/predator-pm-r-serial-q35-20261030-telegram.conf" --data-urlencode "text=Predator / r-serial-q35-20261030 / Pi observer\nPi netconsole snapshot FAILED. Preserve the original append log and power graph; manual collection is needed."
PM_NOTICE_EOF
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-notice-canceled.service' <<'PM_NOTICE_EOF'
[Unit]
Description=Predator study Telegram notice
[Service]
Type=oneshot
TimeoutStartSec=25s
UMask=0077
ExecStart=/usr/bin/curl --silent --show-error --fail --connect-timeout 5 --max-time 20 --config "/run/predator-pm-r-serial-q35-20261030-telegram.conf" --data-urlencode "text=Predator / r-serial-q35-20261030 / Pi observer\nTest canceled before entry. Primary and wake timers were stopped."
PM_NOTICE_EOF
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-notice-start.timer' <<'PM_NOTICE_EOF'
[Unit]
Description=Predator study start-window notice
[Timer]
OnCalendar=@1793360104
AccuracySec=1s
RandomizedDelaySec=0
Persistent=no
PM_NOTICE_EOF
mkdir -p '/run/systemd/system/predator-pm-r-serial-q35-20261030-wake.service.d'
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-wake.service.d/60-telegram.conf' <<'PM_NOTICE_EOF'
[Unit]
OnSuccess=predator-pm-r-serial-q35-20261030-notice-wake-ok.service
OnFailure=predator-pm-r-serial-q35-20261030-notice-wake-failed.service
PM_NOTICE_EOF
mkdir -p '/run/systemd/system/predator-pm-r-serial-q35-20261030-retry.service.d'
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-retry.service.d/60-telegram.conf' <<'PM_NOTICE_EOF'
[Unit]
OnSuccess=predator-pm-r-serial-q35-20261030-notice-retry-ok.service
OnFailure=predator-pm-r-serial-q35-20261030-notice-retry-failed.service
PM_NOTICE_EOF
mkdir -p '/run/systemd/system/predator-pm-r-serial-q35-20261030-probe.service.d'
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-probe.service.d/60-telegram.conf' <<'PM_NOTICE_EOF'
[Unit]
OnSuccess=predator-pm-r-serial-q35-20261030-notice-probe-ok.service
OnFailure=predator-pm-r-serial-q35-20261030-notice-probe-failed.service
PM_NOTICE_EOF
mkdir -p '/run/systemd/system/predator-pm-r-serial-q35-20261030-snapshot.service.d'
cat > '/run/systemd/system/predator-pm-r-serial-q35-20261030-snapshot.service.d/60-telegram.conf' <<'PM_NOTICE_EOF'
[Unit]
OnSuccess=predator-pm-r-serial-q35-20261030-notice-snapshot-ok.service
OnFailure=predator-pm-r-serial-q35-20261030-notice-snapshot-failed.service
PM_NOTICE_EOF
systemctl daemon-reload
systemctl start 'predator-pm-r-serial-q35-20261030-notice-start'.timer
test "$(systemctl show 'predator-pm-r-serial-q35-20261030-notice-start'.timer -p SubState --value)" = waiting
systemctl start 'predator-pm-r-serial-q35-20261030-notice-setup'.service
journalctl -u 'predator-pm-r-serial-q35-20261030-notice-setup'.service --no-pager -o cat
test "$(systemctl show 'predator-pm-r-serial-q35-20261030'-wake.timer -p SubState --value)" = waiting
systemctl show 'predator-pm-r-serial-q35-20261030'-wake.service -p ExecStart -p OnSuccess -p OnFailure
test "$(systemctl show 'predator-pm-r-serial-q35-20261030'-retry.timer -p SubState --value)" = waiting
systemctl show 'predator-pm-r-serial-q35-20261030'-retry.service -p ExecStart -p OnSuccess -p OnFailure
test "$(systemctl show 'predator-pm-r-serial-q35-20261030'-probe.timer -p SubState --value)" = waiting
systemctl show 'predator-pm-r-serial-q35-20261030'-probe.service -p ExecStart -p OnSuccess -p OnFailure
test "$(systemctl show 'predator-pm-r-serial-q35-20261030'-snapshot.timer -p SubState --value)" = waiting
systemctl show 'predator-pm-r-serial-q35-20261030'-snapshot.service -p ExecStart -p OnSuccess -p OnFailure
systemctl cat 'predator-pm-r-serial-q35-20261030-notice-start'.timer
stat -c '%a %U %n' '/run/predator-pm-r-serial-q35-20261030-telegram.conf'

stderr:
