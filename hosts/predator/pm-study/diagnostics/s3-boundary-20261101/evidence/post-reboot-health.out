# /etc/systemd/system/systemd-timesyncd.service -> /nix/store/6qqq5prql4952z0wfm5ymjfr7cx4ab7z-systemd-262/example/systemd/system/systemd-timesyncd.service
#  SPDX-License-Identifier: LGPL-2.1-or-later
#
