#!/bin/sh
# Scope chezmoi's git status and commit to the source directory when it is a
# subdirectory of the repository, so unrelated working-tree changes cannot
# trigger an empty auto-commit or be included in one.
prefix=$(git rev-parse --show-prefix 2>/dev/null) || exec git "$@"
[ -n "$prefix" ] || exec git "$@"
case "$1" in
	commit)
		shift
		exec git commit --only "$@" -- .
		;;
	status)
		exec git status "$@" -- .
		;;
	*)
		exec git "$@"
		;;
esac
