diff --git a/crates/kache-store/src/retention_shadow.rs b/crates/kache-store/src/retention_shadow.rs
new file mode 100644
index 00000000..83a274af
--- /dev/null
+++ b/crates/kache-store/src/retention_shadow.rs
@@ -0,0 +1,283 @@
+//! A bounded, matched-byte comparison, not an eviction policy. Start from
+//! the real victims and replace only independently reclaimable entries.
+use crate::{eviction::EntryFeatures, store::GcStats};
+use serde::Serialize;
+use std::collections::BTreeMap;
+use std::fs;
+use std::path::Path;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+const MAX_PAIRS: usize = 64;
+const MAX_SWEEPS: usize = 256;
+const MIN_COST_MS: i64 = 10_000;
+const MIN_BYTES: i64 = 1 << 20;
+const RECORD_DIR: &str = "telemetry/retention-shadow-v1";
+
+fn now_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis() as u64
+}
+
+fn independent_bytes(entry: &EntryFeatures) -> Option<u64> {
+    // Logical size counts every file reference. Equality excludes both shared
+    // blobs and entries that reference the same blob more than once.
+    (entry.committed && entry.size >= MIN_BYTES && entry.reclaimable_bytes == Some(entry.size))
+        .then_some(entry.size as u64)
+}
+
+#[derive(Serialize)]
+struct Victim<'a> {
+    key: &'a str,
+    indexed_bytes: u64,
+    compile_ms: i64,
+    hit_count: i64,
+    idle_hours: f64,
+}
+
+impl<'a> Victim<'a> {
+    fn new(entry: &'a EntryFeatures, indexed_bytes: u64) -> Self {
+        Self {
+            key: &entry.key,
+            indexed_bytes,
+            compile_ms: entry.compile_time_ms,
+            hit_count: entry.hit_count,
+            idle_hours: entry.idle_hours,
+        }
+    }
+}
+
+#[derive(Serialize)]
+struct Pair<'a> {
+    live: Victim<'a>,
+    shadow: Victim<'a>,
+}
+
+pub(crate) struct Trial<'a> {
+    sweep_started_ms: u64,
+    target_indexed_bytes: u64,
+    victims: Vec<(&'a EntryFeatures, u64)>,
+}
+
+#[derive(Serialize)]
+struct SweepRecord<'a> {
+    schema: u8,
+    sweep_started_ms: u64,
+    target_indexed_bytes: u64,
+    finished_ms: u64,
+    live_indexed_bytes: u64,
+    live_disk_bytes_estimate: u64,
+    live_victims: usize,
+    eligible_live: usize,
+    eligible_alternatives: usize,
+    pairs: Vec<Pair<'a>>,
+}
+
+impl<'a> Trial<'a> {
+    pub(crate) fn new(target_indexed_bytes: u64) -> Self {
+        Self {
+            sweep_started_ms: now_ms(),
+            target_indexed_bytes,
+            victims: Vec::new(),
+        }
+    }
+
+    pub(crate) fn observe(&mut self, entry: &'a EntryFeatures, freed: u64) {
+        if independent_bytes(entry) == Some(freed)
+            && entry.key_schema == i64::from(kache_format::CACHE_KEY_VERSION)
+            && entry.hit_count >= 3
+            && (0.0..=12.0).contains(&entry.idle_hours)
+            && entry.compile_time_ms >= MIN_COST_MS
+        {
+            self.victims.push((entry, freed));
+        }
+    }
+
+    pub(crate) fn finish(
+        mut self,
+        cache: &Path,
+        stats: &GcStats,
+        alternatives: impl Iterator<Item = &'a EntryFeatures>,
+    ) -> anyhow::Result<()> {
+        let finished_ms = now_ms();
+        let dir = cache.join(RECORD_DIR);
+        fs::create_dir_all(&dir)?;
+        // GC callers hold the sweep lock. Check the cap before scanning alternatives.
+        let records = fs::read_dir(&dir)?
+            .take(MAX_SWEEPS)
+            .try_fold(0, |count, entry| entry.map(|_| count + 1))?;
+        if records == MAX_SWEEPS {
+            return Ok(());
+        }
+
+        // A sweep that missed its byte target records the shortfall but no pairs.
+        let (eligible_alternatives, pairs) =
+            if stats.bytes_freed >= self.target_indexed_bytes && !self.victims.is_empty() {
+                match_alternatives(&mut self.victims, alternatives)
+            } else {
+                (0, Vec::new())
+            };
+        let record = SweepRecord {
+            schema: 1,
+            sweep_started_ms: self.sweep_started_ms,
+            target_indexed_bytes: self.target_indexed_bytes,
+            finished_ms,
+            live_indexed_bytes: stats.bytes_freed,
+            live_disk_bytes_estimate: stats.disk_bytes_reclaimed,
+            live_victims: stats.entries_evicted,
+            eligible_live: self.victims.len(),
+            eligible_alternatives,
+            pairs,
+        };
+        let path = dir.join(format!(
+            "{}-{}.json",
+            self.sweep_started_ms,
+            std::process::id()
+        ));
+        crate::atomic::atomic_replace_deferrable(&path, &serde_json::to_vec(&record)?, false)
+    }
+}
+
+fn match_alternatives<'a>(
+    victims: &mut [(&'a EntryFeatures, u64)],
+    alternatives: impl Iterator<Item = &'a EntryFeatures>,
+) -> (usize, Vec<Pair<'a>>) {
+    let mut by_size: BTreeMap<u64, Vec<&EntryFeatures>> = BTreeMap::new();
+    let mut eligible_alternatives = 0;
+    for entry in alternatives {
+        if entry.hit_count == 0
+            && entry.idle_hours >= 2.0
+            && (1..MIN_COST_MS).contains(&entry.compile_time_ms)
+            && let Some(bytes) = independent_bytes(entry)
+        {
+            eligible_alternatives += 1;
+            by_size.entry(bytes).or_default().push(entry);
+        }
+    }
+    for entries in by_size.values_mut() {
+        // Alternatives arrive in live eviction order; pop the earliest on ties.
+        entries.reverse();
+    }
+    victims.sort_unstable_by(|(a, _), (b, _)| {
+        b.compile_time_ms
+            .cmp(&a.compile_time_ms)
+            .then(a.key.cmp(&b.key))
+    });
+    let mut pairs = Vec::new();
+    for &(entry, freed) in victims.iter() {
+        // Independent blobs cannot be counted in two pairs.
+        let Some((size, entries)) = by_size.range_mut(freed..=freed + freed / 20).next() else {
+            continue;
+        };
+        let (bytes, substitute) = (*size, entries.pop().expect("nonempty size bucket"));
+        if entries.is_empty() {
+            by_size.remove(&bytes);
+        }
+        pairs.push(Pair {
+            live: Victim::new(entry, freed),
+            shadow: Victim::new(substitute, bytes),
+        });
+        if pairs.len() == MAX_PAIRS {
+            break;
+        }
+    }
+    (eligible_alternatives, pairs)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn entry(key: &str, bytes: u64, hits: i64, cost: i64) -> EntryFeatures {
+        EntryFeatures {
+            key: key.into(),
+            size: bytes as i64,
+            key_schema: i64::from(kache_format::CACHE_KEY_VERSION),
+            hit_count: hits,
+            idle_hours: 3.0,
+            content_hash: None,
+            committed: true,
+            compile_time_ms: cost,
+            reclaimable_bytes: Some(bytes as i64),
+            recently_accessed: false,
+            recently_imported: false,
+        }
+    }
+
+    #[test]
+    fn pairs_one_removal_with_one_independent_same_budget_alternative() {
+        let expensive = entry("hot", 2 << 20, 5, 30_000);
+        let second = entry("second-hot", 2 << 20, 3, 20_000);
+        let too_small = entry("smaller", (2 << 20) - 1, 0, 10);
+        let too_large = entry("larger", 3 << 20, 0, 10);
+        let unknown = entry("unknown", 2 << 20, 0, 0);
+        let mut shared = entry("shared", 2 << 20, 0, 10);
+        shared.reclaimable_bytes = Some(0);
+        let cold = entry("cold", (2 << 20) + 1024, 0, 10);
+        let (eligible, pairs) = match_alternatives(
+            &mut [(&second, 2 << 20), (&expensive, 2 << 20)],
+            [&too_small, &too_large, &unknown, &shared, &cold].into_iter(),
+        );
+        assert_eq!(eligible, 3);
+        assert_eq!(pairs.len(), 1);
+        assert_eq!(pairs[0].live.key, "hot");
+        assert_eq!(pairs[0].shadow.key, "cold");
+        assert_eq!(
+            pairs[0].shadow.indexed_bytes - pairs[0].live.indexed_bytes,
+            1024
+        );
+    }
+
+    #[test]
+    fn incomplete_sweep_keeps_evidence_but_does_not_claim_a_match() {
+        let hot = entry("hot", 2 << 20, 3, 10_000);
+        let cold = entry("cold", 2 << 20, 0, 100);
+        let mut trial = Trial::new(3 << 20);
+        trial.observe(&hot, 2 << 20);
+        let cache = tempfile::tempdir().unwrap();
+        trial
+            .finish(
+                cache.path(),
+                &GcStats {
+                    bytes_freed: 2 << 20,
+                    ..Default::default()
+                },
+                [&cold].into_iter(),
+            )
+            .unwrap();
+        let path = fs::read_dir(cache.path().join(RECORD_DIR))
+            .unwrap()
+            .next()
+            .unwrap()
+            .unwrap()
+            .path();
+        let record: serde_json::Value = serde_json::from_slice(&fs::read(path).unwrap()).unwrap();
+        assert_eq!(record["eligible_live"], 1);
+        assert_eq!(record["pairs"], serde_json::json!([]));
+    }
+
+    #[test]
+    fn full_record_directory_skips_matching_and_writes() {
+        let cache = tempfile::tempdir().unwrap();
+        let dir = cache.path().join(RECORD_DIR);
+        fs::create_dir_all(&dir).unwrap();
+        for index in 0..256 {
+            fs::write(dir.join(format!("{index}.json")), b"{}").unwrap();
+        }
+        let hot = entry("hot", 2 << 20, 3, 10_000);
+        let mut trial = Trial::new(2 << 20);
+        trial.observe(&hot, 2 << 20);
+        trial
+            .finish(
+                cache.path(),
+                &GcStats {
+                    bytes_freed: 2 << 20,
+                    ..Default::default()
+                },
+                std::iter::from_fn(|| panic!("a full recorder must not scan alternatives")),
+            )
+            .unwrap();
+        assert_eq!(fs::read_dir(dir).unwrap().count(), 256);
+    }
+}
