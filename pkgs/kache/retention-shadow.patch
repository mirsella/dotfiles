+#[test]
+fn retention_shadow_observes_without_changing_the_live_victim() {
+    let dir = tempfile::tempdir().unwrap();
+    let config = test_config(dir.path());
+    let store = Store::open(&config).unwrap();
+    let bytes = 2 << 20;
+    for (key, data) in [("hot", b'h'), ("held", b'b'), ("cold", b'c')] {
+        let path = dir.path().join(format!("{key}.rlib"));
+        fs::write(&path, vec![data; bytes]).unwrap();
+        store
+            .put(
+                key,
+                "c",
+                &["lib".into()],
+                &[],
+                "",
+                "dev",
+                &[(path.clone(), "lib.rlib".into())],
+                "",
+                "",
+            )
+            .unwrap();
+        fs::remove_file(path).unwrap();
+    }
+    store
+        .db
+        .execute(
+            "UPDATE entries SET last_accessed = datetime('now', '-3 hours'),
+             hit_count = CASE WHEN cache_key = 'hot' THEN 3 ELSE 0 END,
+             compile_time_ms = CASE WHEN cache_key = 'hot' THEN 15000 ELSE 100 END",
+            [],
+        )
+        .unwrap();
+    let candidates = store.eviction_candidates().unwrap();
+    let by_key = candidates
+        .iter()
+        .map(|entry| (entry.key.as_str(), entry))
+        .collect();
+    let stats = store.apply_eviction(
+        &["hot".into(), "held".into(), "cold".into()],
+        &by_key,
+        "size-pressure",
+        Some((3 * bytes as u64, 2 * bytes as u64)),
+        None,
+        &Default::default(),
+        &[("held".into(), bytes as u64)].into_iter().collect(),
+        true,
+        &mut || false,
+    );
+    assert_eq!(stats.entries_evicted, 1);
+    let keys: std::collections::BTreeSet<_> = store
+        .eviction_candidates()
+        .unwrap()
+        .into_iter()
+        .map(|entry| entry.key)
+        .collect();
+    assert_eq!(
+        keys,
+        ["cold".to_owned(), "held".to_owned()].into_iter().collect()
+    );
+    let evidence = fs::read_dir(config.cache_dir.join("telemetry/retention-shadow-v1"))
+        .unwrap()
+        .next()
+        .unwrap()
+        .unwrap()
+        .path();
+    let record: serde_json::Value = serde_json::from_slice(&fs::read(evidence).unwrap()).unwrap();
+    assert_eq!(record["pairs"][0]["live"]["key"], "hot");
+    assert_eq!(record["pairs"][0]["shadow"]["key"], "cold");
+}
