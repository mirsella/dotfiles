+/// Git can delete a loose ref to expose an older packed ref. Check its
+/// containing directory's own timestamp as well as the remaining files;
+/// never recursively walk the whole Git object database for this check.
+pub(super) fn declared_inputs_changed(
+    path: &Path,
+    default_package: bool,
+    excluded: &[PathBuf],
+    started: std::time::SystemTime,
+) -> Result<bool> {
+    let git = if default_package {
+        None
+    } else {
+        super::git::resolve(path)?
+    };
+    let Some(git) = git else {
+        return super::modified_since(path, excluded, started);
+    };
+    for file in git.read.iter().chain(std::iter::once(&git.path)) {
+        if super::modified_since(file, excluded, started)? {
+            return Ok(true);
+        }
+        let mut parent = file.parent();
+        while let Some(directory) = parent {
+            match std::fs::metadata(directory) {
+                Ok(metadata) => {
+                    if metadata.modified()? >= started {
+                        return Ok(true);
+                    }
+                    break;
+                }
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                    parent = directory.parent();
+                }
+                Err(error) => return Err(error.into()),
+            }
+        }
+    }
+    Ok(false)
+}
