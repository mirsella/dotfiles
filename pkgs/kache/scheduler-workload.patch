diff --git a/src/compile/usage.rs b/src/compile/usage.rs
new file mode 100644
index 00000000..f8e9aeaa
--- /dev/null
+++ b/src/compile/usage.rs
@@ -0,0 +1,147 @@
+//! Reap only the compiler we spawned. RUSAGE_CHILDREN is a process-wide
+//! high-water mark and can retain an earlier probe's much larger footprint.
+
+use std::io::{self, Read};
+use std::process::{Child, Command, ExitStatus, Output, Stdio};
+
+pub(super) fn wait(child: &mut Child) -> io::Result<(ExitStatus, Option<u64>)> {
+    #[cfg(unix)]
+    {
+        use std::os::unix::process::ExitStatusExt;
+        let mut status = 0;
+        let mut usage: libc::rusage = unsafe { std::mem::zeroed() };
+        loop {
+            // The caller owns this child exclusively and never waits for it
+            // elsewhere. Child::drop does not reap it a second time.
+            let result =
+                unsafe { libc::wait4(child.id() as libc::pid_t, &mut status, 0, &mut usage) };
+            if result >= 0 {
+                let rss = u64::try_from(usage.ru_maxrss).ok().filter(|rss| *rss > 0);
+                #[cfg(not(target_os = "macos"))]
+                let rss = rss.map(|rss| rss.saturating_mul(1024));
+                return Ok((ExitStatus::from_raw(status), rss));
+            }
+            let error = io::Error::last_os_error();
+            if error.kind() != io::ErrorKind::Interrupted {
+                return Err(error);
+            }
+        }
+    }
+    #[cfg(not(unix))]
+    child.wait().map(|status| (status, None))
+}
+
+pub(crate) fn output(command: &mut Command) -> io::Result<(Output, Option<u64>)> {
+    let mut child = command
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()?;
+    let mut stdout = child.stdout.take().expect("piped compiler stdout");
+    let mut stderr = child.stderr.take().expect("piped compiler stderr");
+    let child = std::sync::Mutex::new(&mut child);
+    std::thread::scope(|scope| {
+        let reader = |pipe: &mut (dyn Read + Send)| {
+            let mut bytes = Vec::new();
+            let result = pipe.read_to_end(&mut bytes).map(|_| bytes);
+            if result.is_err() {
+                let _ = child.lock().unwrap().kill();
+            }
+            result
+        };
+        let stdout = scope.spawn(move || reader(&mut stdout));
+        let stderr = reader(&mut stderr);
+        let stdout = stdout.join();
+        let (status, rss) = wait(&mut child.lock().unwrap())?;
+        let stdout = stdout.map_err(|_| io::Error::other("compiler stdout reader panicked"))??;
+        Ok((
+            Output {
+                status,
+                stdout,
+                stderr: stderr?,
+            },
+            rss,
+        ))
+    })
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+
+    #[test]
+    #[ignore = "subprocess fixture for compiler_child_sample_does_not_inherit_earlier_peak"]
+    fn memory_child() {
+        let bytes: usize = std::env::var("KACHE_RSS_FIXTURE_BYTES")
+            .unwrap()
+            .parse()
+            .unwrap();
+        let data = vec![0x5au8; bytes];
+        std::hint::black_box(data);
+    }
+
+    #[test]
+    fn compiler_child_sample_does_not_inherit_earlier_peak() {
+        // The suite itself can retain hundreds of MiB before fork. Measure
+        // in a fresh process so inherited pre-exec pages don't mask the
+        // intentional difference between the two compiler-sized children.
+        let (out, _) = output(Command::new(std::env::current_exe().unwrap()).args([
+            "--exact",
+            "compile::usage::tests::sample_pair_child",
+            "--ignored",
+        ]))
+        .unwrap();
+        assert!(
+            out.status.success(),
+            "{}{}",
+            String::from_utf8_lossy(&out.stdout),
+            String::from_utf8_lossy(&out.stderr)
+        );
+    }
+
+    #[test]
+    #[ignore = "subprocess fixture for compiler_child_sample_does_not_inherit_earlier_peak"]
+    fn sample_pair_child() {
+        let measure = |bytes: usize| {
+            let (out, rss) = output(
+                Command::new(std::env::current_exe().unwrap())
+                    .args([
+                        "--exact",
+                        "compile::usage::tests::memory_child",
+                        "--ignored",
+                    ])
+                    .env("KACHE_RSS_FIXTURE_BYTES", bytes.to_string()),
+            )
+            .unwrap();
+            assert!(
+                out.status.success(),
+                "{}",
+                String::from_utf8_lossy(&out.stderr)
+            );
+            rss.expect("wait4 RSS")
+        };
+        let large = measure(64 * 1024 * 1024);
+        let small = measure(1024 * 1024);
+        assert!(
+            large > small + 32 * 1024 * 1024,
+            "large={large}, small={small}"
+        );
+    }
+
+    #[test]
+    fn output_preserves_pipes_and_nonzero_status() {
+        let (out, rss) =
+            output(Command::new("sh").args(["-c", "printf out; printf err >&2; exit 7"])).unwrap();
+        assert_eq!(out.stdout, b"out");
+        assert_eq!(out.stderr, b"err");
+        assert_eq!(out.status.code(), Some(7));
+        assert!(rss.is_some_and(|rss| rss > 1024));
+    }
+
+    #[test]
+    fn output_preserves_signal_status() {
+        let (out, _) = output(Command::new("sh").args(["-c", "kill -TERM $$"])).unwrap();
+        use std::os::unix::process::ExitStatusExt;
+        assert_eq!(out.status.signal(), Some(libc::SIGTERM));
+    }
+}
