index 00000000..09684e0d
--- /dev/null
+++ b/src/scheduler/workload.rs
@@ -0,0 +1,112 @@
+//! Memory estimates describe a compilation workload, not an artifact key.
+//! Keep them reusable across source edits, but never lend an iOS link's RSS
+//! to a host metadata check merely because the crate name is the same.
+
+use crate::args::RustcArgs;
+use crate::compiler::cc::CcArgs;
+
+fn digest(kind: &str, shape: impl std::fmt::Debug) -> String {
+    // A new namespace deliberately does not read legacy crate-name samples.
+    blake3::hash(format!("kache-rss-workload-v2:{kind}:{shape:?}").as_bytes())
+        .to_hex()
+        .to_string()
+}
+
+pub(crate) fn rustc(args: &RustcArgs, incremental: bool) -> String {
+    let mut types = args.crate_types.clone();
+    types.sort();
+    types.dedup();
+    let codegen: Vec<_> = args
+        .codegen_opts
+        .iter()
+        .filter(|(name, _)| !matches!(name.as_str(), "incremental" | "metadata" | "extra-filename"))
+        .collect();
+    digest(
+        "rustc",
+        (
+            (&args.rustc, &args.inner_rustc, &args.sysroot),
+            (&args.crate_name, &args.extra_filename, &args.target, types),
+            (args.emits_link(), args.is_test, incremental),
+            (
+                codegen,
+                &args.features,
+                &args.cfgs,
+                &args.unstable_flags,
+                &args.frontend_jobs,
+            ),
+        ),
+    )
+}
+
+pub(crate) fn cc(args: &CcArgs) -> String {
+    let mut target_flags = Vec::new();
+    let mut next_value = false;
+    for arg in &args.rest {
+        if next_value {
+            target_flags.push(arg);
+            next_value = false;
+        } else if matches!(
+            arg.as_str(),
+            "--target" | "-target" | "-arch" | "--sysroot" | "-isysroot"
+        ) {
+            target_flags.push(arg);
+            next_value = true;
+        } else if arg.starts_with("--target=")
+            || arg.starts_with("--sysroot=")
+            || arg.starts_with("-m")
+            || arg.starts_with("-flto")
+        {
+            target_flags.push(arg);
+        }
+    }
+    digest(
+        "cc",
+        (
+            (&args.program, &args.sources, &args.mode, target_flags),
+            (&args.optimization, args.debug_level, &args.std, args.pic),
+            (&args.defines, &args.language_override, &args.family),
+        ),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn args(extra: &[&str]) -> RustcArgs {
+        RustcArgs::parse(
+            &[
+                "rustc",
+                "--crate-name",
+                "game",
+                "--crate-type",
+                "rlib",
+                "src/lib.rs",
+            ]
+            .into_iter()
+            .chain(extra.iter().copied())
+            .map(str::to_string)
+            .collect::<Vec<_>>(),
+        )
+        .unwrap()
+    }
+
+    #[test]
+    fn rust_workloads_separate_target_profile_kind_and_incremental() {
+        let check = args(&["--emit=metadata"]);
+        let key = rustc(&check, false);
+        for changed in [
+            args(&["--emit=metadata", "--target=aarch64-apple-ios"]),
+            args(&["--emit=metadata", "-Copt-level=3"]),
+            args(&["--emit=link"]),
+            args(&["--emit=metadata", "-Cdebuginfo=2"]),
+        ] {
+            assert_ne!(key, rustc(&changed, false));
+        }
+        assert_ne!(key, rustc(&check, true));
+        let mut relocated = check.clone();
+        relocated.source_file = Some("other-checkout/src/lib.rs".into());
+        relocated.out_dir = Some("another-target/deps".into());
+        assert_eq!(key, rustc(&relocated, false));
+    }
+}
