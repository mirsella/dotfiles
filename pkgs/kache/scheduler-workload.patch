+    let scheduler = match Scheduler::open(cache_dir) {
+        Ok(scheduler) => scheduler,
+        Err(error) => {
+            Decision::new(Phase::Flight).record(Outcome::Unavailable, Duration::ZERO);
+            tracing::debug!(%error, "publication scheduler unusable; continuing with the store key lock");
+            return BeginMiss::Compile(MissGuard::empty());
+        }
+    };
+    scheduler.publication(identity)
