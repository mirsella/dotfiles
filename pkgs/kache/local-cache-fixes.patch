+    assert!(
+        report
+            .suggestions
+            .iter()
+            .any(|notice| notice.contains("counts include retained archives"))
+    );
+    assert!(
+        !report
+            .suggestions
+            .iter()
+            .any(|notice| notice.contains("counts above are incomplete"))
+    );
+    assert!(
+        rotation_cut_notice(config.event_log_max_size, true)
