+/// Remove expired segments, then the oldest ones until the archive fits its
+/// byte budget. A single oversized or expired segment is not an exception.
+fn prune_event_archive(
+    event_log_path: &Path,
+    now: DateTime<Utc>,
+    max_age_secs: i64,
+    max_bytes: u64,
