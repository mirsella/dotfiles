+fn segment_stats_onto(
+    mut stats: EventStats,
+    path: &Path,
+    since: Option<DateTime<Utc>>,
+) -> Result<EventStats> {
+    for event in read_segment(path)? {
+        let event = event?;
+        if since.is_none_or(|since| event.ts >= since) {
+            stats = compute_stats_onto(stats, std::slice::from_ref(&event));
