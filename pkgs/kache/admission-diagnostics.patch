@@ -7,6 +7,54 @@ static REFLINKED_BYTES: AtomicU64 = AtomicU64::new(0);
 static HARDLINKED_BYTES: AtomicU64 = AtomicU64::new(0);
 static COPIED_BYTES: AtomicU64 = AtomicU64::new(0);
 
+/// Existing absent/miss fallbacks, not additional retries. `contains_*` counts
+/// SQLite errors hidden by the committed-entry probe; a missing row is normal.
+/// `lookup_fallback_other` can also include non-database local lookup errors.
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+pub struct IndexReadEvidence {
+    #[serde(default)]
+    pub contains_busy: u64,
+    #[serde(default)]
+    pub contains_other: u64,
+    #[serde(default)]
+    pub lookup_fallback_busy: u64,
+    #[serde(default)]
+    pub lookup_fallback_other: u64,
+}
+
+static CONTAINS_BUSY: AtomicU64 = AtomicU64::new(0);
+static CONTAINS_OTHER: AtomicU64 = AtomicU64::new(0);
+static LOOKUP_FALLBACK_BUSY: AtomicU64 = AtomicU64::new(0);
+static LOOKUP_FALLBACK_OTHER: AtomicU64 = AtomicU64::new(0);
+
+pub fn record_contains_failure(busy: bool) {
+    (if busy {
+        &CONTAINS_BUSY
+    } else {
+        &CONTAINS_OTHER
+    })
+    .fetch_add(1, Ordering::Relaxed);
+}
+
+pub fn record_lookup_fallback(busy: bool) {
+    (if busy {
+        &LOOKUP_FALLBACK_BUSY
+    } else {
+        &LOOKUP_FALLBACK_OTHER
+    })
+    .fetch_add(1, Ordering::Relaxed);
+}
+
+pub fn index_read_evidence() -> Option<IndexReadEvidence> {
+    let evidence = IndexReadEvidence {
+        contains_busy: CONTAINS_BUSY.load(Ordering::Relaxed),
+        contains_other: CONTAINS_OTHER.load(Ordering::Relaxed),
+        lookup_fallback_busy: LOOKUP_FALLBACK_BUSY.load(Ordering::Relaxed),
+        lookup_fallback_other: LOOKUP_FALLBACK_OTHER.load(Ordering::Relaxed),
+    };
+    (evidence != IndexReadEvidence::default()).then_some(evidence)
+}
