+//! Bounded observations of the existing scheduler, not a scheduling policy.
+use serde::{Deserialize, Serialize};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Phase {
+    Flight,
+    Discovery,
+    Capacity,
+    #[serde(other)]
+    Unknown,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Outcome {
+    Admitted,
+    /// The peer's flight lock was released. This does not prove publication
+    /// or successful compilation; the caller still has to recheck the cache.
+    PeerCompleted,
+    TimeoutFallback,
+    Unavailable,
+    LeaseCovered,
+    #[serde(other)]
+    Unknown,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum PressureSource {
+    Cgroup,
+    Host,
+    Macos,
+    #[serde(other)]
+    Unknown,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum PressureState {
+    Disabled,
+    Sampled,
+    Unavailable,
+    Unsupported,
+    Forced,
+    #[serde(other)]
+    Unknown,
+}
+
+/// A reading's timestamp is its actual observation time, including on cache reuse.
+/// No cgroup path or process inventory is recorded.
+#[derive(Debug, Clone, Copy, PartialEq, Serialize, Deserialize)]
+pub struct Reading {
+    pub source: PressureSource,
+    pub at_unix_ms: u64,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub some_avg10: Option<f64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub full_avg10: Option<f64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub macos_level: Option<i32>,
+}
+
+/// Extrema retain their own timestamps and sources. They are not simultaneous
+/// observations and do not imply continuous pressure between samples.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct PressureSummary {
+    pub first: Reading,
+    pub last: Reading,
+    pub samples: u32,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub max_some: Option<Reading>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub max_full: Option<Reading>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub max_macos: Option<Reading>,
+}
+
+impl PressureSummary {
+    fn new(reading: Reading) -> Self {
+        Self {
+            first: reading,
+            last: reading,
+            samples: 1,
+            max_some: reading.some_avg10.map(|_| reading),
+            max_full: reading.full_avg10.map(|_| reading),
+            max_macos: reading.macos_level.map(|_| reading),
+        }
+    }
+
+    fn observe(&mut self, reading: Reading) {
+        if self.last == reading {
+            return;
+        }
+        self.last = reading;
+        self.samples = self.samples.saturating_add(1);
+        if reading.some_avg10.is_some_and(|value| {
+            self.max_some
+                .and_then(|r| r.some_avg10)
+                .is_none_or(|max| value > max)
+        }) {
+            self.max_some = Some(reading);
+        }
+        if reading.full_avg10.is_some_and(|value| {
+            self.max_full
+                .and_then(|r| r.full_avg10)
+                .is_none_or(|max| value > max)
+        }) {
+            self.max_full = Some(reading);
+        }
+        if reading.macos_level.is_some_and(|value| {
+            self.max_macos
+                .and_then(|r| r.macos_level)
+                .is_none_or(|max| value > max)
+        }) {
+            self.max_macos = Some(reading);
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct Decision {
+    pub phase: Phase,
+    pub outcome: Outcome,
+    pub started_unix_ms: u64,
+    pub elapsed_ms: u64,
+    /// Maximum requested count across scans, not necessarily the final ask.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub requested_slots: Option<u32>,
+    /// Minimum observed free count. Successful scans stop once enough locks
+    /// are held, so this is a lower bound, not a full-pool availability census.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub available_slots: Option<u32>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub pool_slots: Option<u32>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub weight_slots: Option<u32>,
+    /// Exact number retained by the successful scan, not the largest ask.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub admitted_slots: Option<u32>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub pressure_state: Option<PressureState>,
+    /// Scans without numeric evidence, including opt-out and test overrides.
+    #[serde(default)]
+    pub unobserved_pressure_scans: u32,
+    #[serde(default)]
+    pub scans: u32,
+    #[serde(default)]
+    pub pressured_scans: u32,
+    /// Only observations the existing compile_need path already requested.
+    /// The existing u32::MAX unreadable sentinel is recorded separately.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub tests_held_max: Option<u32>,
+    #[serde(default)]
+    pub tests_held_unavailable: bool,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub psi: Option<PressureSummary>,
+}
+
+impl Decision {
+    pub fn new(phase: Phase) -> Self {
+        Self {
+            phase,
+            outcome: Outcome::Unknown,
+            started_unix_ms: unix_ms(),
+            elapsed_ms: 0,
+            requested_slots: None,
+            available_slots: None,
+            pool_slots: None,
+            weight_slots: None,
+            admitted_slots: None,
+            pressure_state: None,
+            unobserved_pressure_scans: 0,
+            scans: 0,
+            pressured_scans: 0,
+            tests_held_max: None,
+            tests_held_unavailable: false,
+            psi: None,
+        }
+    }
+
+    pub fn pressure(&mut self, pressured: bool, reading: Option<Reading>, state: PressureState) {
+        self.scans = self.scans.saturating_add(1);
+        self.pressured_scans = self.pressured_scans.saturating_add(u32::from(pressured));
+        self.pressure_state = Some(state);
+        self.unobserved_pressure_scans = self
+            .unobserved_pressure_scans
+            .saturating_add(u32::from(reading.is_none()));
+        if let Some(reading) = reading {
+            match self.psi.as_mut() {
+                Some(summary) => summary.observe(reading),
+                None => self.psi = Some(PressureSummary::new(reading)),
+            }
+        }
+    }
+
+    pub fn scan(&mut self, need: u32, free: Option<u32>, outcome: Option<Outcome>) {
+        self.requested_slots = Some(self.requested_slots.unwrap_or(0).max(need));
+        if let Some(free) = free {
+            self.available_slots = Some(self.available_slots.map_or(free, |old| old.min(free)));
+        }
+        if let Some(outcome) = outcome {
+            self.outcome = outcome;
+            if outcome == Outcome::Admitted {
+                self.admitted_slots = free;
+            }
+        }
+    }
+
+    pub fn record(mut self, outcome: Outcome, elapsed: Duration) {
+        if outcome == Outcome::Unknown {
+            tracing::warn!(phase = ?self.phase, "scheduler decision completed without a supported outcome");
+            debug_assert_ne!(outcome, Outcome::Unknown);
+        }
+        self.outcome = outcome;
+        self.elapsed_ms = u64::try_from(elapsed.as_millis()).unwrap_or(u64::MAX);
+        crate::opcounts::record_scheduler_decision(self);
+    }
+}
+
+pub fn unix_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|duration| u64::try_from(duration.as_millis()).unwrap_or(u64::MAX))
+        .unwrap_or_else(|error| {
+            tracing::warn!(%error, "scheduler observation predates Unix epoch; timestamp unavailable (0)");
+            0
+        })
+}
+
+/// One process handles one compile. Retain at most 16 decisions even if a
+/// caller repeatedly rejoins a flight. Snapshotting never drains evidence:
+/// rebuilding an event after a declined daemon handoff must retain it.
+#[derive(Debug, Default, Clone, PartialEq)]
+pub struct Evidence {
+    /// Shared across reconstructed/secondary events in this wrapper. Consumers
+    /// deduplicate decisions by (invocation_id, index), not event count.
+    pub invocation_id: Option<String>,
+    pub decisions: Vec<Decision>,
+    pub dropped: u32,
+}
+
+impl Evidence {
+    pub fn record(&mut self, decision: Decision) {
+        self.invocation_id.get_or_insert_with(|| {
+            use std::hash::BuildHasher;
+            // Per-instance randomized stdlib hash seeds avoid a dependency or
+            // exposing process identifiers in telemetry.
+            let nonce = || std::collections::hash_map::RandomState::new().hash_one(());
+            format!("{:016x}{:016x}", nonce(), nonce())
+        });
+        if self.decisions.len() < 16 {
+            self.decisions.push(decision);
+        } else {
+            self.dropped = self.dropped.saturating_add(1);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn bounded_evidence_snapshots_retain_the_first_decisions_and_count_overflow() {
+        let mut evidence = Evidence::default();
+        for i in 0..19 {
+            let mut decision = Decision::new(Phase::Flight);
+            decision.elapsed_ms = i;
+            evidence.record(decision);
+        }
+        assert_eq!(evidence.decisions.len(), 16);
+        assert_eq!(evidence.dropped, 3);
+        assert_eq!(
+            evidence
+                .decisions
+                .iter()
+                .map(|d| d.elapsed_ms)
+                .collect::<Vec<_>>(),
+            (0..16).collect::<Vec<_>>()
+        );
+        evidence.dropped = u32::MAX - 1;
+        evidence.record(Decision::new(Phase::Flight));
+        evidence.record(Decision::new(Phase::Flight));
+        assert_eq!(evidence.dropped, u32::MAX);
+    }
+
+    #[test]
+    fn pressure_extrema_keep_actual_sources_times_and_do_not_count_cached_reuse() {
+        let first = Reading {
+            source: PressureSource::Cgroup,
+            at_unix_ms: 10,
+            some_avg10: Some(12.0),
+            full_avg10: Some(1.0),
+            macos_level: None,
+        };
+        let later = Reading {
+            source: PressureSource::Host,
+            at_unix_ms: 260,
+            some_avg10: Some(9.0),
+            full_avg10: Some(4.0),
+            ..first
+        };
+        let mut decision = Decision::new(Phase::Capacity);
+        decision.pressure(true, Some(first), PressureState::Sampled);
+        decision.pressure(true, Some(first), PressureState::Sampled);
+        decision.pressure(false, Some(later), PressureState::Sampled);
+        decision.scan(8, Some(0), None);
+        decision.scan(2, Some(2), Some(Outcome::Admitted));
+        let summary = decision.psi.unwrap();
+        assert_eq!(summary.samples, 2);
+        assert_eq!(summary.max_some, Some(first));
+        assert_eq!(summary.max_full, Some(later));
+        assert_eq!(summary.last, later);
+        assert_eq!(decision.pressured_scans, 2);
+        assert_eq!(decision.requested_slots, Some(8));
+        assert_eq!(decision.available_slots, Some(0));
+        assert_eq!(decision.admitted_slots, Some(2));
+    }
+
+    #[test]
+    fn future_outcomes_and_phases_are_readable_without_claiming_old_policy_support() {
+        let mut value = serde_json::to_value(Decision::new(Phase::Flight)).unwrap();
+        value["phase"] = "future_phase".into();
+        value["outcome"] = "recovery_admitted".into();
+        let decision: Decision = serde_json::from_value(value).unwrap();
+        assert_eq!(decision.phase, Phase::Unknown);
+        assert_eq!(decision.outcome, Outcome::Unknown);
+    }
+}
