+fn contains_result(result: rusqlite::Result<bool>) -> bool {
+    match result {
+        Ok(committed) => committed,
+        Err(SqlError::QueryReturnedNoRows) => false,
+        Err(error) => {
+            let busy = matches!(&error, SqlError::SqliteFailure(code, _)
+                if matches!(code.code, ErrorCode::DatabaseBusy | ErrorCode::DatabaseLocked));
+            crate::opcounts::record_contains_failure(busy);
+            tracing::debug!(
+                busy,
+                "committed-entry query failed; preserving absent fallback"
+            );
+            false
+        }
+    }
+}
