+/// Preserve the first decision through emitted dep-info and wrapper re-entry.
+pub(crate) fn record_rustc_compile_first(reason: &'static str) {
+    INVOCATION_COUNTS.with(|slot| {
+        if let Some(counts) = slot.borrow().as_ref()
+            && counts.rustc_compile_first_reason.get().is_none()
+        {
+            counts.rustc_compile_first_reason.set(Some(reason));
+        }
+    });
+}
+
+pub(crate) fn rustc_compile_first_reason() -> Option<&'static str> {
+    INVOCATION_COUNTS.with(|slot| {
+        slot.borrow()
+            .as_ref()
+            .and_then(|counts| counts.rustc_compile_first_reason.get())
+    })
+}
