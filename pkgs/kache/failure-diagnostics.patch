+#[test]
+fn failure_engine_identity_hashes_the_actual_bytes_and_reports_missing_files() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("pinned-engine");
+    std::fs::write(&path, b"first engine").unwrap();
+    let first = engine_identity(&path).unwrap();
+    assert_eq!(first.executable, path.to_string_lossy());
+    assert_eq!(
+        first.blake3,
+        blake3::hash(b"first engine").to_hex().as_str()
+    );
+    std::fs::write(&path, b"second engine").unwrap();
+    assert_ne!(engine_identity(&path).unwrap().blake3, first.blake3);
+    assert!(engine_identity(&dir.path().join("missing")).is_err());
+}
