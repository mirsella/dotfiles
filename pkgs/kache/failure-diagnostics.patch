+    /// Hash only failed/bypassed invocations, never the hot hit path. A pinned
+    /// launcher can outlive an upgrade, so the package version is insufficient.
+    pub(crate) fn engine_provenance(mut self) -> Self {
+        let identity = std::env::current_exe()
+            .context("locating the failure engine")
+            .and_then(|path| engine_identity(&path));
+        match identity {
+            Ok(identity) => self.engine = Some(identity),
+            Err(error) => tracing::warn!("failure engine provenance unavailable: {error:#}"),
+        }
+        self
+    }
+
     /// What this invocation's rustc keys recorded for the event.
     fn key_record(mut self, key_record: KeyEventRecord) -> Self {
         self.key_record = key_record;
         self
     }
