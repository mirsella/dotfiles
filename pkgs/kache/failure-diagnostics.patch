+#[test]
+fn failed_compiler_event_keeps_exit_code_cost_and_engine_without_output_text() {
+    let _lock = crate::test_support::process_state_test_lock();
+    let dir = tempfile::tempdir().unwrap();
+    let config = test_config(dir.path().to_path_buf());
+    let event = build_event_details(
+        &config,
+        EventInputs::new("/work/tree", "broken", EventResult::Error, 9)
+            .compile_time_ms(7)
+            .exit_code(42)
+            .engine_provenance(),
+    );
+    assert_eq!(event.result, EventResult::Error);
+    assert_eq!(event.exit_code, Some(42));
+    assert_eq!(event.compile_time_ms, 7);
+    assert_eq!(event.schema, 27);
+    assert!(event.engine.is_some());
