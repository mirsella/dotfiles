--- /dev/null
+++ b/tests/profile_sharing_test.rs
@@ -0,0 +1,172 @@
+//! Generated source paths must share across equivalent Cargo profiles, while
+//! profile settings that change generated bytes must still invalidate reuse.
+#![cfg(unix)]
+
+use std::path::Path;
+use std::process::Command;
+
+mod common;
+use common::{DaemonGuard, build_kache, hermetic_command, isolated_config_path, kache_binary};
+
+fn write(root: &Path, name: &str, text: &str) {
+    let path = root.join(name);
+    std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+    std::fs::write(path, text).unwrap();
+}
+
+fn build(
+    root: &Path,
+    cache: &Path,
+    target: &Path,
+    profile: &str,
+    value: &str,
+) -> Vec<serde_json::Value> {
+    let events = cache.join("events.jsonl");
+    let before = std::fs::read_to_string(&events).unwrap_or_default().len();
+    let output = hermetic_command("cargo", cache, Some(&isolated_config_path(cache)))
+        .args([
+            "build",
+            "--offline",
+            "--quiet",
+            "--profile",
+            profile,
+            "-j",
+            "2",
+        ])
+        .current_dir(root)
+        .env("RUSTC_WRAPPER", kache_binary())
+        .env("CARGO_TARGET_DIR", target)
+        .env("CARGO_INCREMENTAL", "0")
+        .env("RUSTFLAGS", "-C debuginfo=0")
+        .env("GENERATED_VALUE", value)
+        .env("KACHE_SEED_NEW_TARGETS", "0")
+        .env("KACHE_BUILD_SCRIPT_CACHE", "1")
+        .env("KACHE_BUILD_SCRIPT_HERMETIC", "0")
+        .env_remove("CARGO_BUILD_BUILD_DIR")
+        .env_remove("CARGO_BUILD_TARGET_DIR")
+        .env_remove("RUSTC_WORKSPACE_WRAPPER")
+        .env_remove("CARGO_ENCODED_RUSTFLAGS")
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let profile_dir = if profile == "dev" { "debug" } else { profile };
+    let program = Command::new(target.join(profile_dir).join("profile_probe"))
+        .output()
+        .unwrap();
+    assert!(program.status.success());
+    assert_eq!(
+        String::from_utf8(program.stdout).unwrap().trim(),
+        format!("{value}:7")
+    );
+    let text = std::fs::read_to_string(events).unwrap();
+    text[before..]
+        .lines()
+        .map(|line| serde_json::from_str(line).unwrap())
+        .collect()
+}
+
+fn unit<'a>(events: &'a [serde_json::Value], name: &str) -> &'a serde_json::Value {
+    events
+        .iter()
+        .find(|event| event["crate_name"] == name && event["result"] != "passthrough")
+        .unwrap()
+}
+
+#[test]
+fn equivalent_profiles_reuse_generated_artifacts_and_restore_correct_depinfo() {
+    build_kache();
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path().canonicalize().unwrap();
+    let source = root.join("source");
+    write(
+        &source,
+        "Cargo.toml",
+        "[package]\nname='profile_probe'\nversion='0.1.0'\nedition='2021'\n[workspace]\n[dependencies]\ngenerated={path='generated'}\nplain={path='plain'}\n[profile.alt]\ninherits='dev'\n",
+    );
+    write(
+        &source,
+        "src/main.rs",
+        "fn main(){println!(\"{}:{}\",generated::value(),plain::value()); assert!(generated::origin().contains(\"/kache/profile/\"));}\n",
+    );
+    write(
+        &source,
+        "plain/Cargo.toml",
+        "[package]\nname='plain'\nversion='0.1.0'\nedition='2021'\n",
+    );
+    write(&source, "plain/src/lib.rs", "pub fn value()->u32{7}\n");
+    write(
+        &source,
+        "generated/Cargo.toml",
+        "[package]\nname='generated'\nversion='0.1.0'\nedition='2021'\n",
+    );
+    write(
+        &source,
+        "generated/src/lib.rs",
+        "include!(concat!(env!(\"OUT_DIR\"),\"/generated.rs\"));\n",
+    );
+    write(
+        &source,
+        "generated/build.rs",
+        r#"fn main(){
+        println!("cargo:rerun-if-changed=build.rs");
+        println!("cargo:rerun-if-env-changed=GENERATED_VALUE");
+        let value=std::env::var("GENERATED_VALUE").unwrap();
+        let text=format!("pub fn value()->u32{{{value}}} pub fn origin()->&'static str{{file!()}}\n");
+        std::fs::write(std::path::Path::new(&std::env::var_os("OUT_DIR").unwrap()).join("generated.rs"),text).unwrap();
+    }"#,
+    );
+    let cache = root.join("cache");
+    std::fs::create_dir_all(&cache).unwrap();
+    std::fs::write(isolated_config_path(&cache), "[cache]\nlocal_only=true\ndaemon_publish=false\ninput_predictions=false\nadaptive_incremental=false\nexplain_miss=true\n").unwrap();
+    let _daemon = DaemonGuard::new(kache_binary(), &cache);
+    let first = build(&source, &cache, &root.join("first"), "dev", "42");
+    let second_target = root.join("second");
+    let second = build(&source, &cache, &second_target, "alt", "42");
+    for name in ["generated", "plain"] {
+        assert_eq!(unit(&first, name)["result"], "miss");
+        assert_eq!(unit(&second, name)["result"], "local_hit", "{second:#?}");
+        assert_eq!(
+            unit(&first, name)["cache_key"],
+            unit(&second, name)["cache_key"]
+        );
+    }
+    fn files(root: &Path, output: &mut Vec<std::path::PathBuf>) {
+        for entry in std::fs::read_dir(root).unwrap() {
+            let path = entry.unwrap().path();
+            if path.is_dir() {
+                files(&path, output);
+            } else {
+                output.push(path);
+            }
+        }
+    }
+    let mut outputs = Vec::new();
+    files(&second_target, &mut outputs);
+    let depinfo = outputs
+        .into_iter()
+        .find(|path| {
+            path.file_name()
+                .unwrap()
+                .to_string_lossy()
+                .starts_with("generated-")
+                && path.extension().is_some_and(|ext| ext == "d")
+        })
+        .unwrap();
+    let depinfo = std::fs::read_to_string(depinfo).unwrap();
+    assert!(depinfo.contains("second/alt/"), "{depinfo}");
+    assert!(
+        !depinfo.contains("first/debug/") && !depinfo.contains("__kache_profile__"),
+        "{depinfo}"
+    );
+    let changed = build(&source, &cache, &root.join("changed"), "alt", "43");
+    assert_eq!(unit(&changed, "generated")["result"], "miss");
+    assert_ne!(
+        unit(&first, "generated")["cache_key"],
+        unit(&changed, "generated")["cache_key"]
+    );
+    assert_eq!(unit(&changed, "plain")["result"], "local_hit");
+}
