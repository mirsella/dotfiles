+/// Report captured events for one caller-defined ID without cache keys,
+/// compiler arguments, environment values, or raw diagnostics.
+pub fn telemetry_build(config: &Config, id: &str, window: SinceWindow) -> Result<()> {
+    if !crate::wrapper::valid_build_id(id) {
+        return Err(crate::machine::invalid_arguments(
+            "build ID must contain exactly 32 hexadecimal digits",
+        ));
+    }
+    let events = crate::events::read_build_events_since(
+        &config.event_log_path(),
+        window.cutoff(jiff::Timestamp::now()),
+        id,
+    )?;
+    let matched: Vec<_> = events
+        .into_iter()
+        .map(|event| {
+            serde_json::json!({
+                "root": event.root,
+                "crate": event.rebuilt_package.as_deref().unwrap_or(&event.crate_name),
+                "result": event.result.to_string(),
+                "version": event.version,
+                "elapsed_ms": event.elapsed_ms,
+                "compile_time_ms": event.compile_time_ms,
+                "compiler_runs": event.compiler_runs,
+                "permit_wait_ms": event.permit_wait_ms,
+                "flight_wait_ms": event.flight_wait_ms,
+                "restore_ms": event.restore_ms,
+                "probe": crate::report::is_probe_passthrough(&event),
+                "build_script": event.crate_name == "build_script_run",
+                "miss_reason": event.miss_reason,
+                "changed_key_groups": event.key_diff,
+                "store_error": !event.store_error.is_empty(),
+                "lookup_rejected": !event.lookup_rejection.is_empty(),
+            })
+        })
+        .collect();
+    println!(
+        "{}",
+        serde_json::json!({"schema": 1, "build_id": id, "events": matched})
+    );
+    Ok(())
+}
