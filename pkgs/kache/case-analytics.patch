+/// Prefer a single adequate substitute, then greedily fill the remaining
+/// budget with the largest non-overshooting item. This is a bounded search;
+/// no match does not imply no valid combination exists.
+fn take_group<'a>(
+    by_size: &mut BTreeMap<u64, Vec<&'a EntryFeatures>>,
+    freed: u64,
+) -> Vec<Victim<'a>> {
+    let mut selected = Vec::new();
+    let mut remaining = freed;
+    for _ in 0..MAX_SUBSTITUTES {
+        let size = by_size
+            .range(remaining..=remaining + freed / 20)
+            .next()
+            .or_else(|| by_size.range(..remaining).next_back())
+            .map(|(size, _)| *size);
+        let Some(size) = size else { break };
+        let bucket = by_size.get_mut(&size).expect("selected size is present");
+        let entry = bucket.pop().expect("size bucket is nonempty");
+        if bucket.is_empty() {
+            by_size.remove(&size);
+        }
+        selected.push((entry, size));
+        remaining = remaining.saturating_sub(size);
+        if remaining == 0 {
+            return selected.into_iter().map(|(e, n)| Victim::new(e, n)).collect();
+        }
+    }
+    // Failed searches must not reserve entries for later comparisons.
+    for (entry, size) in selected.into_iter().rev() {
+        by_size.entry(size).or_default().push(entry);
+    }
+    Vec::new()
