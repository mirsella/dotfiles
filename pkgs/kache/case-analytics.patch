+/// Read a tagged build without holding the writer lock while scanning JSON.
+/// Rotation replaces the inode, and the recorded length excludes later appends.
+pub fn read_build_events_since(
+    path: &Path,
+    since: DateTime<Utc>,
+    id: &str,
+) -> Result<Vec<BuildEvent>> {
+    let matches = |event: &BuildEvent| event.build_id.as_deref() == Some(id);
+    let mut events = read_archived_events_since(path, since, matches);
+    let Some(log) = snapshot_event_log(path)? else {
+        return Ok(events);
+    };
+    let finder = memchr::memmem::Finder::new(id.as_bytes());
+    let mut reader = BufReader::new(log);
+    let mut line = Vec::new();
+    while reader.read_until(b'\n', &mut line)? != 0 {
+        // Kache emits build IDs as unescaped ASCII hex. JSON decoding, not the
+        // substring prefilter, decides whether the exact field matches.
+        if finder.find(&line).is_some()
+            && let Ok(event) = serde_json::from_slice::<BuildEvent>(&line)
+            && event.ts >= since
+            && matches(&event)
+        {
+            events.push(event);
+        }
+        line.clear();
+    }
     Ok(events)
 }
 
+fn snapshot_event_log(path: &Path) -> Result<Option<std::io::Take<File>>> {
+    if !path.exists() {
+        return Ok(None);
+    }
+    let lock = open_log_lock(path).context("opening event log lock")?;
+    lock.lock_shared()
+        .context("locking event log for snapshot")?;
+    let file = File::open(path).context("opening event log")?;
+    let length = file.metadata()?.len();
+    lock.unlock().context("unlocking event log snapshot")?;
+    Ok(Some(file.take(length)))
+}
