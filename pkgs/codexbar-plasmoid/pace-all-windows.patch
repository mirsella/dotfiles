+// Every window gets a pace line, not just weekly.
 assert.equal(
     catalog.paceLine(null, sessionExtra, sessionMinutes, now, "codex"),
+    "Pace: 50% in reserve · Lasts until reset"
+)
+
+const monthlyWindow = {
+    usedPercent: 20,
+    windowMinutes: 43200,
+    resetsAt: "2026-09-15T12:00:00Z",
+}
+assert.equal(
+    catalog.paceLine(null, monthlyWindow, 43200, now, "opencodego"),
+    "Pace: 27% in reserve · Lasts until reset"
+)
+// opencode-go's monthly window already carries the CLI's verdict; the widget
+// drops the "Expected …" part the same way it does for weekly.
+assert.equal(
+    catalog.paceLine(
+        { summary: "11% in reserve | Expected 30% used | Lasts until reset" },
+        monthlyWindow, 43200, now, "opencodego"
+    ),
+    "Pace: 11% in reserve · Lasts until reset"
+)
+// A window without a duration cannot be projected.
+assert.equal(
+    catalog.paceLine(null, { usedPercent: 10, resetsAt: "2026-09-01T00:00:00Z" },
+        0, now, "codex"),
+    ""
+)
+// CodexBarCore withholds the verdict until 3% of the window has elapsed, which
+// blanks a weekly window for over five hours after a reset. A fresh window gets
+// the projection immediately, even when it reads as ahead of schedule.
+function freshWeekly(usedPercent) {
+    return {
+        usedPercent: usedPercent,
+        windowMinutes: 10080,
+        resetsAt: "2026-09-06T12:00:00Z",
+    }
+}
+const earlyInWindow = Date.parse("2026-08-30T15:00:00Z")
+assert.equal(
+    catalog.paceLine(null, freshWeekly(4), 10080, earlyInWindow, "claude"),
+    "Pace: 2% in deficit · Runs out in 3d"
+)
+assert.equal(
+    catalog.paceLine(null, freshWeekly(1), 10080, earlyInWindow, "claude"),
+    "Pace: On pace · Lasts until reset"
+)
+// Nothing can be projected at the instant the window opens.
+assert.equal(
+    catalog.paceLine(null, freshWeekly(0), 10080,
