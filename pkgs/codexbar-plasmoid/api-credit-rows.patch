diff --git a/tests/test-api-credits.js b/tests/test-api-credits.js
new file mode 100644
index 0000000..2c87a37
--- /dev/null
+++ b/tests/test-api-credits.js
@@ -0,0 +1,76 @@
+const assert = require("assert")
+const fs = require("fs")
+const vm = require("vm")
+const api = {}
+vm.runInNewContext(fs.readFileSync("contents/ui/code/apiCredits.js", "utf8").replace(/^\.pragma library\s*/, ""), api)
+const now = Date.parse("2026-11-10T12:00:00Z")
+const project = "proj_example"
+function row(provider, entry, error) { return api.row(provider, {entry, error}, project, 190, now) }
+const claude = {provider:"claudeplatform", usage:{updatedAt:new Date(now).toISOString(),
+    primary:{resetDescription:"$150.00 of $200.00 left · Expires Dec 3 (UTC)"},
+    providerCost:{balance:900, used:900, currencyCode:"USD"}}}
+assert.strictEqual(row("claude", claude).value, "$50.00 / $200.00 used")
+assert.strictEqual(row("claude", claude).usedPercent, 25)
+assert.ok(row("claude", claude).detail.includes("Expires Dec 3"))
+assert.ok(!row("claude", claude).detail.includes("Resets"))
+assert.strictEqual(row("codex", claude).value, "Unavailable")
+assert.strictEqual(row("claude", claude, "Session expired").value, "Unavailable")
+assert.strictEqual(row("claude", {provider:"claudeplatform", usage:{updatedAt:new Date(now).toISOString(),
+    secondary:claude.usage.primary, providerCost:{balance:200}}}).value, "Unavailable")
+const badGrant = JSON.parse(JSON.stringify(claude))
+badGrant.usage.primary.resetDescription = "$300.00 of $200.00 left"
+assert.strictEqual(row("claude", badGrant).value, "Unavailable")
+badGrant.usage.primary.resetDescription = "$1,2 of $200.00 left"
+assert.strictEqual(row("claude", badGrant).value, "Unavailable")
+badGrant.usage.primary.resetDescription = "$0.00 of $200.00 left"
+assert.strictEqual(row("claude", badGrant).value, "$200.00 / $200.00 used")
+const openai = {provider:"openai", source:"admin-api:project", usage:{updatedAt:new Date(now).toISOString(),
+    providerCost:{used:9999, currencyCode:"USD"},
+    openAIAPIUsage:{projectID:project, daily:Array.from({length:10}, (_,i)=>({
+        startTime:`2026-11-${String(i+1).padStart(2,"0")}T00:00:00Z`,
+        endTime:`2026-11-${String(i+2).padStart(2,"0")}T00:00:00Z`, costUSD:i===0?10:0}))}}}
+assert.strictEqual(row("codex", openai).value, "$10.00 / $190.00 used")
+assert.ok(row("codex", openai).detail.includes("2026-12-01"))
+for (const mutate of [
+    x=>x.usage.openAIAPIUsage.projectID="proj_other",
+    x=>x.source="admin-api",
+    x=>x.usage.openAIAPIUsage.daily.shift(),
+    x=>x.usage.openAIAPIUsage.daily.push(x.usage.openAIAPIUsage.daily[0]),
+    x=>x.usage.openAIAPIUsage.daily[0].costUSD=-1,
+    x=>x.usage.openAIAPIUsage.daily[0].costUSD="0",
+    x=>x.usage.openAIAPIUsage.daily[0]=null,
+    x=>x.usage.updatedAt="2026-10-31T12:00:00Z",
+    x=>x.usage.updatedAt="2026-11-11T00:00:00Z",
+    x=>x.usage.providerCost.currencyCode="EUR"
+]) {
+    const invalid=JSON.parse(JSON.stringify(openai)); mutate(invalid)
+    assert.strictEqual(row("codex",invalid).value,"Unavailable")
+}
+assert.strictEqual(api.row("codex",{entry:openai},project,0,now).value,"Unavailable")
+assert.strictEqual(api.row("claude",null,project,190,now).value,"Unavailable")
+assert.strictEqual(api.row("opencodego",null,project,190,now),null)
+const zero = JSON.parse(JSON.stringify(openai))
+zero.usage.openAIAPIUsage.daily[0].costUSD=0
+assert.strictEqual(row("codex",zero).value,"$0.00 / $190.00 used")
+const overspend = JSON.parse(JSON.stringify(openai))
+overspend.usage.openAIAPIUsage.daily[0].costUSD=195
+assert.strictEqual(row("codex",overspend).value,"$195.00 / $190.00 used")
+assert.strictEqual(row("codex",overspend).usedPercent,100)
+const intact = JSON.stringify(openai)
+row("codex",openai)
+assert.strictEqual(JSON.stringify(openai),intact)
+const endOfYear=Date.parse("2026-12-31T12:00:00Z")
+const fullMonth=JSON.parse(JSON.stringify(openai))
+fullMonth.usage.updatedAt=new Date(endOfYear).toISOString()
+fullMonth.usage.openAIAPIUsage.daily=Array.from({length:31},(_,i)=>({
+    startTime:new Date(Date.UTC(2026,11,i+1)).toISOString(),
+    endTime:new Date(Date.UTC(2026,11,i+2)).toISOString(),costUSD:1}))
+assert.strictEqual(api.row("codex",{entry:fullMonth},project,190,endOfYear).value,"$31.00 / $190.00 used")
+assert.ok(api.row("codex",{entry:fullMonth},project,190,endOfYear).detail.includes("2027-01-01"))
+fullMonth.usage.openAIAPIUsage.daily.shift()
+assert.strictEqual(api.row("codex",{entry:fullMonth},project,190,endOfYear).value,"Unavailable")
+assert.strictEqual(JSON.stringify(api.sources(["claude","codex"],true)),
+    JSON.stringify(["claude","codex","claudeplatform","openai"]))
+assert.strictEqual(JSON.stringify(api.sources(["codex","openai"],true)),JSON.stringify(["codex","openai"]))
+assert.strictEqual(JSON.stringify(api.sources(["claude"],false)),JSON.stringify(["claude"]))
+console.log("API credit rows: passed")
