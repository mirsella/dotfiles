diff --git a/contents/ui/code/apiCredits.js b/contents/ui/code/apiCredits.js
new file mode 100644
index 0000000..7546074
--- /dev/null
+++ b/contents/ui/code/apiCredits.js
@@ -0,0 +1,90 @@
+.pragma library
+
+// Billing is fetched separately, never substituted for subscription usage.
+function sources(providers, enabled) {
+    var out = providers.slice()
+    if (enabled) {
+        if (providers.indexOf("claude") >= 0 && out.indexOf("claudeplatform") < 0)
+            out.push("claudeplatform")
+        if (providers.indexOf("codex") >= 0 && out.indexOf("openai") < 0)
+            out.push("openai")
+    }
+    return out
+}
+
+function dollars(amount) { return "$" + amount.toFixed(2) }
+function finite(n) { return typeof n === "number" && isFinite(n) }
+
+function row(provider, record, project, budget, now) {
+    if (provider !== "claude" && provider !== "codex") return null
+    var title = provider === "claude" ? "Promotional API credits" : "OpenCode API project budget"
+    function unavailable(reason) {
+        return { title: title, value: "Unavailable", detail: reason, usedPercent: -1 }
+    }
+    if (!record || !record.entry)
+        return unavailable(record && record.error ? record.error : "Waiting for billing data")
+    if (record.error) return unavailable(record.error)
+    var entry = record.entry
+    var expected = provider === "claude" ? "claudeplatform" : "openai"
+    if (entry.provider !== expected || !entry.usage)
+        return unavailable("Unexpected billing source")
+    var usage = entry.usage
+    var stamp = Date.parse(usage.updatedAt)
+    var today = new Date(now).toISOString().slice(0, 10)
+    // Never carry yesterday's grant/month across a boundary as current data.
+    if (!isFinite(stamp) || stamp > now + 300000
+            || new Date(stamp).toISOString().slice(0, 10) !== today)
+        return unavailable("Billing data is stale; refresh to update")
+    if (provider === "claude") {
+        if (!usage.providerCost || usage.providerCost.currencyCode !== "USD")
+            return unavailable("Promotional grant currency is not USD")
+        // CLI primary is exclusively the active subscription_api_credit tranche;
+        // purchased credit is secondary. Never use the total prepaid balance.
+        if (!usage.primary)
+            return unavailable("No active promotional grant reported")
+        var description = usage.primary.resetDescription || ""
+        var match = /^\$\s*((?:\d+|\d{1,3}(?:,\d{3})+)(?:\.\d+)?) of \$\s*((?:\d+|\d{1,3}(?:,\d{3})+)(?:\.\d+)?) left(?: · (.+))?$/.exec(description)
+        if (!match) return unavailable("Unrecognized promotional grant amounts")
+        var remaining = Number(match[1].replace(/,/g, ""))
+        var total = Number(match[2].replace(/,/g, ""))
+        if (!finite(remaining) || !finite(total) || total <= 0 || remaining < 0 || remaining > total)
+            return unavailable("Invalid promotional grant amounts")
+        return { title: title, value: dollars(total - remaining) + " / " + dollars(total) + " used",
+                 detail: dollars(remaining) + " left" + (match[3] ? " · " + match[3] : ""),
+                 usedPercent: (total - remaining) / total * 100 }
+    }
+    var report = usage.openAIAPIUsage
+    if (!project || !report || report.projectID !== project || entry.source !== "admin-api:project")
+        return unavailable("Configure matching project-scoped OpenAI billing")
+    if (!finite(budget) || budget <= 0 || !usage.providerCost || usage.providerCost.currencyCode !== "USD")
+        return unavailable("A positive USD project budget is required")
+    if (!Array.isArray(report.daily)) return unavailable("Missing daily project costs")
+    var month = today.slice(0, 7)
+    var days = {}
+    var used = 0
+    for (var i = 0; i < report.daily.length; i++) {
+        var bucket = report.daily[i]
+        if (!bucket || typeof bucket !== "object") return unavailable("Invalid daily project costs")
+        var start = Date.parse(bucket.startTime)
+        var end = Date.parse(bucket.endTime)
+        if (!isFinite(start) || !isFinite(end)) return unavailable("Invalid daily project costs")
+        var day = new Date(start).toISOString().slice(0, 10)
+        if (day.slice(0, 7) !== month || day > today) continue
+        if (start !== Date.parse(day + "T00:00:00Z") || end - start !== 86400000
+                || days[day] || !finite(bucket.costUSD) || bucket.costUSD < 0)
+            return unavailable("Invalid or duplicate daily project costs")
+        days[day] = true
+        used += bucket.costUSD
+    }
+    var count = new Date(now).getUTCDate()
+    for (var d = 1; d <= count; d++) {
+        if (!days[month + "-" + ("0" + d).slice(-2)])
+            return unavailable("CLI history does not cover the full UTC month")
+    }
+    if (!finite(used)) return unavailable("Invalid project cost total")
+    var next = new Date(Date.UTC(new Date(now).getUTCFullYear(), new Date(now).getUTCMonth() + 1, 1))
+    return { title: title, value: dollars(used) + " / " + dollars(budget) + " used",
+             detail: "Calendar month · Resets " + next.toISOString().slice(0, 10)
+                 + " (UTC) · Costs may lag; not a grant balance",
+             usedPercent: Math.min(100, used / budget * 100) }
+}
