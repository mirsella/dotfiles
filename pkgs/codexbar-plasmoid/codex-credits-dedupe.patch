diff --git a/contents/ui/code/catalog.js b/contents/ui/code/catalog.js
index 3811746..e42f402 100644
--- a/contents/ui/code/catalog.js
+++ b/contents/ui/code/catalog.js
@@ -242,8 +242,10 @@ function amountText(amount, currencyCode) {
 
 // Balances a card lists from usage.providerCost, as upstream's per-provider
 // cost presentation names them: [{ label, amount, currencyCode }]. A
-// balance of zero is listed, a missing one is not.
-function costBalances(providerId, cost) {
+// balance of zero is listed, a missing one is not. creditsShown says the
+// card's own credits block already renders the balance (Codex), so the
+// generic row would only repeat it.
+function costBalances(providerId, cost, creditsShown) {
     if (!cost || typeof cost !== "object")
         return []
     function one(label, amount) {
@@ -253,6 +255,8 @@ function costBalances(providerId, cost) {
     case "claude":
         return one("Extra usage balance", cost.balance)
     case "codex":
+        if (creditsShown)
+            return []
         return cost.currencyCode === "Credits" ? one("Extra usage balance", cost.balance) : []
     case "devin":
         return cost.period === "Extra usage balance" ? one("Extra usage", cost.used) : []
