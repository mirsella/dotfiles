[Unit]
Description=Protect interactive processes and prefer compiler OOM victims
Before=graphical.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/host-tools oom-protect --user mirsella
Restart=on-failure
RestartSec=1s
OOMScoreAdjust=-900
CapabilityBoundingSet=CAP_SYS_RESOURCE CAP_SYS_PTRACE CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
