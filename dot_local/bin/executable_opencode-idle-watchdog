//! Run a command after every other opencode session has gone idle.

use std::collections::{HashMap, HashSet};
use std::env;
use std::ffi::OsString;
use std::fmt::Write as _;
use std::fs::{self, OpenOptions};
use std::io::{self, IsTerminal, Write};
use std::os::unix::fs::MetadataExt;
use std::os::unix::process::ExitStatusExt;
use std::path::{Path, PathBuf};
use std::process::{Child, Command};
use std::sync::mpsc::{self, Receiver};
use std::thread::{self, JoinHandle};
use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};

use anyhow::{Context, Result, bail};
use base64::Engine;
use clap::Parser;
use comfy_table::{Cell, CellAlignment, Color, ContentArrangement, Table, presets::UTF8_FULL};
use jiff::Zoned;
use serde_json::Value;
use signal_hook::{
    consts::{SIGINT, SIGTERM},
    iterator::{Handle as SignalHandle, Signals},
};

const NAME: &str = "opencode-idle-watchdog";
const DEFAULT_INTERVAL: u64 = 30;
const DEFAULT_IDLE_CHECKS: u32 = 3;
const HEADERS: [&str; 6] = ["STATUS", "AGE", "UPDATED", "WORKSPACE", "SESSION", "TITLE"];

#[derive(Parser)]
#[command(
    about = "Wait until all other opencode sessions go idle, then run a command in the foreground.",
    after_help = "Shortcuts: sleep/suspend -> systemctl suspend, poweroff -> systemctl poweroff, hibernate -> systemctl hibernate",
    trailing_var_arg = true
)]
struct Options {
    #[arg(
        short = 'i',
        long,
        default_value_t = DEFAULT_INTERVAL,
        value_parser = clap::value_parser!(u64).range(1..)
    )]
    interval: u64,

    #[arg(
        short = 'r',
        long,
        default_value_t = DEFAULT_IDLE_CHECKS,
        value_parser = clap::value_parser!(u32).range(1..)
    )]
    required_idle_checks: u32,

    #[arg(long = "ignore-session", value_name = "SESSION", action = clap::ArgAction::Append)]
    ignored_sessions: Vec<String>,

    #[arg(value_name = "COMMAND", num_args = 0..)]
    command: Vec<OsString>,
}

struct State {
    root: PathBuf,
    log_file: PathBuf,
}

impl State {
    fn discover() -> Result<Self> {
        let home = env::var_os("HOME").context("HOME is not set")?;
        let cache = env::var_os("XDG_CACHE_HOME")
            .map(PathBuf::from)
            .unwrap_or_else(|| PathBuf::from(home).join(".cache"));
        let root = cache.join(NAME);
        Ok(Self {
            log_file: root.join("watchdog.log"),
            root,
        })
    }

    fn log(&self, message: impl AsRef<str>) {
        let line = self.timestamped(message);
        println!("{line}");
        let _ = io::stdout().flush();
        self.write_log(&line);
    }

    fn record(&self, message: impl AsRef<str>) {
        self.write_log(&self.timestamped(message));
    }

    fn timestamped(&self, message: impl AsRef<str>) -> String {
        format!(
            "[{}] {}",
            Zoned::now().strftime("%Y-%m-%d %H:%M:%S"),
            message.as_ref()
        )
    }

    fn write_log(&self, line: &str) {
        if fs::create_dir_all(&self.root).is_ok()
            && let Ok(mut file) = OpenOptions::new()
                .create(true)
                .append(true)
                .open(&self.log_file)
        {
            let _ = writeln!(file, "{line}");
        }
    }
}

struct Cancellation {
    receiver: Receiver<i32>,
    handle: SignalHandle,
    worker: Option<JoinHandle<()>>,
}

impl Cancellation {
    fn new() -> Result<Self> {
        let mut signals = Signals::new([SIGINT, SIGTERM]).context("install signal handlers")?;
        let handle = signals.handle();
        let (sender, receiver) = mpsc::channel();
        let worker = thread::spawn(move || {
            for signal in signals.forever() {
                if sender.send(signal).is_err() {
                    break;
                }
            }
        });
        Ok(Self {
            receiver,
            handle,
            worker: Some(worker),
        })
    }

    fn wait(&self, duration: Duration) -> Option<i32> {
        self.receiver.recv_timeout(duration).ok()
    }
}

impl Drop for Cancellation {
    fn drop(&mut self) {
        self.handle.close();
        if let Some(worker) = self.worker.take() {
            let _ = worker.join();
        }
    }
}

struct OpenCodeProcess {
    pid: i32,
    kind: ProcessKind,
    authorization: Option<String>,
}

enum ProcessKind {
    Server,
    Attach {
        endpoint: String,
        directory: Option<PathBuf>,
    },
}

fn proc_file(path: &Path, name: &str) -> Result<Option<Vec<u8>>> {
    match fs::read(path.join(name)) {
        Ok(bytes) => Ok(Some(bytes)),
        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(None),
        Err(error) => Err(error).with_context(|| format!("read {}", path.join(name).display())),
    }
}

fn nul_strings(bytes: &[u8]) -> Result<Vec<String>> {
    bytes
        .split(|byte| *byte == 0)
        .filter(|value| !value.is_empty())
        .map(|value| {
            std::str::from_utf8(value)
                .map(str::to_owned)
                .context("/proc command line contains invalid UTF-8")
        })
        .collect()
}

fn env_value(environment: &[u8], name: &[u8]) -> Result<Option<String>> {
    for entry in environment.split(|byte| *byte == 0) {
        let Some(value) = entry
            .strip_prefix(name)
            .and_then(|entry| entry.strip_prefix(b"="))
        else {
            continue;
        };
        let value = std::str::from_utf8(value)
            .context("/proc environment contains invalid UTF-8")?
            .to_owned();
        return Ok((!value.trim().is_empty()).then_some(value));
    }
    Ok(None)
}

fn server_env_value(name: &str) -> Result<Option<String>> {
    if let Some(value) = env::var_os(name) {
        let value = value
            .into_string()
            .map_err(|_| anyhow::anyhow!("{name} is not valid UTF-8"))?;
        if !value.trim().is_empty() {
            return Ok(Some(value));
        }
    }
    let Some(home) = env::var_os("HOME") else {
        return Ok(None);
    };
    let config = env::var_os("XDG_CONFIG_HOME")
        .map(PathBuf::from)
        .unwrap_or_else(|| PathBuf::from(home).join(".config"));
    let path = config.join("opencode/server.env");
    let contents = match fs::read_to_string(&path) {
        Ok(contents) => contents,
        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
        Err(error) => return Err(error).with_context(|| format!("read {}", path.display())),
    };
    Ok(contents
        .lines()
        .filter_map(|line| line.trim().split_once('='))
        .find(|(key, _)| *key == name)
        .map(|(_, value)| value.trim().trim_matches(['\'', '"']).to_owned())
        .filter(|value| !value.is_empty()))
}

fn basic_authorization(username: &str, password: &str) -> String {
    let encoded =
        base64::engine::general_purpose::STANDARD.encode(format!("{username}:{password}"));
    format!("Basic {encoded}")
}

fn process_kind(args: &[String], cwd: Option<PathBuf>) -> Result<ProcessKind> {
    if args.get(1).map(String::as_str) != Some("attach") {
        return Ok(ProcessKind::Server);
    }
    let endpoint = args
        .get(2)
        .context("opencode attach has no endpoint")?
        .clone();
    let mut explicit_directory = None;
    for (index, argument) in args.iter().enumerate() {
        let value = if let Some(value) = argument.strip_prefix("--dir=") {
            value
        } else if argument == "--dir" {
            args.get(index + 1)
                .map(String::as_str)
                .context("opencode attach --dir has no value")?
        } else {
            continue;
        };
        if value.is_empty() {
            bail!("opencode attach --dir has an empty value");
        }
        explicit_directory = Some(value);
        break;
    }
    let directory = match explicit_directory {
        Some(value) => {
            let path = PathBuf::from(value);
            if path.is_absolute() {
                Some(path)
            } else {
                cwd.map(|cwd| cwd.join(path))
            }
        }
        None => cwd,
    };
    Ok(ProcessKind::Attach {
        endpoint,
        directory,
    })
}

fn opencode_processes() -> Result<Vec<OpenCodeProcess>> {
    let uid = unsafe { libc::getuid() };
    let configured_username =
        server_env_value("OPENCODE_SERVER_USERNAME")?.unwrap_or_else(|| "opencode".to_owned());
    let configured_password = server_env_value("OPENCODE_SERVER_PASSWORD")?;
    let mut processes = Vec::new();
    for entry in fs::read_dir("/proc").context("read /proc")? {
        let entry = entry.context("read /proc entry")?;
        let path = entry.path();
        let Some(pid) = entry
            .file_name()
            .to_str()
            .and_then(|name| name.parse::<i32>().ok())
        else {
            continue;
        };
        let metadata = match entry.metadata() {
            Ok(metadata) => metadata,
            Err(error) if error.kind() == io::ErrorKind::NotFound => continue,
            Err(error) => return Err(error).context("read /proc entry metadata"),
        };
        if metadata.uid() != uid {
            continue;
        }
        let Some(comm) = proc_file(&path, "comm")? else {
            continue;
        };
        if comm.strip_suffix(b"\n") != Some(b"opencode") {
            continue;
        }
        let Some(cmdline) = proc_file(&path, "cmdline")? else {
            continue;
        };
        let Some(environment) = proc_file(&path, "environ")? else {
            continue;
        };
        let args = nul_strings(&cmdline)?;
        if args.is_empty() {
            bail!("opencode pid {pid} has an empty cmdline");
        }
        let password = env_value(&environment, b"OPENCODE_SERVER_PASSWORD")?
            .or_else(|| configured_password.clone());
        let username = env_value(&environment, b"OPENCODE_SERVER_USERNAME")?
            .unwrap_or_else(|| configured_username.clone());
        let authorization = password
            .as_deref()
            .map(|password| basic_authorization(&username, password));
        let cwd = if args.get(1).map(String::as_str) == Some("attach") {
            match fs::read_link(path.join("cwd")) {
                Ok(cwd) => Some(cwd),
                Err(error) if error.kind() == io::ErrorKind::NotFound => None,
                Err(error) => return Err(error).context(format!("read opencode pid {pid} cwd")),
            }
        } else {
            None
        };
        processes.push(OpenCodeProcess {
            pid,
            kind: process_kind(&args, cwd)?,
            authorization,
        });
    }
    processes.sort_by_key(|process| process.pid);
    Ok(processes)
}

fn listener_host(address: &str) -> Result<String> {
    match address.len() {
        8 => {
            let address = u32::from_str_radix(address, 16).context("invalid IPv4 listener")?;
            let address = std::net::Ipv4Addr::from(address.to_le_bytes());
            Ok((if address.is_unspecified() {
                std::net::Ipv4Addr::LOCALHOST
            } else {
                address
            })
            .to_string())
        }
        32 => {
            let mut octets = [0; 16];
            for (word, output) in address
                .as_bytes()
                .as_chunks::<8>()
                .0
                .iter()
                .zip(octets.chunks_mut(4))
            {
                let word = std::str::from_utf8(word).context("invalid IPv6 listener")?;
                output.copy_from_slice(
                    &u32::from_str_radix(word, 16)
                        .context("invalid IPv6 listener")?
                        .to_le_bytes(),
                );
            }
            let address = std::net::Ipv6Addr::from(octets);
            Ok(format!(
                "[{}]",
                if address.is_unspecified() {
                    std::net::Ipv6Addr::LOCALHOST
                } else {
                    address
                }
            ))
        }
        _ => bail!("invalid listener address length"),
    }
}

fn tcp_listener_urls() -> Result<HashMap<String, String>> {
    let mut listeners = HashMap::new();
    for path in ["/proc/net/tcp", "/proc/net/tcp6"] {
        let contents = fs::read_to_string(path).with_context(|| format!("read {path}"))?;
        for (line_number, line) in contents.lines().enumerate().skip(1) {
            let fields: Vec<_> = line.split_whitespace().collect();
            if fields.len() < 10 {
                bail!("malformed {path} line {}", line_number + 1);
            }
            if fields[3] != "0A" {
                continue;
            }
            let (address, port) = fields[1].split_once(':').context("listener has no port")?;
            let host = listener_host(address)?;
            let port = u16::from_str_radix(port, 16).context("invalid listener port")?;
            listeners.insert(fields[9].to_owned(), format!("http://{host}:{port}"));
        }
    }
    Ok(listeners)
}

fn process_sockets(pid: i32) -> Result<Vec<String>> {
    let entries = match fs::read_dir(format!("/proc/{pid}/fd")) {
        Ok(entries) => entries,
        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(Vec::new()),
        Err(error) => return Err(error).context(format!("read /proc/{pid}/fd")),
    };
    let mut sockets = Vec::new();
    for entry in entries {
        let entry = match entry {
            Ok(entry) => entry,
            Err(error) if error.kind() == io::ErrorKind::NotFound => continue,
            Err(error) => return Err(error).context("read process file descriptor"),
        };
        let target = match fs::read_link(entry.path()) {
            Ok(target) => target,
            Err(error) if error.kind() == io::ErrorKind::NotFound => continue,
            Err(error) => return Err(error).context("read process file descriptor link"),
        };
        let Some(inode) = target
            .to_str()
            .and_then(|target| target.strip_prefix("socket:["))
            .and_then(|target| target.strip_suffix(']'))
        else {
            continue;
        };
        sockets.push(inode.to_owned());
    }
    Ok(sockets)
}

fn endpoint_key(url: &str) -> Option<String> {
    let authority = url
        .strip_prefix("http://")
        .or_else(|| url.strip_prefix("https://"))?
        .split(['/', '?', '#'])
        .next()?;
    let authority = authority
        .rsplit_once('@')
        .map_or(authority, |(_, host)| host);
    let (host, port) = authority
        .strip_prefix('[')
        .and_then(|authority| authority.split_once("]:"))
        .or_else(|| authority.rsplit_once(':'))?;
    let port = port.parse::<u16>().ok()?;
    let host = host.trim_matches(['[', ']']).to_ascii_lowercase();
    let host = match host.as_str() {
        "localhost" => "127.0.0.1",
        host => host,
    };
    Some(format!("{host}:{port}"))
}

struct OpenCodeApi<'a> {
    client: &'a ureq::Agent,
    url: &'a str,
    authorization: Option<&'a str>,
    directory: Option<&'a str>,
}

fn encode_directory(directory: &str) -> String {
    directory.bytes().fold(String::new(), |mut encoded, byte| {
        if byte.is_ascii_alphanumeric() || b"-_.!~*'()".contains(&byte) {
            encoded.push(byte as char);
        } else {
            write!(encoded, "%{byte:02X}").expect("writing to a string cannot fail");
        }
        encoded
    })
}

impl OpenCodeApi<'_> {
    fn get(&self, path: &str) -> Result<Value> {
        let mut url = format!("{}{path}", self.url.trim_end_matches('/'));
        if let Some(directory) = self.directory {
            write!(
                url,
                "{}directory={}",
                if path.contains('?') { '&' } else { '?' },
                encode_directory(directory)
            )
            .expect("writing to a string cannot fail");
        }
        let mut request = self.client.get(&url).header("Accept", "application/json");
        if let Some(authorization) = self.authorization {
            request = request.header("Authorization", authorization);
        }
        let mut response = request.call().with_context(|| format!("GET {url}"))?;
        let body = response
            .body_mut()
            .read_to_string()
            .with_context(|| format!("read GET {url}"))?;
        serde_json::from_str(&body).with_context(|| format!("parse GET {url}"))
    }

    fn latest_assistant(&self, session: &str) -> Result<Value> {
        let Value::Array(mut messages) =
            self.get(&format!("/session/{session}/message?limit=1"))?
        else {
            bail!("session messages are not an array");
        };
        let message = messages.pop().context("busy session has no messages")?;
        anyhow::ensure!(
            message.pointer("/info/role").and_then(Value::as_str) == Some("assistant"),
            "busy session's latest message is not from an assistant"
        );
        Ok(message)
    }
}

fn status_kind(status: &Value) -> &str {
    status
        .get("type")
        .and_then(Value::as_str)
        .unwrap_or("unknown")
}

fn active_part(part: &Value) -> bool {
    matches!(
        part.pointer("/state/status").and_then(Value::as_str),
        Some("pending" | "running")
    )
}

fn waiting_sessions(
    status: &serde_json::Map<String, Value>,
    questions: &[Value],
    permissions: &[Value],
    assistants: &serde_json::Map<String, Value>,
    excluded_sessions: &HashSet<String>,
) -> HashSet<String> {
    let mut waiting = excluded_sessions.clone();
    waiting.extend(
        [questions, permissions]
            .into_iter()
            .flatten()
            .filter_map(|request| request.get("sessionID").and_then(Value::as_str))
            .map(str::to_owned),
    );
    waiting.extend(
        assistants
            .iter()
            .filter(|(_, message)| {
                message
                    .get("parts")
                    .and_then(Value::as_array)
                    .is_some_and(|parts| {
                        parts.iter().any(|part| {
                            active_part(part)
                                && part.get("tool").and_then(Value::as_str) == Some("question")
                        })
                    })
            })
            .map(|(session, _)| session.clone()),
    );
    loop {
        let parents: Vec<_> = status
            .iter()
            .filter_map(|(parent, state)| {
                if waiting.contains(parent) || status_kind(state) != "busy" {
                    return None;
                }
                let parts = assistants.get(parent)?.get("parts")?.as_array()?;
                let mut running = parts.iter().filter(|part| active_part(part)).peekable();
                running.peek()?;
                running
                    .all(|part| {
                        part.get("type").and_then(Value::as_str) == Some("tool")
                            && part.get("tool").and_then(Value::as_str) == Some("task")
                            && part.get("sessionID").and_then(Value::as_str) == Some(parent)
                            && part.pointer("/state/metadata").is_some_and(|metadata| {
                                matches!(
                                    metadata.get("background"),
                                    None | Some(Value::Bool(false))
                                ) && metadata
                                    .get("sessionId")
                                    .and_then(Value::as_str)
                                    .is_some_and(|child| waiting.contains(child))
                            })
                    })
                    .then(|| parent.clone())
            })
            .collect();
        if parents.is_empty() {
            break;
        }
        waiting.extend(parents);
    }
    waiting
}

fn session_blockers(
    status: &serde_json::Map<String, Value>,
    questions: &[Value],
    permissions: &[Value],
    assistants: &serde_json::Map<String, Value>,
    excluded_sessions: &HashSet<String>,
) -> Vec<String> {
    let waiting = waiting_sessions(
        status,
        questions,
        permissions,
        assistants,
        excluded_sessions,
    );
    status
        .iter()
        .filter_map(|(session, value)| {
            let kind = status_kind(value);
            (kind != "idle" && !waiting.contains(session.as_str()))
                .then(|| format!("{session}:{kind}"))
        })
        .collect()
}

fn has_running_watchdog(message: &Value) -> bool {
    let mut active = message
        .get("parts")
        .and_then(Value::as_array)
        .into_iter()
        .flatten()
        .filter(|part| active_part(part))
        .peekable();
    active.peek().is_some()
        && active.all(|part| {
            part.get("type").and_then(Value::as_str) == Some("tool")
                && part.get("tool").and_then(Value::as_str) == Some("bash")
                && part
                    .pointer("/state/input/command")
                    .and_then(Value::as_str)
                    .and_then(|command| command.split_ascii_whitespace().next())
                    .and_then(|command| Path::new(command.trim_matches(['\'', '"'])).file_name())
                    .is_some_and(|command| command == NAME)
        })
}

struct ApiSnapshot {
    pid: i32,
    url: String,
    directory: String,
    state: Result<WorkspaceState>,
}

struct WorkspaceState {
    status: serde_json::Map<String, Value>,
    sessions: serde_json::Map<String, Value>,
    assistants: serde_json::Map<String, Value>,
    questions: Vec<Value>,
    permissions: Vec<Value>,
}

struct ApiScan {
    snapshots: Vec<ApiSnapshot>,
    failures: Vec<String>,
}

fn workspace_snapshot(
    client: &ureq::Agent,
    pid: i32,
    url: String,
    authorization: Option<String>,
    directory: String,
) -> ApiSnapshot {
    let api = OpenCodeApi {
        client,
        url: &url,
        authorization: authorization.as_deref(),
        directory: Some(&directory),
    };
    let state = (|| -> Result<WorkspaceState> {
        let Value::Object(status) = api.get("/session/status")? else {
            bail!("session status is not an object");
        };
        let Value::Array(session_details) = api.get("/session?limit=200")? else {
            bail!("sessions are not an array");
        };
        let sessions = session_details
            .into_iter()
            .map(|details| {
                let id = details
                    .get("id")
                    .and_then(Value::as_str)
                    .context("session has no string id")?
                    .to_owned();
                Ok((id, details))
            })
            .collect::<Result<_>>()?;
        let assistants = status
            .iter()
            .filter(|(_, state)| status_kind(state) == "busy")
            .map(|(session, _)| Ok((session.clone(), api.latest_assistant(session)?)))
            .collect::<Result<_>>()?;
        let Value::Array(questions) = api.get("/question")? else {
            bail!("questions are not an array");
        };
        let Value::Array(permissions) = api.get("/permission")? else {
            bail!("permissions are not an array");
        };
        Ok(WorkspaceState {
            status,
            sessions,
            assistants,
            questions,
            permissions,
        })
    })();
    ApiSnapshot {
        pid,
        url,
        directory,
        state,
    }
}

struct ApiServer {
    pid: i32,
    url: String,
    endpoint: String,
    authorization: Option<String>,
    directory: String,
}

fn api_snapshots(client: &ureq::Agent, processes: &[OpenCodeProcess]) -> ApiScan {
    let listeners = match tcp_listener_urls() {
        Ok(listeners) => listeners,
        Err(error) => {
            return ApiScan {
                snapshots: Vec::new(),
                failures: vec![format!("listener discovery: {error:#}")],
            };
        }
    };
    let mut snapshots = Vec::new();
    let mut failures = Vec::new();
    let mut servers = Vec::new();
    for process in processes {
        if !matches!(&process.kind, ProcessKind::Server) {
            continue;
        }
        let sockets = match process_sockets(process.pid) {
            Ok(sockets) => sockets,
            Err(error) => {
                failures.push(format!("pid={} socket discovery: {error:#}", process.pid));
                continue;
            }
        };
        let Some(url) = sockets
            .into_iter()
            .filter_map(|inode| listeners.get(&inode))
            .find(|url| {
                OpenCodeApi {
                    client,
                    url,
                    authorization: process.authorization.as_deref(),
                    directory: None,
                }
                .get("/global/health")
                .is_ok_and(|value| value.get("healthy").and_then(Value::as_bool) == Some(true))
            })
            .cloned()
        else {
            failures.push(format!("pid={} opencode-api:unreachable", process.pid));
            continue;
        };
        let api = OpenCodeApi {
            client,
            url: &url,
            authorization: process.authorization.as_deref(),
            directory: None,
        };
        let directory = match api.get("/path").and_then(|path| {
            path.get("directory")
                .and_then(Value::as_str)
                .map(str::to_owned)
                .context("OpenCode path has no directory")
        }) {
            Ok(directory) => directory,
            Err(error) => {
                failures.push(format!("pid={} opencode-path:{error:#}", process.pid));
                continue;
            }
        };
        let Some(endpoint) = endpoint_key(&url) else {
            failures.push(format!("pid={} opencode-api:invalid-endpoint", process.pid));
            continue;
        };
        servers.push(ApiServer {
            pid: process.pid,
            url,
            endpoint,
            authorization: process.authorization.clone(),
            directory,
        });
    }

    let mut attached = HashMap::<String, Vec<String>>::new();
    for process in processes {
        let ProcessKind::Attach {
            endpoint,
            directory,
        } = &process.kind
        else {
            continue;
        };
        let Some(directory) = directory.as_ref().and_then(|directory| directory.to_str()) else {
            failures.push(format!("pid={} attach-directory:unavailable", process.pid));
            continue;
        };
        let Some(key) = endpoint_key(endpoint) else {
            failures.push(format!("pid={} attach-endpoint:invalid", process.pid));
            continue;
        };
        if !servers.iter().any(|server| server.endpoint == key) {
            failures.push(format!("pid={} attach-endpoint:unreachable", process.pid));
            continue;
        }
        attached.entry(key).or_default().push(directory.to_owned());
    }

    let mut jobs = Vec::new();
    for server in servers {
        let mut directories = attached.remove(&server.endpoint).unwrap_or_default();
        directories.push(server.directory);
        directories.sort_unstable();
        directories.dedup();
        for directory in directories {
            jobs.push((
                server.pid,
                server.url.clone(),
                server.authorization.clone(),
                directory,
            ));
        }
    }
    snapshots.extend(thread::scope(|scope| {
        jobs.into_iter()
            .map(|(pid, url, authorization, directory)| {
                scope.spawn(move || workspace_snapshot(client, pid, url, authorization, directory))
            })
            .collect::<Vec<_>>()
            .into_iter()
            .map(|job| job.join().expect("workspace scanner panicked"))
            .collect::<Vec<_>>()
    }));
    ApiScan {
        snapshots,
        failures,
    }
}

struct ScanEvaluation {
    excluded_sessions: HashSet<String>,
    blockers: Vec<String>,
    active: usize,
}

fn evaluate(scan: &ApiScan, ignored_sessions: &[String]) -> ScanEvaluation {
    let mut excluded_sessions = ignored_sessions.iter().cloned().collect::<HashSet<_>>();
    excluded_sessions.extend(
        scan.snapshots
            .iter()
            .filter_map(|snapshot| snapshot.state.as_ref().ok())
            .flat_map(|state| {
                state
                    .status
                    .iter()
                    .filter(|(_, state)| status_kind(state) == "busy")
                    .filter(|(session, _)| {
                        state
                            .assistants
                            .get(*session)
                            .is_some_and(has_running_watchdog)
                    })
                    .map(|(session, _)| session.clone())
            }),
    );
    let mut blockers = scan.failures.clone();
    let mut active = 0;
    for snapshot in &scan.snapshots {
        let state = match &snapshot.state {
            Ok(state) => state,
            Err(error) => {
                blockers.push(format!(
                    "pid={} {} directory={} workspace-scan:{error:#}",
                    snapshot.pid, snapshot.url, snapshot.directory
                ));
                continue;
            }
        };
        let current = session_blockers(
            &state.status,
            &state.questions,
            &state.permissions,
            &state.assistants,
            &excluded_sessions,
        );
        active += current.len();
        if !current.is_empty() {
            blockers.push(format!(
                "pid={} {} directory={} {}",
                snapshot.pid,
                snapshot.url,
                snapshot.directory,
                current.into_iter().take(4).collect::<Vec<_>>().join(" ")
            ));
        }
    }
    ScanEvaluation {
        excluded_sessions,
        blockers,
        active,
    }
}

fn collect_scan(client: &ureq::Agent) -> Result<ApiScan> {
    Ok(api_snapshots(client, &opencode_processes()?))
}

fn summarize(items: &[String], limit: usize) -> String {
    let mut visible: Vec<_> = items.iter().take(limit).cloned().collect();
    if items.len() > limit {
        visible.push(format!("... +{} more", items.len() - limit));
    }
    visible.join(" | ")
}

fn elapsed(millis: u64) -> String {
    let seconds = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap_or_default()
        .as_millis()
        .saturating_sub(millis as u128)
        / 1000;
    match seconds {
        0..60 => format!("{seconds}s"),
        60..3600 => format!("{}m {:02}s", seconds / 60, seconds % 60),
        3600..86400 => format!("{}h {:02}m", seconds / 3600, seconds / 60 % 60),
        _ => format!("{}d {:02}h", seconds / 86400, seconds / 3600 % 24),
    }
}

fn clean_text(value: &str) -> String {
    value
        .chars()
        .filter(|character| !character.is_control())
        .collect()
}

struct Dashboard {
    termios: Option<libc::termios>,
    action: Option<String>,
    terminal_size: std::cell::Cell<(u16, u16)>,
}

impl Dashboard {
    fn terminal_size() -> (u16, u16) {
        let mut size = unsafe { std::mem::zeroed::<libc::winsize>() };
        if unsafe { libc::ioctl(libc::STDOUT_FILENO, libc::TIOCGWINSZ, &mut size) } == 0 {
            (if size.ws_col > 0 { size.ws_col } else { 80 }, size.ws_row)
        } else {
            (80, 0)
        }
    }

    fn new(command: &[OsString]) -> Self {
        let interactive = io::stdin().is_terminal() && io::stdout().is_terminal();
        let mut original = unsafe { std::mem::zeroed::<libc::termios>() };
        let termios =
            if interactive && unsafe { libc::tcgetattr(libc::STDIN_FILENO, &mut original) } == 0 {
                let mut cbreak = original;
                cbreak.c_lflag &= !(libc::ICANON | libc::ECHO);
                cbreak.c_cc[libc::VMIN] = 0;
                cbreak.c_cc[libc::VTIME] = 0;
                (unsafe { libc::tcsetattr(libc::STDIN_FILENO, libc::TCSANOW, &cbreak) } == 0)
                    .then_some(original)
            } else {
                None
            };
        if termios.is_some() {
            print!("\x1b[?1049h\x1b[?25l");
            let _ = io::stdout().flush();
        }
        let action = (!command.is_empty()).then(|| command_display(command));
        Self {
            termios,
            action,
            terminal_size: std::cell::Cell::new(Self::terminal_size()),
        }
    }

    fn loading(&self) {
        if self.termios.is_some() {
            print!(
                "\x1b[H\x1b[2J\x1b[1;36mOPENCODE IDLE WATCHDOG\x1b[0m\n\n\x1b[2mScanning sessions...\x1b[0m"
            );
            let _ = io::stdout().flush();
        }
    }

    fn wait(
        &self,
        cancellation: &Cancellation,
        duration: Duration,
        mut on_resize: impl FnMut(),
    ) -> Option<i32> {
        let started = Instant::now();
        loop {
            let mut byte = 0_u8;
            if self.termios.is_some()
                && unsafe {
                    libc::read(libc::STDIN_FILENO, std::ptr::from_mut(&mut byte).cast(), 1)
                } == 1
                // ponytail: Escape-prefixed keys also exit; parse sequences if navigation is added.
                && matches!(byte, b'q' | 0x1b)
            {
                return Some(0);
            }
            if self.termios.is_some() {
                let terminal_size = Self::terminal_size();
                if terminal_size != self.terminal_size.replace(terminal_size) {
                    on_resize();
                }
            }
            let remaining = duration.saturating_sub(started.elapsed());
            if let Some(signal) = cancellation.wait(remaining.min(Duration::from_millis(25))) {
                return Some(signal);
            }
            if started.elapsed() >= duration {
                return None;
            }
        }
    }

    fn run_work<T: Send + 'static>(
        &self,
        cancellation: &Cancellation,
        mut on_resize: impl FnMut(),
        work: impl FnOnce() -> T + Send + 'static,
    ) -> std::result::Result<T, i32> {
        let worker = thread::spawn(work);
        while !worker.is_finished() {
            if let Some(signal) = self.wait(cancellation, Duration::from_millis(25), &mut on_resize)
            {
                return Err(signal);
            }
        }
        Ok(worker.join().expect("scan worker panicked"))
    }

    fn status_line(
        evaluation: &ScanEvaluation,
        check: u32,
        idle: u32,
        required_idle: u32,
        next_scan: u64,
    ) -> String {
        let state = if evaluation.blockers.is_empty() {
            "IDLE"
        } else {
            "BLOCKED"
        };
        format!(
            "\x1b[2mcheck #{check}  |\x1b[0m  {state}  |  {} active  |  idle {idle}/{required_idle}  |  next scan in {next_scan}s",
            evaluation.active,
        )
    }

    fn tick(
        &self,
        evaluation: &ScanEvaluation,
        check: u32,
        idle: u32,
        required_idle: u32,
        next_scan: u64,
    ) {
        if self.termios.is_some() {
            print!(
                "\x1b[2;1H\x1b[2K{}",
                Self::status_line(evaluation, check, idle, required_idle, next_scan)
            );
            let _ = io::stdout().flush();
        }
    }

    fn draw(
        &self,
        scan: &ApiScan,
        evaluation: &ScanEvaluation,
        check: u32,
        idle: u32,
        required_idle: u32,
        next_scan: u64,
    ) {
        if self.termios.is_none() {
            return;
        }
        let mut rows = Vec::new();
        for snapshot in &scan.snapshots {
            let Ok(state) = &snapshot.state else {
                continue;
            };
            let waiting = waiting_sessions(
                &state.status,
                &state.questions,
                &state.permissions,
                &state.assistants,
                &evaluation.excluded_sessions,
            );
            for (session, status) in &state.status {
                let kind = status_kind(status);
                let (label, color) = if evaluation.excluded_sessions.contains(session) {
                    ("SELF", Color::Cyan)
                } else if waiting.contains(session) {
                    ("WAITING", Color::Blue)
                } else {
                    match kind {
                        "idle" => ("IDLE", Color::Green),
                        "busy" => ("RUNNING", Color::Yellow),
                        "retry" => ("RETRY", Color::Magenta),
                        _ => ("UNKNOWN", Color::Red),
                    }
                };
                let details = state.sessions.get(session);
                let age = details
                    .and_then(|value| value.pointer("/time/created"))
                    .and_then(Value::as_u64)
                    .map(elapsed)
                    .unwrap_or_else(|| "-".to_owned());
                let updated = details
                    .and_then(|value| value.pointer("/time/updated"))
                    .and_then(Value::as_u64)
                    .map(elapsed)
                    .unwrap_or_else(|| "-".to_owned());
                let title = details
                    .and_then(|value| value.get("title"))
                    .and_then(Value::as_str)
                    .unwrap_or("Untitled session");
                rows.push((
                    color,
                    [
                        label.to_owned(),
                        age,
                        updated,
                        clean_text(&snapshot.directory),
                        session.clone(),
                        clean_text(title),
                    ],
                ));
            }
        }
        rows.sort_unstable_by(|left, right| left.1.cmp(&right.1));
        let width = Self::terminal_size().0;
        let mut table = Table::new();
        table
            .load_style(UTF8_FULL.with_rounded_corners().with_solid_inner_borders())
            .set_content_arrangement(ContentArrangement::DynamicFullWidth)
            .set_width(width)
            .set_header(HEADERS);
        for column in [1, 2] {
            table
                .column_mut(column)
                .expect("age and updated columns exist")
                .set_cell_alignment(CellAlignment::Right);
        }
        if rows.is_empty() {
            let (label, color, message) = if evaluation.blockers.is_empty() {
                ("IDLE", Color::Green, "No active sessions".to_owned())
            } else {
                ("BLOCKED", Color::Red, summarize(&evaluation.blockers, 2))
            };
            table.add_row([
                Cell::new(label).fg(color),
                Cell::new(""),
                Cell::new(""),
                Cell::new(""),
                Cell::new(""),
                Cell::new(message),
            ]);
        }
        for (color, row) in rows {
            let [status, age, updated, workspace, session, title] = row;
            table.add_row([
                Cell::new(status).fg(color),
                Cell::new(age),
                Cell::new(updated),
                Cell::new(workspace),
                Cell::new(session),
                Cell::new(title),
            ]);
        }
        let mut frame = format!(
            "\x1b[1;36mOPENCODE IDLE WATCHDOG\x1b[0m\n{}\n",
            Self::status_line(evaluation, check, idle, required_idle, next_scan),
        );
        if let Some(action) = &self.action {
            writeln!(frame, "\x1b[2mon idle       |\x1b[0m  {action}")
                .expect("writing to a string cannot fail");
        }
        write!(frame, "\n{table}").expect("writing to a string cannot fail");
        if !evaluation.blockers.is_empty() {
            frame.push_str("\n\n\x1b[31mAPI errors\x1b[0m");
            for failure in &evaluation.blockers {
                frame.push_str("\n  ");
                frame.push_str(&clean_text(failure));
            }
        }
        frame.push_str("\n\n\x1b[2mq / Esc / Ctrl-C to exit\x1b[0m\n");
        let mut redraw = String::from("\x1b[H");
        for line in frame.lines() {
            writeln!(redraw, "\x1b[2K\r{line}").expect("writing to a string cannot fail");
        }
        redraw.push_str("\x1b[J");
        print!("{redraw}");
        let _ = io::stdout().flush();
    }
}

impl Drop for Dashboard {
    fn drop(&mut self) {
        if let Some(original) = &self.termios {
            unsafe {
                libc::tcsetattr(libc::STDIN_FILENO, libc::TCSANOW, original);
            }
        }
        if self.termios.is_some() {
            print!("\x1b[?25h\x1b[?1049l");
            let _ = io::stdout().flush();
        }
    }
}

fn signal_exit(state: &State, signal: i32) -> i32 {
    if signal == 0 {
        state.log("watchdog exited");
        return 0;
    }
    state.log(if signal == SIGINT {
        "watchdog interrupted"
    } else {
        "watchdog terminated"
    });
    128 + signal
}

fn wait_until_idle(state: &State, options: &Options, command: &[OsString]) -> Result<i32> {
    let client = ureq::Agent::new_with_config(
        ureq::Agent::config_builder()
            .timeout_global(Some(Duration::from_secs(2)))
            .build(),
    );
    let cancellation = Cancellation::new()?;
    let dashboard = Dashboard::new(command);
    let scan_work = || {
        let client = client.clone();
        move || collect_scan(&client)
    };
    dashboard.loading();
    let mut scan = match dashboard.run_work(&cancellation, || dashboard.loading(), scan_work()) {
        Ok(result) => result?,
        Err(signal) => {
            drop(dashboard);
            return Ok(signal_exit(state, signal));
        }
    };
    let mut evaluation = evaluate(&scan, &options.ignored_sessions);
    let mut excluded_sessions: Vec<_> = evaluation.excluded_sessions.iter().cloned().collect();
    excluded_sessions.sort_unstable();
    let started = format!(
        "watchdog started; excluded_sessions={}; interval={}s required_idle_checks={}; command={}; cache={}",
        if excluded_sessions.is_empty() {
            "none".to_owned()
        } else {
            excluded_sessions.join(",")
        },
        options.interval,
        options.required_idle_checks,
        if command.is_empty() {
            "none".to_owned()
        } else {
            command_display(command)
        },
        state.root.display()
    );
    let report = |message| {
        if dashboard.termios.is_some() {
            state.record(message);
        } else {
            state.log(message);
        }
    };
    report(started);

    let mut consecutive_idle = 0;
    let mut check = 0;
    let signal = 'checks: loop {
        check += 1;
        consecutive_idle = if evaluation.blockers.is_empty() {
            consecutive_idle + 1
        } else {
            0
        };
        let check_message = format!(
            "check {check}: idle={consecutive_idle}/{}; blockers={}",
            options.required_idle_checks,
            if evaluation.blockers.is_empty() {
                "none"
            } else {
                "opencode API session status"
            }
        );
        report(check_message);
        if !evaluation.blockers.is_empty() {
            report(format!(
                "opencode_api_blockers: {}",
                summarize(&evaluation.blockers, 5)
            ));
        }
        let draw = |next_scan| {
            dashboard.draw(
                &scan,
                &evaluation,
                check,
                consecutive_idle,
                options.required_idle_checks,
                next_scan,
            );
        };
        draw(options.interval);
        if let Some(signal) =
            dashboard.wait(&cancellation, Duration::ZERO, || draw(options.interval))
        {
            break Some(signal);
        }
        if consecutive_idle >= options.required_idle_checks {
            if command.is_empty() {
                break None;
            }
            let final_scan =
                match dashboard.run_work(&cancellation, || draw(options.interval), scan_work()) {
                    Ok(result) => result?,
                    Err(signal) => break Some(signal),
                };
            let final_evaluation = evaluate(&final_scan, &options.ignored_sessions);
            if final_evaluation.blockers.is_empty() {
                break None;
            }
            scan = final_scan;
            evaluation = final_evaluation;
            consecutive_idle = 0;
            continue;
        }
        let mut remaining = options.interval;
        while remaining > 0 {
            if let Some(signal) =
                dashboard.wait(&cancellation, Duration::from_secs(1), || draw(remaining))
            {
                break 'checks Some(signal);
            }
            remaining -= 1;
            dashboard.tick(
                &evaluation,
                check,
                consecutive_idle,
                options.required_idle_checks,
                remaining,
            );
        }
        match dashboard.run_work(&cancellation, || draw(0), scan_work()) {
            Ok(result) => {
                scan = result?;
                evaluation = evaluate(&scan, &options.ignored_sessions);
            }
            Err(signal) => break Some(signal),
        }
    };

    drop(dashboard);
    if let Some(signal) = signal {
        return Ok(signal_exit(state, signal));
    }
    state.log("idle confirmed");
    if command.is_empty() {
        Ok(0)
    } else {
        Ok(run_command(state, &cancellation, command))
    }
}

fn terminate_child(child: &mut Child) {
    let _ = child.kill();
    let _ = child.wait();
}

fn command_display(command: &[OsString]) -> String {
    command
        .iter()
        .map(|arg| format!("{arg:?}"))
        .collect::<Vec<_>>()
        .join(" ")
}

fn resolve_command(command: &[OsString]) -> Vec<OsString> {
    if let [shortcut] = command {
        let action = match shortcut.to_str() {
            Some("sleep" | "suspend") => Some("suspend"),
            Some("poweroff") => Some("poweroff"),
            Some("hibernate") => Some("hibernate"),
            _ => None,
        };
        if let Some(action) = action {
            return ["/usr/bin/systemctl", action].map(OsString::from).into();
        }
    }
    command.to_vec()
}

fn run_command(state: &State, cancellation: &Cancellation, command: &[OsString]) -> i32 {
    state.log(format!("running command: {}", command_display(command)));
    let Some((program, arguments)) = command.split_first() else {
        state.log("could not run command: empty command");
        return 127;
    };
    let mut child = match Command::new(program).args(arguments).spawn() {
        Ok(child) => child,
        Err(error) => {
            state.log(format!("could not run command: {error}"));
            return 127;
        }
    };

    loop {
        match child.try_wait() {
            Ok(Some(status)) => {
                let code = status
                    .code()
                    .or_else(|| status.signal().map(|signal| 128 + signal))
                    .unwrap_or(1);
                state.log(format!("command exited with status {code}"));
                return code;
            }
            Ok(None) => {}
            Err(error) => {
                terminate_child(&mut child);
                state.log(format!("could not wait for command: {error}"));
                return 1;
            }
        }
        if let Some(signal) = cancellation.wait(Duration::from_millis(50)) {
            terminate_child(&mut child);
            return signal_exit(state, signal);
        }
    }
}

fn execute() -> Result<i32> {
    let options = Options::parse();
    let state = State::discover()?;
    let command = resolve_command(&options.command);
    wait_until_idle(&state, &options, &command)
}

fn main() {
    let code = match execute() {
        Ok(code) => code,
        Err(error) => {
            if let Ok(state) = State::discover() {
                state.log(format!("watchdog crashed: {error:#}"));
            }
            eprintln!("{NAME}: {error:#}");
            1
        }
    };
    std::process::exit(code);
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn classifies_opencode_processes_by_subcommand() {
        let args = |subcommand: &str| vec!["opencode".to_owned(), subcommand.to_owned()];
        assert!(matches!(
            process_kind(
                &["opencode", "attach", "http://127.0.0.1:1234"]
                    .into_iter()
                    .map(str::to_owned)
                    .collect::<Vec<_>>(),
                None
            ),
            Ok(ProcessKind::Attach { .. })
        ));
        assert!(matches!(
            process_kind(&args("serve"), None),
            Ok(ProcessKind::Server)
        ));
        assert!(matches!(
            process_kind(&args("run"), None),
            Ok(ProcessKind::Server)
        ));
    }

    #[test]
    fn parses_proc_listener_addresses() {
        assert_eq!(listener_host("0100007F").unwrap(), "127.0.0.1");
        assert_eq!(listener_host("00000000").unwrap(), "127.0.0.1");
        assert_eq!(
            listener_host("00000000000000000000000001000000").unwrap(),
            "[::1]"
        );
        assert_eq!(
            listener_host("00000000000000000000000000000000").unwrap(),
            "[::1]"
        );
        assert!(listener_host("not-an-address").is_err());
        assert_eq!(encode_directory("/tmp/a b%"), "%2Ftmp%2Fa%20b%25");
        assert_eq!(
            endpoint_key("http://127.0.0.1:1234/").as_deref(),
            Some("127.0.0.1:1234")
        );
        assert_eq!(
            endpoint_key("http://localhost:1234").as_deref(),
            Some("127.0.0.1:1234")
        );
        assert_eq!(
            endpoint_key("http://[::1]:1234").as_deref(),
            Some("::1:1234")
        );
    }

    #[test]
    fn classifies_user_waits_and_foreground_task_chains() {
        let fixture: Value = serde_json::from_str(r#"{
          "status":{"background":{"type":"busy"},"busy":{"type":"busy"},"idle":{"type":"idle"},"leaf":{"type":"busy"},"malformed":"oops","malformed_task":{"type":"busy"},"middle":{"type":"busy"},"mixed":{"type":"busy"},"other":{"type":"busy"},"partial":{"type":"busy"},"permission":{"type":"busy"},"root":{"type":"busy"}},
          "questions":[{"sessionID":"leaf"}],"permissions":[{"sessionID":"permission"}],
          "assistants":{
            "background":{
              "info":{"role":"assistant"},
              "parts":[{"type":"tool","tool":"task","sessionID":"background","state":{"status":"running","metadata":{"sessionId":"leaf","background":true}}}]
            },
            "malformed_task":{
              "info":{"role":"assistant"},
              "parts":[{"type":"tool","tool":"task","sessionID":"malformed_task","state":{"status":"running","metadata":{"sessionId":"leaf","background":"false"}}}]
            },
            "middle":
              {"info":{"role":"assistant"},"parts":[{"type":"tool","tool":"task","sessionID":"middle","state":{"status":"running","metadata":{"sessionId":"leaf"}}}]}
            ,
            "mixed":{
              "info":{"role":"assistant"},
              "parts":[
                {"type":"tool","tool":"task","sessionID":"mixed","state":{"status":"running","metadata":{"sessionId":"leaf"}}},
                {"type":"tool","tool":"bash","state":{"status":"running"}}
              ]
            },
            "partial":{
              "info":{"role":"assistant"},
              "parts":[
                {"type":"tool","tool":"task","sessionID":"partial","state":{"status":"running","metadata":{"sessionId":"leaf"}}},
                {"type":"tool","tool":"task","sessionID":"partial","state":{"status":"running","metadata":{"sessionId":"other"}}}
              ]
            },
            "root":{
              "info":{"role":"assistant"},
              "parts":[{"type":"tool","tool":"task","sessionID":"root","state":{"status":"running","metadata":{"sessionId":"middle","background":false}}}]
            }
          }
        }"#).unwrap();
        assert_eq!(
            session_blockers(
                fixture["status"].as_object().unwrap(),
                fixture["questions"].as_array().unwrap(),
                fixture["permissions"].as_array().unwrap(),
                fixture["assistants"].as_object().unwrap(),
                &HashSet::new(),
            ),
            [
                "background:busy",
                "busy:busy",
                "malformed:unknown",
                "malformed_task:busy",
                "mixed:busy",
                "other:busy",
                "partial:busy",
            ]
        );
    }

    #[test]
    fn excludes_sessions_running_the_watchdog() {
        let mut message: Value = serde_json::from_str(
            r#"{
          "parts":[{
            "type":"tool",
            "tool":"bash",
            "state":{
              "status":"running",
              "input":{"command":"/home/me/.local/bin/opencode-idle-watchdog poweroff"}
            }
          }]
        }"#,
        )
        .unwrap();
        assert!(has_running_watchdog(&message));
        message["parts"]
            .as_array_mut()
            .unwrap()
            .push(serde_json::json!({
                "type": "tool",
                "tool": "bash",
                "state": { "status": "running", "input": { "command": "sleep 30" } }
            }));
        assert!(!has_running_watchdog(&message));

        let mut excluded = HashSet::new();
        excluded.insert("self".to_owned());
        let status: serde_json::Map<String, Value> =
            serde_json::from_str(r#"{"other":{"type":"busy"},"self":{"type":"busy"}}"#).unwrap();
        assert_eq!(
            session_blockers(&status, &[], &[], &serde_json::Map::new(), &excluded),
            ["other:busy"]
        );
    }

    #[test]
    fn incomplete_workspace_scan_blocks_idle() {
        let scan = ApiScan {
            snapshots: vec![ApiSnapshot {
                pid: 42,
                url: "http://127.0.0.1:1234".to_owned(),
                directory: "/tmp/project".to_owned(),
                state: Err(anyhow::anyhow!("bad response")),
            }],
            failures: Vec::new(),
        };
        assert_eq!(
            evaluate(&scan, &[]).blockers,
            ["pid=42 http://127.0.0.1:1234 directory=/tmp/project workspace-scan:bad response"]
        );
    }

    #[test]
    fn trailing_command_owns_its_flags() {
        let options = Options::try_parse_from([NAME, "notify-send", "--urgency", "low"]).unwrap();
        assert_eq!(options.command, ["notify-send", "--urgency", "low"]);
    }

    #[test]
    fn parses_short_control_flags() {
        let options = Options::try_parse_from([NAME, "-i", "5", "-r", "2"]).unwrap();
        assert_eq!(options.interval, 5);
        assert_eq!(options.required_idle_checks, 2);
    }

    #[test]
    fn parses_ignored_sessions() {
        let options = Options::try_parse_from([
            NAME,
            "--ignore-session",
            "ses_old",
            "--ignore-session",
            "ses_other",
        ])
        .unwrap();
        assert_eq!(options.ignored_sessions, ["ses_old", "ses_other"]);
    }

    #[test]
    fn resolves_shortcuts_and_preserves_direct_commands() {
        for (shortcut, action) in [
            ("sleep", "suspend"),
            ("suspend", "suspend"),
            ("poweroff", "poweroff"),
            ("hibernate", "hibernate"),
        ] {
            assert_eq!(
                resolve_command(&[shortcut.into()]),
                ["/usr/bin/systemctl", action]
            );
        }
        let direct = ["sleep", "30"].map(OsString::from);
        assert_eq!(resolve_command(&direct), direct);
        let direct = ["poweroff", "--force"].map(OsString::from);
        assert_eq!(resolve_command(&direct), direct);
    }

    #[test]
    fn command_display_shows_resolved_action() {
        let command = resolve_command(&["sleep".into()]);
        assert_eq!(
            command_display(&command),
            "\"/usr/bin/systemctl\" \"suspend\""
        );
    }

    #[test]
    fn rejects_zero_controls() {
        assert!(Options::try_parse_from([NAME, "--interval", "0"]).is_err());
        assert!(Options::try_parse_from([NAME, "--required-idle-checks", "0"]).is_err());
    }

    #[test]
    fn summarizes_overflow() {
        let details = vec!["one".into(), "two".into(), "three".into()];
        assert_eq!(summarize(&details, 2), "one | two | ... +1 more");
    }

    #[test]
    fn cleans_terminal_text() {
        assert_eq!(clean_text("hello\nworld"), "helloworld");
    }
}
