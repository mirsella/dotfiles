//! Run a command after every other opencode session has gone idle.

use std::collections::{HashMap, HashSet};
use std::env;
use std::ffi::OsString;
use std::fs::{self, File, OpenOptions};
use std::io::{self, IsTerminal, Write};
use std::os::unix::fs::MetadataExt;
use std::os::unix::process::{CommandExt, ExitStatusExt};
use std::path::{Path, PathBuf};
use std::process::{Child, Command, Stdio};
use std::sync::mpsc::{self, Receiver};
use std::thread::{self, JoinHandle};
use std::time::{Duration, SystemTime, UNIX_EPOCH};

use anyhow::{Context, Result};
use base64::Engine;
use clap::Parser;
use fs2::FileExt;
use jiff::Zoned;
use serde_json::Value;
use signal_hook::{
    consts::{SIGINT, SIGTERM},
    iterator::{Handle as SignalHandle, Signals},
};

const NAME: &str = "opencode-idle-watchdog";
const DEFAULT_INTERVAL: u64 = 180;
const DEFAULT_IDLE_CHECKS: u32 = 3;

#[derive(Parser)]
#[command(
    about = "Wait until all other opencode sessions go idle, then optionally run a command.",
    trailing_var_arg = true,
    args_override_self = true
)]
struct Options {
    #[arg(long, conflicts_with_all = ["status", "stop"], requires = "command")]
    detach: bool,

    #[arg(long, conflicts_with_all = ["detach", "stop"])]
    status: bool,

    #[arg(long, conflicts_with_all = ["detach", "status"])]
    stop: bool,

    #[arg(long, default_value_t = DEFAULT_INTERVAL, value_parser = positive_u64)]
    interval: u64,

    #[arg(long, default_value_t = DEFAULT_IDLE_CHECKS, value_parser = positive_u32)]
    required_idle_checks: u32,

    #[arg(
        value_name = "COMMAND",
        num_args = 0..,
        conflicts_with_all = ["status", "stop"]
    )]
    command: Vec<OsString>,
}

struct State {
    root: PathBuf,
    lock_file: PathBuf,
    pid_file: PathBuf,
    log_file: PathBuf,
}

impl State {
    fn discover() -> Result<Self> {
        let home = env::var_os("HOME").context("HOME is not set")?;
        let cache = env::var_os("XDG_CACHE_HOME")
            .map(PathBuf::from)
            .unwrap_or_else(|| PathBuf::from(home).join(".cache"));
        let root = cache.join(NAME);
        Ok(Self {
            lock_file: root.join("watchdog.lock"),
            pid_file: root.join("watchdog.pid"),
            log_file: root.join("watchdog.log"),
            root,
        })
    }

    fn log(&self, message: impl AsRef<str>) {
        let line = format!(
            "[{}] {}",
            Zoned::now().strftime("%Y-%m-%d %H:%M:%S"),
            message.as_ref()
        );
        println!("{line}");
        let _ = io::stdout().flush();
        self.write_log(&line);
    }

    fn record(&self, message: impl AsRef<str>) {
        let line = format!(
            "[{}] {}",
            Zoned::now().strftime("%Y-%m-%d %H:%M:%S"),
            message.as_ref()
        );
        self.write_log(&line);
    }

    fn write_log(&self, line: &str) {
        if fs::create_dir_all(&self.root).is_ok()
            && let Ok(mut file) = OpenOptions::new()
                .create(true)
                .append(true)
                .open(&self.log_file)
        {
            let _ = writeln!(file, "{line}");
        }
    }

    fn read_pid(&self) -> Option<i32> {
        fs::read_to_string(&self.pid_file)
            .ok()?
            .trim()
            .parse::<i32>()
            .ok()
            .filter(|pid| *pid > 0)
    }
}

struct Instance<'a> {
    state: &'a State,
    pid: i32,
    _lock: File,
}

impl<'a> Instance<'a> {
    fn acquire(state: &'a State) -> Result<Option<Self>> {
        fs::create_dir_all(&state.root)
            .with_context(|| format!("create {}", state.root.display()))?;
        let lock = OpenOptions::new()
            .create(true)
            .write(true)
            .truncate(false)
            .open(&state.lock_file)
            .with_context(|| format!("open {}", state.lock_file.display()))?;
        if let Err(error) = lock.try_lock_exclusive() {
            if error.kind() == io::ErrorKind::WouldBlock {
                state.log(format!(
                    "another watchdog already holds {}; exiting",
                    state.lock_file.display()
                ));
                return Ok(None);
            }
            return Err(error).context("lock watchdog instance");
        }

        let pid = std::process::id() as i32;
        fs::write(&state.pid_file, pid.to_string())
            .with_context(|| format!("write {}", state.pid_file.display()))?;
        Ok(Some(Self {
            state,
            pid,
            _lock: lock,
        }))
    }
}

impl Drop for Instance<'_> {
    fn drop(&mut self) {
        if self.state.read_pid() == Some(self.pid) {
            let _ = fs::remove_file(&self.state.pid_file);
        }
    }
}

struct Cancellation {
    receiver: Receiver<i32>,
    handle: SignalHandle,
    worker: Option<JoinHandle<()>>,
}

impl Cancellation {
    fn new() -> Result<Self> {
        let mut signals = Signals::new([SIGINT, SIGTERM]).context("install signal handlers")?;
        let handle = signals.handle();
        let (sender, receiver) = mpsc::channel();
        let worker = thread::spawn(move || {
            for signal in signals.forever() {
                if sender.send(signal).is_err() {
                    break;
                }
            }
        });
        Ok(Self {
            receiver,
            handle,
            worker: Some(worker),
        })
    }

    fn wait(&self, duration: Duration) -> Option<i32> {
        self.receiver.recv_timeout(duration).ok()
    }
}

impl Drop for Cancellation {
    fn drop(&mut self) {
        self.handle.close();
        if let Some(worker) = self.worker.take() {
            let _ = worker.join();
        }
    }
}

struct OpenCodeProcess {
    pid: i32,
    role: ProcessRole,
    directory: Option<String>,
    authorization: Option<String>,
}

#[derive(Clone, Copy, PartialEq, Eq)]
enum ProcessRole {
    SharedServer,
    RemoteClient,
    Standalone,
}

struct Exclusion {
    pid: Option<i32>,
    sessions: HashSet<String>,
}

impl Exclusion {
    fn detect() -> Self {
        let pid = nonempty_env("WATCHDOG_EXCLUDE_OPENCODE_PID")
            .and_then(|value| value.parse::<i32>().ok())
            .filter(|pid| *pid > 0)
            .or_else(|| ancestor_named(std::process::id() as i32, "opencode"));
        let sessions = nonempty_env("WATCHDOG_EXCLUDE_OPENCODE_SESSIONS")
            .map(|value| {
                value
                    .split(',')
                    .map(str::trim)
                    .filter(|session| !session.is_empty())
                    .map(str::to_owned)
                    .collect()
            })
            .unwrap_or_default();
        Self { pid, sessions }
    }

    fn includes_process(&self, process: &OpenCodeProcess) -> bool {
        process.role != ProcessRole::SharedServer && Some(process.pid) == self.pid
    }
}

fn positive_u64(value: &str) -> std::result::Result<u64, String> {
    match value.parse::<u64>() {
        Ok(0) => Err("must be at least 1".to_owned()),
        Ok(value) => Ok(value),
        Err(_) => Err("must be a positive integer".to_owned()),
    }
}

fn positive_u32(value: &str) -> std::result::Result<u32, String> {
    match value.parse::<u32>() {
        Ok(0) => Err("must be at least 1".to_owned()),
        Ok(value) => Ok(value),
        Err(_) => Err("must be a positive integer".to_owned()),
    }
}

fn nonempty_env(name: &str) -> Option<String> {
    env::var(name).ok().filter(|value| !value.trim().is_empty())
}

fn lossy_read(path: impl AsRef<Path>) -> String {
    String::from_utf8_lossy(&fs::read(path).unwrap_or_default()).into_owned()
}

fn nul_strings(path: &str) -> Vec<String> {
    fs::read(path)
        .unwrap_or_default()
        .split(|byte| *byte == 0)
        .filter(|value| !value.is_empty())
        .map(|value| String::from_utf8_lossy(value).into_owned())
        .collect()
}

fn env_value(environment: &[u8], name: &[u8]) -> Option<String> {
    environment
        .split(|byte| *byte == 0)
        .find_map(|entry| entry.strip_prefix(name)?.strip_prefix(b"="))
        .map(|value| String::from_utf8_lossy(value).into_owned())
}

fn server_env_value(name: &str) -> Option<String> {
    if let Some(value) = nonempty_env(name) {
        return Some(value);
    }
    let home = env::var_os("HOME")?;
    let config = env::var_os("XDG_CONFIG_HOME")
        .map(PathBuf::from)
        .unwrap_or_else(|| PathBuf::from(home).join(".config"));
    lossy_read(config.join("opencode/server.env"))
        .lines()
        .filter_map(|line| line.trim().split_once('='))
        .find(|(key, _)| *key == name)
        .map(|(_, value)| value.trim().trim_matches(['\'', '"']).to_owned())
        .filter(|value| !value.is_empty())
}

fn basic_authorization(username: String, password: String) -> String {
    let encoded =
        base64::engine::general_purpose::STANDARD.encode(format!("{username}:{password}"));
    format!("Basic {encoded}")
}

fn process_identity(pid: i32) -> Option<(String, i32)> {
    parse_stat(&lossy_read(format!("/proc/{pid}/stat")))
}

fn parse_stat(stat: &str) -> Option<(String, i32)> {
    let open = stat.find('(')?;
    let close = stat.rfind(')')?;
    let mut fields = stat.get(close + 1..)?.split_whitespace();
    fields.next()?;
    let parent = fields.next()?.parse().ok()?;
    Some((stat.get(open + 1..close)?.to_owned(), parent))
}

fn ancestor_named(start: i32, expected: &str) -> Option<i32> {
    let mut pid = start;
    let mut visited = HashSet::new();
    while pid > 1 && visited.insert(pid) {
        let (name, parent) = process_identity(pid)?;
        if name == expected {
            return Some(pid);
        }
        pid = parent;
    }
    None
}

fn opencode_processes() -> Result<Vec<OpenCodeProcess>> {
    let uid = unsafe { libc::getuid() };
    let configured_username =
        server_env_value("OPENCODE_SERVER_USERNAME").unwrap_or_else(|| "opencode".to_owned());
    let configured_password = server_env_value("OPENCODE_SERVER_PASSWORD");
    let mut processes = Vec::new();
    for entry in fs::read_dir("/proc").context("read /proc")?.flatten() {
        let Some(pid) = entry
            .file_name()
            .to_str()
            .and_then(|name| name.parse::<i32>().ok())
        else {
            continue;
        };
        if entry.metadata().ok().map(|metadata| metadata.uid()) != Some(uid)
            || !process_identity(pid).is_some_and(|(name, _)| name == "opencode")
        {
            continue;
        }
        let environment = fs::read(format!("/proc/{pid}/environ")).unwrap_or_default();
        let args = nul_strings(&format!("/proc/{pid}/cmdline"));
        let password = env_value(&environment, b"OPENCODE_SERVER_PASSWORD")
            .or_else(|| configured_password.clone());
        let username = env_value(&environment, b"OPENCODE_SERVER_USERNAME")
            .unwrap_or_else(|| configured_username.clone());
        let authorization = password.map(|password| basic_authorization(username, password));
        let role = if args.get(1).is_some_and(|arg| arg == "attach")
            || args
                .iter()
                .any(|arg| arg == "--attach" || arg.starts_with("--attach="))
        {
            ProcessRole::RemoteClient
        } else if args.iter().any(|arg| arg == "serve") {
            ProcessRole::SharedServer
        } else {
            ProcessRole::Standalone
        };
        processes.push(OpenCodeProcess {
            pid,
            role,
            directory: fs::read_link(format!("/proc/{pid}/cwd"))
                .ok()
                .map(|path| path.to_string_lossy().into_owned()),
            authorization,
        });
    }
    processes.sort_by_key(|process| process.pid);
    Ok(processes)
}

fn listener_host(address: &str) -> Option<String> {
    match address.len() {
        8 => {
            let address = u32::from_str_radix(address, 16).ok()?;
            let address = std::net::Ipv4Addr::from(address.to_le_bytes());
            Some(
                (if address.is_unspecified() {
                    std::net::Ipv4Addr::LOCALHOST
                } else {
                    address
                })
                .to_string(),
            )
        }
        32 => {
            let mut octets = [0; 16];
            for (word, output) in address
                .as_bytes()
                .as_chunks::<8>()
                .0
                .iter()
                .zip(octets.chunks_mut(4))
            {
                let word = std::str::from_utf8(word).ok()?;
                output.copy_from_slice(&u32::from_str_radix(word, 16).ok()?.to_le_bytes());
            }
            let address = std::net::Ipv6Addr::from(octets);
            Some(format!(
                "[{}]",
                if address.is_unspecified() {
                    std::net::Ipv6Addr::LOCALHOST
                } else {
                    address
                }
            ))
        }
        _ => None,
    }
}

fn tcp_listener_urls() -> HashMap<String, String> {
    let mut listeners = HashMap::new();
    for path in ["/proc/net/tcp", "/proc/net/tcp6"] {
        for line in lossy_read(path).lines().skip(1) {
            let fields: Vec<_> = line.split_whitespace().collect();
            if fields.len() < 10 || fields[3] != "0A" {
                continue;
            }
            let Some((address, port)) = fields[1].split_once(':') else {
                continue;
            };
            let Some(host) = listener_host(address) else {
                continue;
            };
            let Some(port) = u16::from_str_radix(port, 16).ok() else {
                continue;
            };
            listeners.insert(fields[9].to_owned(), format!("http://{host}:{port}"));
        }
    }
    listeners
}

fn process_sockets(pid: i32) -> Vec<String> {
    let Ok(entries) = fs::read_dir(format!("/proc/{pid}/fd")) else {
        return Vec::new();
    };
    entries
        .flatten()
        .filter_map(|entry| fs::read_link(entry.path()).ok())
        .filter_map(|target| {
            let target = target.to_string_lossy();
            target
                .strip_prefix("socket:[")?
                .strip_suffix(']')
                .map(str::to_owned)
        })
        .collect()
}

fn http_client() -> ureq::Agent {
    let config = ureq::Agent::config_builder()
        .timeout_global(Some(Duration::from_secs(2)))
        .build();
    ureq::Agent::new_with_config(config)
}

fn request_json(
    client: &ureq::Agent,
    base_url: &str,
    authorization: Option<&str>,
    directory: Option<&str>,
    path: &str,
) -> Option<Value> {
    let mut request = client
        .get(format!("{}{path}", base_url.trim_end_matches('/')))
        .header("Accept", "application/json");
    if let Some(authorization) = authorization {
        request = request.header("Authorization", authorization);
    }
    if let Some(directory) = directory {
        request = request.header("x-opencode-directory", directory);
    }
    let mut response = request.call().ok()?;
    let body = response.body_mut().read_to_string().ok()?;
    serde_json::from_str(&body).ok()
}

fn waiting_sessions(
    status: &serde_json::Map<String, Value>,
    questions: Option<&Value>,
    permissions: Option<&Value>,
    messages: &serde_json::Map<String, Value>,
    excluded_sessions: &HashSet<String>,
) -> HashSet<String> {
    let mut waiting = excluded_sessions.clone();
    waiting.extend(
        [questions, permissions]
            .into_iter()
            .flatten()
            .filter_map(Value::as_array)
            .flatten()
            .filter_map(|request| request.get("sessionID").and_then(Value::as_str))
            .map(str::to_owned),
    );
    loop {
        let parents: Vec<_> = status
            .iter()
            .filter_map(|(parent, state)| {
                if waiting.contains(parent)
                    || state.get("type").and_then(Value::as_str) != Some("busy")
                {
                    return None;
                }
                let parts = messages
                    .get(parent)?
                    .as_array()?
                    .iter()
                    .rev()
                    .find(|message| {
                        message.pointer("/info/role").and_then(Value::as_str) == Some("assistant")
                    })?
                    .get("parts")?
                    .as_array()?;
                let mut running = parts
                    .iter()
                    .filter(|part| {
                        part.pointer("/state/status").and_then(Value::as_str) == Some("running")
                    })
                    .peekable();
                running.peek()?;
                running
                    .all(|part| {
                        part.get("type").and_then(Value::as_str) == Some("tool")
                            && part.get("tool").and_then(Value::as_str) == Some("task")
                            && part.get("sessionID").and_then(Value::as_str) == Some(parent)
                            && part.pointer("/state/metadata").is_some_and(|metadata| {
                                matches!(
                                    metadata.get("background"),
                                    None | Some(Value::Bool(false))
                                ) && metadata
                                    .get("sessionId")
                                    .and_then(Value::as_str)
                                    .is_some_and(|child| waiting.contains(child))
                            })
                    })
                    .then(|| parent.clone())
            })
            .collect();
        if parents.is_empty() {
            break;
        }
        waiting.extend(parents);
    }
    waiting
}

fn session_blockers(
    status: &serde_json::Map<String, Value>,
    questions: Option<&Value>,
    permissions: Option<&Value>,
    messages: &serde_json::Map<String, Value>,
    excluded_sessions: &HashSet<String>,
) -> Vec<String> {
    let waiting = waiting_sessions(status, questions, permissions, messages, excluded_sessions);
    status
        .iter()
        .filter_map(|(session, value)| {
            let kind = value.get("type").and_then(Value::as_str);
            (kind != Some("idle") && !waiting.contains(session.as_str()))
                .then(|| format!("{session}:{}", kind.unwrap_or("unknown")))
        })
        .collect()
}

fn has_running_watchdog(messages: &Value) -> bool {
    messages
        .as_array()
        .into_iter()
        .flatten()
        .filter_map(|message| message.get("parts").and_then(Value::as_array))
        .flatten()
        .any(|part| {
            part.get("type").and_then(Value::as_str) == Some("tool")
                && part.get("tool").and_then(Value::as_str) == Some("bash")
                && part.pointer("/state/status").and_then(Value::as_str) == Some("running")
                && part
                    .pointer("/state/input/command")
                    .and_then(Value::as_str)
                    .is_some_and(|command| command.contains(NAME))
        })
}

struct ApiSnapshot {
    pid: i32,
    url: String,
    directory: String,
    state: WorkspaceState,
}

enum WorkspaceState {
    Invalid,
    Available {
        status: serde_json::Map<String, Value>,
        sessions: serde_json::Map<String, Value>,
        messages: serde_json::Map<String, Value>,
        questions: Option<Value>,
        permissions: Option<Value>,
    },
}

struct ApiScan {
    snapshots: Vec<ApiSnapshot>,
    failures: Vec<String>,
}

fn api_snapshots(
    client: &ureq::Agent,
    processes: &[OpenCodeProcess],
    exclusion: &Exclusion,
) -> ApiScan {
    let listeners = tcp_listener_urls();
    let mut snapshots = Vec::new();
    let mut failures = Vec::new();
    let mut unreachable = Vec::new();
    let shared_directories: HashSet<_> = processes
        .iter()
        .filter_map(|process| process.directory.clone())
        .collect();
    for process in processes.iter().filter(|process| {
        process.directory.is_none()
            && (process.role == ProcessRole::RemoteClient || !exclusion.includes_process(process))
    }) {
        failures.push(format!("pid={} cwd:unavailable", process.pid));
    }
    for process in processes.iter().filter(|process| {
        process.role != ProcessRole::RemoteClient && !exclusion.includes_process(process)
    }) {
        let mut found = false;
        for inode in process_sockets(process.pid) {
            let Some(url) = listeners.get(&inode) else {
                continue;
            };
            if request_json(
                client,
                url,
                process.authorization.as_deref(),
                None,
                "/global/health",
            )
            .as_ref()
            .and_then(|value| value.get("healthy"))
            .and_then(Value::as_bool)
                != Some(true)
            {
                continue;
            }
            found = true;
            let directories: Vec<_> = if process.role == ProcessRole::SharedServer {
                shared_directories.iter().collect()
            } else {
                process.directory.iter().collect()
            };
            for directory in directories {
                let state = match request_json(
                    client,
                    url,
                    process.authorization.as_deref(),
                    Some(directory),
                    "/session/status",
                ) {
                    Some(Value::Object(status)) => {
                        let sessions = status
                            .keys()
                            .filter_map(|session| {
                                request_json(
                                    client,
                                    url,
                                    process.authorization.as_deref(),
                                    Some(directory),
                                    &format!("/session/{session}"),
                                )
                                .map(|details| (session.clone(), details))
                            })
                            .collect();
                        let messages = status
                            .iter()
                            .filter(|(_, state)| {
                                state.get("type").and_then(Value::as_str) == Some("busy")
                            })
                            .filter_map(|(session, _)| {
                                let messages = request_json(
                                    client,
                                    url,
                                    process.authorization.as_deref(),
                                    Some(directory),
                                    &format!("/session/{session}/message"),
                                )?;
                                Some((session.clone(), messages))
                            })
                            .collect();
                        WorkspaceState::Available {
                            status,
                            sessions,
                            messages,
                            questions: request_json(
                                client,
                                url,
                                process.authorization.as_deref(),
                                Some(directory),
                                "/question",
                            ),
                            permissions: request_json(
                                client,
                                url,
                                process.authorization.as_deref(),
                                Some(directory),
                                "/permission",
                            ),
                        }
                    }
                    _ => WorkspaceState::Invalid,
                };
                snapshots.push(ApiSnapshot {
                    pid: process.pid,
                    url: url.clone(),
                    directory: directory.clone(),
                    state,
                });
            }
            break;
        }
        if !found {
            unreachable.push(process);
        }
    }
    for process in unreachable {
        let represented_by_shared_server = process.role == ProcessRole::Standalone
            && process.directory.as_ref().is_some_and(|directory| {
                snapshots.iter().any(|snapshot| {
                    snapshot.directory == *directory
                        && matches!(&snapshot.state, WorkspaceState::Available { .. })
                })
            });
        if !represented_by_shared_server {
            failures.push(format!("pid={} opencode-api:unreachable", process.pid));
        }
    }
    if snapshots.is_empty()
        && failures.is_empty()
        && processes
            .iter()
            .any(|process| process.role == ProcessRole::RemoteClient)
    {
        failures.push("remote opencode clients have no observable server".to_owned());
    }
    ApiScan {
        snapshots,
        failures,
    }
}

fn invoking_sessions(scan: &ApiScan) -> HashSet<String> {
    scan.snapshots
        .iter()
        .filter_map(|snapshot| match &snapshot.state {
            WorkspaceState::Available {
                status, messages, ..
            } => Some((status, messages)),
            WorkspaceState::Invalid => None,
        })
        .flat_map(|(status, messages)| {
            status
                .iter()
                .filter(|(_, state)| state.get("type").and_then(Value::as_str) == Some("busy"))
                .filter(|(session, _)| messages.get(*session).is_some_and(has_running_watchdog))
                .map(|(session, _)| session.clone())
        })
        .collect()
}

fn api_blockers(scan: &ApiScan, exclusion: &Exclusion) -> Vec<String> {
    let mut details = scan.failures.clone();
    for snapshot in &scan.snapshots {
        let WorkspaceState::Available {
            status,
            messages,
            questions,
            permissions,
            ..
        } = &snapshot.state
        else {
            details.push(format!(
                "pid={} {} directory={} session-status:invalid",
                snapshot.pid, snapshot.url, snapshot.directory
            ));
            continue;
        };
        let active = session_blockers(
            status,
            questions.as_ref(),
            permissions.as_ref(),
            messages,
            &exclusion.sessions,
        );
        if !active.is_empty() {
            details.push(format!(
                "pid={} {} directory={} {}",
                snapshot.pid,
                snapshot.url,
                snapshot.directory,
                active.into_iter().take(4).collect::<Vec<_>>().join(" ")
            ));
        }
    }
    details
}

fn initial_scan(client: &ureq::Agent) -> Result<(Exclusion, ApiScan)> {
    let processes = opencode_processes()?;
    let mut exclusion = Exclusion::detect();
    let scan = api_snapshots(client, &processes, &exclusion);
    exclusion.sessions.extend(invoking_sessions(&scan));
    Ok((exclusion, scan))
}

fn summarize(items: &[String], limit: usize) -> String {
    let mut visible: Vec<_> = items.iter().take(limit).cloned().collect();
    if items.len() > limit {
        visible.push(format!("... +{} more", items.len() - limit));
    }
    visible.join(" | ")
}

fn elapsed(millis: u64) -> String {
    let seconds = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap_or_default()
        .as_millis()
        .saturating_sub(millis as u128)
        / 1000;
    match seconds {
        0..60 => format!("{seconds}s"),
        60..3600 => format!("{}m {:02}s", seconds / 60, seconds % 60),
        3600..86400 => format!("{}h {:02}m", seconds / 3600, seconds / 60 % 60),
        _ => format!("{}d {:02}h", seconds / 86400, seconds / 3600 % 24),
    }
}

fn clean_text(value: &str) -> String {
    value
        .chars()
        .filter(|character| !character.is_control())
        .collect()
}

fn wrap_text(value: &str, width: usize) -> Vec<String> {
    let mut remaining: Vec<_> = value.chars().collect();
    let mut lines = Vec::new();
    while remaining.len() > width {
        let split = remaining[..width]
            .iter()
            .rposition(|character| {
                character.is_whitespace() || matches!(character, '/' | '-' | '_')
            })
            .map(|index| index + 1)
            .filter(|index| *index > 1)
            .unwrap_or(width);
        lines.push(
            remaining
                .drain(..split)
                .collect::<String>()
                .trim_end()
                .to_owned(),
        );
        let whitespace = remaining
            .iter()
            .take_while(|character| character.is_whitespace())
            .count();
        remaining.drain(..whitespace);
    }
    lines.push(remaining.iter().collect());
    lines
}

fn print_cells(cells: &[String; 6], widths: &[usize; 6], color: Option<&str>) {
    let wrapped = cells
        .iter()
        .zip(widths)
        .map(|(cell, width)| wrap_text(cell, *width))
        .collect::<Vec<_>>();
    for line in 0..wrapped.iter().map(Vec::len).max().unwrap_or(1) {
        for column in 0..cells.len() {
            let value = wrapped[column].get(line).map(String::as_str).unwrap_or("");
            if column > 0 {
                print!("  ");
            }
            if column == 0
                && let Some(color) = color
            {
                print!(
                    "\x1b[{color}m{value:<width$}\x1b[0m",
                    width = widths[column]
                );
            } else if matches!(column, 1 | 2) {
                print!("{value:>width$}", width = widths[column]);
            } else {
                print!("{value:<width$}", width = widths[column]);
            }
        }
        println!();
    }
}

fn table_widths() -> [usize; 6] {
    let mut size = unsafe { std::mem::zeroed::<libc::winsize>() };
    let available =
        if unsafe { libc::ioctl(libc::STDOUT_FILENO, libc::TIOCGWINSZ, &mut size) } == 0
            && size.ws_col > 0
        {
            size.ws_col as usize
        } else {
            120
        }
        .saturating_sub(10)
        .max(6);
    let mut widths = [9, 8, 9, 8, 32, 12];
    while widths.iter().sum::<usize>() > available {
        let column = (0..widths.len())
            .max_by_key(|column| widths[*column])
            .unwrap();
        widths[column] = widths[column].saturating_sub(1).max(1);
    }
    let extra = available - widths.iter().sum::<usize>();
    widths[3] += extra / 3;
    widths[5] += extra - extra / 3;
    widths
}

struct Dashboard {
    enabled: bool,
    termios: Option<libc::termios>,
}

impl Dashboard {
    fn new() -> Self {
        let enabled = io::stdout().is_terminal();
        let mut original = unsafe { std::mem::zeroed::<libc::termios>() };
        let termios =
            if enabled && unsafe { libc::tcgetattr(libc::STDIN_FILENO, &mut original) } == 0 {
                let mut cbreak = original;
                cbreak.c_lflag &= !(libc::ICANON | libc::ECHO);
                cbreak.c_cc[libc::VMIN] = 0;
                cbreak.c_cc[libc::VTIME] = 0;
                (unsafe { libc::tcsetattr(libc::STDIN_FILENO, libc::TCSANOW, &cbreak) } == 0)
                    .then_some(original)
            } else {
                None
            };
        if enabled {
            print!("\x1b[?1049h\x1b[?25l");
            let _ = io::stdout().flush();
        }
        Self { enabled, termios }
    }

    fn loading(&self) {
        if self.enabled {
            print!(
                "\x1b[H\x1b[2J\x1b[1;36mOPENCODE IDLE WATCHDOG\x1b[0m\n\n\x1b[2mScanning sessions...\x1b[0m"
            );
            let _ = io::stdout().flush();
        }
    }

    fn wait(&self, cancellation: &Cancellation, duration: Duration) -> Option<i32> {
        let mut byte = 0_u8;
        (self.termios.is_some()
            && unsafe {
                libc::read(libc::STDIN_FILENO, std::ptr::from_mut(&mut byte).cast(), 1)
            } == 1
            // ponytail: Escape-prefixed keys also exit; parse sequences if navigation is added.
            && matches!(byte, b'q' | 0x1b))
        .then_some(0)
        .or_else(|| cancellation.wait(duration))
    }

    fn draw(
        &self,
        scan: &ApiScan,
        exclusion: &Exclusion,
        check: u32,
        idle: u32,
        required_idle: u32,
        next_scan: u64,
    ) {
        if !self.enabled {
            return;
        }
        let active = scan
            .snapshots
            .iter()
            .filter_map(|snapshot| match &snapshot.state {
                WorkspaceState::Available { status, .. } => Some(status.len()),
                WorkspaceState::Invalid => None,
            })
            .sum::<usize>();
        let mut rows = Vec::new();
        for snapshot in &scan.snapshots {
            let WorkspaceState::Available {
                status,
                sessions,
                messages,
                questions,
                permissions,
            } = &snapshot.state
            else {
                continue;
            };
            let waiting = waiting_sessions(
                status,
                questions.as_ref(),
                permissions.as_ref(),
                messages,
                &exclusion.sessions,
            );
            for (session, state) in status {
                let kind = state
                    .get("type")
                    .and_then(Value::as_str)
                    .unwrap_or("unknown");
                let (label, color) = if exclusion.sessions.contains(session) {
                    ("SELF", "36")
                } else if waiting.contains(session) {
                    ("WAITING", "34")
                } else {
                    match kind {
                        "busy" => ("RUNNING", "33"),
                        "retry" => ("RETRY", "35"),
                        _ => ("UNKNOWN", "31"),
                    }
                };
                let details = sessions.get(session);
                let age = details
                    .and_then(|value| value.pointer("/time/created"))
                    .and_then(Value::as_u64)
                    .map(elapsed)
                    .unwrap_or_else(|| "-".to_owned());
                let updated = details
                    .and_then(|value| value.pointer("/time/updated"))
                    .and_then(Value::as_u64)
                    .map(elapsed)
                    .unwrap_or_else(|| "-".to_owned());
                let title = details
                    .and_then(|value| value.get("title"))
                    .and_then(Value::as_str)
                    .unwrap_or("Untitled session");
                rows.push((
                    color,
                    [
                        label.to_owned(),
                        age,
                        updated,
                        clean_text(&snapshot.directory),
                        session.clone(),
                        clean_text(title),
                    ],
                ));
            }
        }
        rows.sort_unstable_by(|left, right| left.1.cmp(&right.1));
        let widths = table_widths();
        print!("\x1b[H\x1b[2J");
        println!("\x1b[1;36mOPENCODE IDLE WATCHDOG\x1b[0m");
        println!(
            "\x1b[2mcheck #{check}  |\x1b[0m  {active} active  |  idle {idle}/{required_idle}  |  next scan in {next_scan}s\n"
        );
        print!("\x1b[2m");
        let headers =
            ["STATUS", "AGE", "UPDATED", "WORKSPACE", "SESSION", "TITLE"].map(str::to_owned);
        print_cells(&headers, &widths, None);
        print!("\x1b[0m");
        if rows.is_empty() {
            println!("\x1b[32mIDLE\x1b[0m      No active sessions");
        } else {
            for (color, row) in rows {
                print_cells(&row, &widths, Some(color));
            }
        }
        if !scan.failures.is_empty() {
            println!("\n\x1b[31mAPI errors\x1b[0m");
            for failure in &scan.failures {
                println!("  {}", clean_text(failure));
            }
        }
        println!("\n\x1b[2mq / Esc / Ctrl-C to exit\x1b[0m");
        let _ = io::stdout().flush();
    }
}

impl Drop for Dashboard {
    fn drop(&mut self) {
        if let Some(original) = &self.termios {
            unsafe {
                libc::tcsetattr(libc::STDIN_FILENO, libc::TCSANOW, original);
            }
        }
        if self.enabled {
            print!("\x1b[?25h\x1b[?1049l");
            let _ = io::stdout().flush();
        }
    }
}

fn signal_exit(state: &State, signal: i32) -> i32 {
    if signal == 0 {
        state.log("watchdog exited");
        return 0;
    }
    state.log(if signal == SIGINT {
        "watchdog interrupted"
    } else {
        "watchdog terminated"
    });
    128 + signal
}

fn wait_until_idle(state: &State, options: &Options) -> Result<i32> {
    let Some(instance) = Instance::acquire(state)? else {
        return Ok(0);
    };
    let client = http_client();
    let dashboard = Dashboard::new();
    let cancellation = Cancellation::new()?;
    dashboard.loading();
    let (exclusion, mut scan) = initial_scan(&client)?;
    let mut excluded_sessions: Vec<_> = exclusion.sessions.iter().cloned().collect();
    excluded_sessions.sort_unstable();
    let started = format!(
        "watchdog started; excluding opencode pid={} sessions={}; interval={}s required_idle_checks={}; cache={}",
        exclusion
            .pid
            .map(|pid| pid.to_string())
            .unwrap_or_else(|| "unknown".into()),
        if excluded_sessions.is_empty() {
            "unknown".to_owned()
        } else {
            excluded_sessions.join(",")
        },
        options.interval,
        options.required_idle_checks,
        state.root.display()
    );
    if dashboard.enabled {
        state.record(started);
    } else {
        state.log(started);
    }

    let mut consecutive_idle = 0;
    let mut check = 0;
    let signal = 'checks: loop {
        check += 1;
        let api_blockers = api_blockers(&scan, &exclusion);
        consecutive_idle = if api_blockers.is_empty() {
            consecutive_idle + 1
        } else {
            0
        };
        let check_message = format!(
            "check {check}: idle={consecutive_idle}/{}; blockers={}",
            options.required_idle_checks,
            if api_blockers.is_empty() {
                "none"
            } else {
                "opencode API session status"
            }
        );
        if dashboard.enabled {
            state.record(check_message);
        } else {
            state.log(check_message);
        }
        if !api_blockers.is_empty() {
            let blockers = format!("opencode_api_blockers: {}", summarize(&api_blockers, 5));
            if dashboard.enabled {
                state.record(blockers);
            } else {
                state.log(blockers);
            }
        }
        dashboard.draw(
            &scan,
            &exclusion,
            check,
            consecutive_idle,
            options.required_idle_checks,
            options.interval,
        );
        if let Some(signal) = dashboard.wait(&cancellation, Duration::ZERO) {
            break Some(signal);
        }
        if consecutive_idle >= options.required_idle_checks {
            break None;
        }
        let mut remaining = options.interval;
        while remaining > 0 {
            if let Some(signal) = dashboard.wait(&cancellation, Duration::from_secs(1)) {
                break 'checks Some(signal);
            }
            remaining -= 1;
            dashboard.draw(
                &scan,
                &exclusion,
                check,
                consecutive_idle,
                options.required_idle_checks,
                remaining,
            );
        }
        scan = api_snapshots(&client, &opencode_processes()?, &exclusion);
    };

    drop(instance);
    drop(dashboard);
    if let Some(signal) = signal {
        return Ok(signal_exit(state, signal));
    }
    state.log("idle confirmed");
    if options.command.is_empty() {
        Ok(0)
    } else {
        Ok(run_command(state, &cancellation, &options.command))
    }
}

fn terminate_child(child: &mut Child) {
    let _ = child.kill();
    let _ = child.wait();
}

fn command_display(command: &[OsString]) -> String {
    command
        .iter()
        .map(|arg| format!("{arg:?}"))
        .collect::<Vec<_>>()
        .join(" ")
}

fn run_command(state: &State, cancellation: &Cancellation, command: &[OsString]) -> i32 {
    state.log(format!("running command: {}", command_display(command)));
    let Some((program, arguments)) = command.split_first() else {
        state.log("could not run command: empty command");
        return 127;
    };
    let mut child = match Command::new(program).args(arguments).spawn() {
        Ok(child) => child,
        Err(error) => {
            state.log(format!("could not run command: {error}"));
            return 127;
        }
    };

    loop {
        match child.try_wait() {
            Ok(Some(status)) => {
                let code = status
                    .code()
                    .or_else(|| status.signal().map(|signal| 128 + signal))
                    .unwrap_or(1);
                state.log(format!("command exited with status {code}"));
                return code;
            }
            Ok(None) => {}
            Err(error) => {
                terminate_child(&mut child);
                state.log(format!("could not wait for command: {error}"));
                return 1;
            }
        }
        if let Some(signal) = cancellation.wait(Duration::from_millis(50)) {
            terminate_child(&mut child);
            return signal_exit(state, signal);
        }
    }
}

fn alive(pid: i32) -> bool {
    pid > 0
        && (unsafe { libc::kill(pid, 0) } == 0
            || io::Error::last_os_error().raw_os_error() == Some(libc::EPERM))
}

fn print_status(state: &State) -> i32 {
    let pid = state.read_pid();
    println!(
        "running={} pid={}",
        pid.is_some_and(alive),
        pid.map(|pid| pid.to_string())
            .unwrap_or_else(|| "unknown".into())
    );
    println!("cache={}", state.root.display());
    println!("log={}", state.log_file.display());
    if let Ok(log) = fs::read_to_string(&state.log_file) {
        let lines: Vec<_> = log.lines().collect();
        if !lines.is_empty() {
            println!("last log lines:");
            for line in &lines[lines.len().saturating_sub(8)..] {
                println!("{line}");
            }
        }
    }
    0
}

fn stop(state: &State) -> i32 {
    let Some(pid) = state.read_pid().filter(|pid| alive(*pid)) else {
        println!("watchdog is not running");
        return 0;
    };
    if unsafe { libc::kill(pid, SIGTERM) } != 0 {
        eprintln!(
            "could not stop watchdog pid={pid}: {}",
            io::Error::last_os_error()
        );
        return 1;
    }
    for _ in 0..50 {
        if !alive(pid) {
            println!("stopped watchdog pid={pid}");
            return 0;
        }
        thread::sleep(Duration::from_millis(100));
    }
    println!("watchdog pid={pid} did not stop after SIGTERM");
    1
}

fn background_arguments(options: &Options) -> Vec<OsString> {
    let mut arguments = vec![
        "--interval".into(),
        options.interval.to_string().into(),
        "--required-idle-checks".into(),
        options.required_idle_checks.to_string().into(),
    ];
    if !options.command.is_empty() {
        arguments.push("--".into());
        arguments.extend(options.command.iter().cloned());
    }
    arguments
}

fn launch_background(state: &State, options: &Options) -> Result<i32> {
    let (exclusion, _) = initial_scan(&http_client())?;
    fs::create_dir_all(&state.root)?;
    let mut child = Command::new(env::current_exe().context("locate watchdog executable")?);
    child
        .args(background_arguments(options))
        .stdin(Stdio::null())
        .stdout(Stdio::null())
        .stderr(Stdio::null());
    if let Some(pid) = exclusion.pid {
        child.env("WATCHDOG_EXCLUDE_OPENCODE_PID", pid.to_string());
    }
    if !exclusion.sessions.is_empty() {
        child.env(
            "WATCHDOG_EXCLUDE_OPENCODE_SESSIONS",
            exclusion.sessions.into_iter().collect::<Vec<_>>().join(","),
        );
    }
    unsafe {
        child.pre_exec(|| {
            if libc::setsid() == -1 {
                Err(io::Error::last_os_error())
            } else {
                Ok(())
            }
        });
    }
    let child = child.spawn().context("start detached watchdog")?;
    println!("started {NAME} pid={}", child.id());
    println!("log={}", state.log_file.display());
    Ok(0)
}

fn execute() -> Result<i32> {
    let options = Options::parse();
    let state = State::discover()?;
    if options.status {
        return Ok(print_status(&state));
    }
    if options.stop {
        return Ok(stop(&state));
    }
    if options.detach {
        return launch_background(&state, &options);
    }
    wait_until_idle(&state, &options)
}

fn main() {
    let code = match execute() {
        Ok(code) => code,
        Err(error) => {
            if let Ok(state) = State::discover() {
                state.log(format!("watchdog crashed: {error:#}"));
            }
            eprintln!("{NAME}: {error:#}");
            1
        }
    };
    std::process::exit(code);
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn parses_proc_stat_with_spaces_and_parentheses() {
        assert_eq!(
            parse_stat("42 (odd ) process) S 7 1 2 3").unwrap(),
            ("odd ) process".to_owned(), 7)
        );
    }

    #[test]
    fn parses_proc_listener_addresses() {
        assert_eq!(listener_host("0100007F").as_deref(), Some("127.0.0.1"));
        assert_eq!(listener_host("00000000").as_deref(), Some("127.0.0.1"));
        assert_eq!(
            listener_host("00000000000000000000000001000000").as_deref(),
            Some("[::1]")
        );
        assert_eq!(
            listener_host("00000000000000000000000000000000").as_deref(),
            Some("[::1]")
        );
        assert_eq!(listener_host("not-an-address"), None);
    }

    #[test]
    fn classifies_user_waits_and_foreground_task_chains() {
        let fixture: Value = serde_json::from_str(r#"{
          "status":{"background":{"type":"busy"},"busy":{"type":"busy"},"idle":{"type":"idle"},"leaf":{"type":"busy"},"malformed":"oops","malformed_task":{"type":"busy"},"middle":{"type":"busy"},"mixed":{"type":"busy"},"other":{"type":"busy"},"partial":{"type":"busy"},"permission":{"type":"busy"},"root":{"type":"busy"}},
          "questions":[{"sessionID":"leaf"}],"permissions":[{"sessionID":"permission"}],
          "messages":{
            "background":[{
              "info":{"role":"assistant"},
              "parts":[{"type":"tool","tool":"task","sessionID":"background","state":{"status":"running","metadata":{"sessionId":"leaf","background":true}}}]
            }],
            "malformed_task":[{
              "info":{"role":"assistant"},
              "parts":[{"type":"tool","tool":"task","sessionID":"malformed_task","state":{"status":"running","metadata":{"sessionId":"leaf","background":"false"}}}]
            }],
            "middle":[
              {"info":{"role":"assistant"},"parts":[{"type":"tool","tool":"bash","state":{"status":"running"}}]},
              {"info":{"role":"assistant"},"parts":[{"type":"tool","tool":"task","sessionID":"middle","state":{"status":"running","metadata":{"sessionId":"leaf"}}}]}
            ],
            "mixed":[{
              "info":{"role":"assistant"},
              "parts":[
                {"type":"tool","tool":"task","sessionID":"mixed","state":{"status":"running","metadata":{"sessionId":"leaf"}}},
                {"type":"tool","tool":"bash","state":{"status":"running"}}
              ]
            }],
            "partial":[{
              "info":{"role":"assistant"},
              "parts":[
                {"type":"tool","tool":"task","sessionID":"partial","state":{"status":"running","metadata":{"sessionId":"leaf"}}},
                {"type":"tool","tool":"task","sessionID":"partial","state":{"status":"running","metadata":{"sessionId":"other"}}}
              ]
            }],
            "root":[{
              "info":{"role":"assistant"},
              "parts":[{"type":"tool","tool":"task","sessionID":"root","state":{"status":"running","metadata":{"sessionId":"middle","background":false}}}]
            }]
          }
        }"#).unwrap();
        assert_eq!(
            session_blockers(
                fixture["status"].as_object().unwrap(),
                Some(&fixture["questions"]),
                Some(&fixture["permissions"]),
                fixture["messages"].as_object().unwrap(),
                &HashSet::new(),
            ),
            [
                "background:busy",
                "busy:busy",
                "malformed:unknown",
                "malformed_task:busy",
                "mixed:busy",
                "other:busy",
                "partial:busy",
            ]
        );
    }

    #[test]
    fn excludes_sessions_running_the_watchdog() {
        let messages: Value = serde_json::from_str(
            r#"[{
          "parts":[{
            "type":"tool",
            "tool":"bash",
            "state":{
              "status":"running",
              "input":{"command":"/home/me/.local/bin/opencode-idle-watchdog --detach"}
            }
          }]
        }]"#,
        )
        .unwrap();
        assert!(has_running_watchdog(&messages));

        let mut excluded = HashSet::new();
        excluded.insert("self".to_owned());
        let status: serde_json::Map<String, Value> =
            serde_json::from_str(r#"{"other":{"type":"busy"},"self":{"type":"busy"}}"#).unwrap();
        assert_eq!(
            session_blockers(&status, None, None, &serde_json::Map::new(), &excluded),
            ["other:busy"]
        );
    }

    #[test]
    fn trailing_command_owns_its_flags() {
        let options =
            Options::try_parse_from([NAME, "--detach", "notify-send", "--detach"]).unwrap();
        assert!(options.detach);
        assert_eq!(options.command, ["notify-send", "--detach"]);
    }

    #[test]
    fn detached_arguments_are_canonical() {
        let options = Options::try_parse_from([
            NAME,
            "--detach",
            "--interval",
            "7",
            "--required-idle-checks",
            "2",
            "notify-send",
            "--detach",
        ])
        .unwrap();
        assert_eq!(
            background_arguments(&options),
            [
                "--interval",
                "7",
                "--required-idle-checks",
                "2",
                "--",
                "notify-send",
                "--detach"
            ]
        );
    }

    #[test]
    fn detached_arguments_keep_separator_for_dash_command() {
        let options = Options::try_parse_from([NAME, "--detach", "--", "--command"]).unwrap();
        assert_eq!(
            background_arguments(&options),
            [
                "--interval",
                "180",
                "--required-idle-checks",
                "3",
                "--",
                "--command"
            ]
        );
    }

    #[test]
    fn rejects_zero_controls() {
        assert!(Options::try_parse_from([NAME, "--interval", "0"]).is_err());
        assert!(Options::try_parse_from([NAME, "--required-idle-checks", "0"]).is_err());
    }

    #[test]
    fn summarizes_overflow() {
        let details = vec!["one".into(), "two".into(), "three".into()];
        assert_eq!(summarize(&details, 2), "one | two | ... +1 more");
    }

    #[test]
    fn cleans_terminal_text() {
        assert_eq!(clean_text("hello\nworld"), "helloworld");
        assert_eq!(wrap_text("abcdefgh", 3), ["abc", "def", "gh"]);
    }
}
