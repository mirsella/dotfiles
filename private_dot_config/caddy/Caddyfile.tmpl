{{- $host := .chezmoi.hostname -}}
{{- $domain := "mirsella.mooo.com" -}}
{
	admin unix//run/caddy/admin.socket
	auto_https disable_redirects
	skip_install_trust
	servers :4096 {
		listener_wrappers {
			http_redirect
			tls
		}
	}
	servers :4097 {
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

(homepage) {
	root * /srv/mirsella-home
	encode zstd gzip
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}
	file_server
}

(opencode) {
	reverse_proxy 127.0.0.1:14096 {
		flush_interval -1
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}

(openchamber) {
	reverse_proxy 127.0.0.1:14097 {
		flush_interval -1
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}

{{ if eq $host "main" -}}
(site_tls) {
	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			disable_http_challenge
		}
	}
}

http://{{ $domain }} {
	redir https://{{ $domain }}{uri} 308
}

http://{{ $host }}, https://{{ $domain }} {
	import site_tls
	import homepage
}

https://{{ $domain }}:4096 {
	import site_tls
	import opencode
}

https://{{ $domain }}:4097 {
	import site_tls
	import openchamber
}
{{ else -}}
(site_tls) {
	tls internal
}

http://{{ $host }}, http://{{ $host }}.local, http://localhost {
	redir https://{host}{uri} 308
}

https://{{ $host }}, https://{{ $host }}.local, https://localhost {
	import site_tls
	import homepage
}

https://{{ $host }}:4096, https://{{ $host }}.local:4096, https://localhost:4096 {
	import site_tls
	import opencode
}

https://{{ $host }}:4097, https://{{ $host }}.local:4097, https://localhost:4097 {
	import site_tls
	import openchamber
}
{{ end -}}
