{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@tarquinen/opencode-dcp",
    "opencode-wakatime",
    // "@slkiser/opencode-quota",
    "@tarquinen/opencode-smart-title",
    "@mirsella/opencode-queue",
    "@plannotator/opencode",
    "@mirsella/opencode-goal",
    "@mirsella/opencode-browser-mcp",
  ],
  "autoupdate": "notify",
  "experimental": {
    "disable_paste_summary": true,
  },
  "formatter": {
    "rustfmt": {
      "command": ["rustfmt", "$FILE"],
      "extensions": [".rs"],
    },
  },
  "mcp": {
    "aws": {
      "type": "remote",
      "url": "https://aws-mcp.eu-central-1.api.aws/mcp",
      "enabled": false,
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
    },
    "computer_use": {
      "type": "local",
      "command": ["computer-use-mcp", "mcp"],
      "enabled": true,
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false,
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": false,
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp-eu.posthog.com/mcp",
      "enabled": false,
    },
    "railway": {
      "type": "local",
      "command": ["npx", "-y", "@railway/mcp-server"],
      "enabled": false,
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": false,
    },
    "google-drive": {
      "type": "local",
      "command": ["npx", "-y", "@piotr-agier/google-drive-mcp"],
      "enabled": false,
    },
    "planetscale": {
      "type": "remote",
      "url": "https://mcp.pscale.dev/mcp/planetscale",
      "enabled": false,
    },
    "resend": {
      "type": "local",
      "command": ["npx", "-y", "resend-mcp"],
      "enabled": false,
      "environment": {
        "RESEND_API_KEY": "{env:RESEND_API_KEY}",
      },
    },
  },
  "lsp": {
    "rust": {
      "disabled": true,
    },
    "rust-lspmux": {
      "disabled": true,
      "command": ["lspmux", "client"],
      "extensions": [".rs"],
    },
  },
  "permission": {
    "external_directory": "allow",
  },
  "agent": {
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "max",
    },
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol-fast": {
          "variants": {
            "none": {
              "disabled": true,
            },
            "minimal": {
              "disabled": true,
            },
            "medium": {
              "disabled": true,
            },
          },
        },
        "gpt-5.6-sol": {
          "variants": {
            "none": {
              "disabled": true,
            },
            "minimal": {
              "disabled": true,
            },
            "medium": {
              "disabled": true,
            },
          },
        },
      },
    },
    // Detected copilot authentication; opencode-quota added this global provider declaration.
    "copilot": {},
    // Detected openrouter authentication; opencode-quota added this global provider declaration.
    "openrouter": {},
    // Detected google-antigravity authentication; opencode-quota added this global provider declaration.
    "google-antigravity": {},
    // Detected google-gemini-cli authentication; opencode-quota added this global provider declaration.
    "google-gemini-cli": {},
  },
}
