{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    // "@tarquinen/opencode-dcp@github:mirsella/opencode-dynamic-context-pruning#main",
    "opencode-wakatime",
    "@tarquinen/opencode-smart-title",
    "opencode-queue",
    "@plannotator/opencode",
    "opencode-goal",
    "@mirsella/opencode-browser-mcp",
    "@dietrichgebert/ponytail",
    ["./doom-loop-threshold.ts", { "threshold": 6 }],
  ],
  "autoupdate": false,
  "experimental": {
    "disable_paste_summary": true,
  },
  "formatter": {
    "rustfmt": {
      "command": ["rustfmt", "$FILE"],
      "extensions": [".rs"],
    },
  },
  "mcp": {
    "context7-broker": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "git+https://github.com/mirsella/context7-account-broker.git",
      ],
      "timeout": 30000,
      "enabled": true,
      "environment": {
        "npm_config_allow_git": "all",
      },
    },
    "computer_use": {
      "type": "local",
      "command": ["computer-use-mcp", "mcp"],
      "enabled": false,
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false,
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": false,
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp-eu.posthog.com/mcp",
      "enabled": false,
    },
    "railway": {
      "type": "local",
      "command": ["npx", "-y", "@railway/mcp-server"],
      "enabled": false,
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": false,
    },
    "google-drive": {
      "type": "local",
      "command": ["npx", "-y", "@piotr-agier/google-drive-mcp"],
      "enabled": false,
    },
    "planetscale": {
      "type": "remote",
      "url": "https://mcp.pscale.dev/mcp/planetscale",
      "enabled": false,
    },
    "resend": {
      "type": "local",
      "command": ["npx", "-y", "resend-mcp"],
      "enabled": false,
      "environment": {
        "RESEND_API_KEY": "{env:RESEND_API_KEY}",
      },
    },
  },
  "lsp": {
    "rust": {
      "disabled": true,
    },
    "rust-lspmux": {
      "disabled": true,
      "command": ["lspmux", "client"],
      "extensions": [".rs"],
    },
  },
  "permission": {
    "external_directory": "allow",
    "read": "allow",
  },
  "agent": {
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "max",
    },
  },
  "compaction": {
    "prune": false,
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "variants": {
            "none": {
              "disabled": true,
            },
            "minimal": {
              "disabled": true,
            },
            "low": {
              "disabled": true,
            },
            "medium": {
              "disabled": true,
            },
            "high": {
              "disabled": true,
            },
            "xhigh": {
              "disabled": true,
            },
            "max": {
              "reasoningEffort": "max",
            },
          },
        },
        "gpt-5.6-sol-fast": {
          "variants": {
            "none": {
              "disabled": true,
            },
            "minimal": {
              "disabled": true,
            },
          },
        },
        "gpt-5.6-sol": {
          "variants": {
            "none": {
              "disabled": true,
            },
            "minimal": {
              "disabled": true,
            },
          },
        },
      },
      "options": {
        "headers": {
          "sleev-provider": "codex",
          "sleev-harness": "opencode",
        },
        "baseURL": "http://127.0.0.1:17321",
      },
    },
    "opencode": {
      "options": {
        "headers": {
          "sleev-provider": "opencode",
          "sleev-harness": "opencode",
        },
        "baseURL": "http://127.0.0.1:17321",
      },
    },
    "copilot": {
      "options": {
        "headers": {
          "sleev-provider": "copilot",
          "sleev-harness": "opencode",
        },
        "baseURL": "http://127.0.0.1:17321",
      },
    },
  },
}
