{
  "$schema": "https://opencode.ai/tui.json",
  // "theme": "rosepine",
  "keybinds": {
    "model_cycle_recent": "f4",
    "model_cycle_recent_reverse": "f5",
    "input_delete_line": "none",
    "input_delete_to_line_end": "none",
    "input_delete_to_line_start": "none",
    "messages_half_page_up": "ctrl+u",
    "messages_half_page_down": "ctrl+d",
  },
  "plugin": [
    "./tui-plugins/suppress-ctrl-u.ts",
    "github:mirsella/opencode-dynamic-context-pruning#4735a75e05ef832ceff6371fca4fa9e2d4b22f73",
  ],
}
