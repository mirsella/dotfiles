#!/bin/sh
set -eu

if [ "$(hostname -s)" != main ]; then
  printf 'error: hotspot forwarding is only valid on host main\n' >&2
  exit 1
fi

iptables -w 5 -P FORWARD DROP

iptables -w 5 -C DOCKER-USER -s 10.42.0.0/24 -i wlan0 -o enp5s0 -j ACCEPT 2>/dev/null ||
  iptables -w 5 -I DOCKER-USER 1 -s 10.42.0.0/24 -i wlan0 -o enp5s0 -j ACCEPT

iptables -w 5 -C DOCKER-USER -d 10.42.0.0/24 -i enp5s0 -o wlan0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null ||
  iptables -w 5 -I DOCKER-USER 2 -d 10.42.0.0/24 -i enp5s0 -o wlan0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
