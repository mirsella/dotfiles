# vim: set ft=gitignore:
cron/
etc/
system/
apply-colemak-dhm-keyboard.sh
update-system-backup.sh
kde shortcuts.kksrc
{{- if ne .chezmoi.hostname "laptop" }}
.config/nushell/laptop.nu
.local/bin/ryzenadj-laptop
{{- end }}
{{- if not (or (eq .chezmoi.hostname "laptop") (eq .chezmoi.hostname "main")) }}
.config/opencode/plugins/local-llama.ts
{{- end }}
{{- if or (eq .chezmoi.hostname "predator") (eq .chezmoi.hostname "laptop") (eq .chezmoi.hostname "main") }}
# Home Manager owns all user units on HM hosts.
.config/systemd/user/
.config/systemd/user/**
# Home Manager owns generated git and ssh settings on HM hosts.
.config/git/config
.ssh/config
# sops-nix owns service secrets on HM hosts (single writer).
.config/telegram.env
.config/opencode/server.env
.config/openchamber/server.env
.config/environment.d/55-secrets.conf
.config/stuff/config.toml
.config/context7-account-broker/accounts.json
.config/google-drive-mcp/gcp-oauth.keys.json
.config/google-drive-mcp/tokens.json
{{- end }}
{{- if eq .chezmoi.hostname "predator" }}
# Home Manager owns the plain cargo config on predator (no laptop bevy tuning).
.local/share/cargo/config.toml
{{- end }}

# opencode commands
plannotator-annotate.md
plannotator-last.md
plannotator-review.md

# Plannotator skills are removed across agent installations.
.config/opencode/skills/plannotator*
.config/opencode/skills/plannotator*/**

# Codex-managed bundled skills (installed and updated by codex itself).
.codex/skills/.system
.codex/skills/.system/**

# Handy rewrites its settings at runtime; managing it is pure churn.
.local/share/com.pais.handy/settings_store.json

# Never manage dependency trees.
node_modules/
