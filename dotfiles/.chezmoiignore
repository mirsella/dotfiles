# npm writes account tokens into these device-local files.
.npmrc
**/.npmrc
.config/npm/npmrc

# OpenCode generates device-local service credentials and connection state.
.config/opencode/service*.json

# vim: set ft=gitignore:
cron/
etc/
system/
apply-colemak-dhm-keyboard.sh
update-system-backup.sh
kde shortcuts.kksrc
{{- if ne .chezmoi.hostname "laptop" }}
.config/nushell/laptop.nu
{{- end }}
{{- if or (eq .chezmoi.hostname "predator") (eq .chezmoi.hostname "laptop") (eq .chezmoi.hostname "main") }}
# User units on HM hosts are managed outside chezmoi.
.config/systemd/user/
.config/systemd/user/**
# Home Manager installs the REA skill independently from OpenCode's JSONC settings.
.config/opencode/skills/reverse-engineer-anything/
.config/opencode/skills/reverse-engineer-anything/**
# Home Manager installs compiled extensions and the idle watchdog.
.config/opencode/plugins/
.config/opencode/plugins/**
.config/opencode/chunks/
.config/opencode/chunks/**
.local/bin/opencode-idle-watchdog
.local/bin/context7-account-broker
.local/bin/composio-mcp-headers
.local/bin/kache
# Home Manager owns the portable settings helper.
.local/bin/t3-settings
# The Nix bootstrap and native updaters own these agent installs.
.local/bin/codex
.local/bin/codex-code-mode-host
.local/bin/t3
.local/bin/t3code
.local/bin/t3code-nightly
.local/share/applications/t3code.desktop
.local/share/t3code/app/
.local/share/t3code/app/**
.config/kache/config.toml
# Home Manager owns the generated Atuin config on HM hosts.
.config/atuin/config.toml
# Home Manager owns generated git and ssh settings on HM hosts.
.config/git/config
.ssh/config
# sops-nix owns service secrets on HM hosts (single writer).
.config/telegram.env
.config/opencode/server.env
.config/openchamber/server.env
.config/environment.d/55-secrets.conf
.config/stuff/config.toml
.config/context7-account-broker/accounts.json
{{- end }}
{{- if eq .chezmoi.hostname "predator" }}
# Home Manager owns the plain cargo config on predator (no laptop bevy tuning).
.local/share/cargo/config.toml
{{- end }}

# Proton CLI sessions and encryption state are device-local.
.config/protonmail-cli/
.config/protonmail-cli/**
.local/share/proton-pass-cli/
.local/share/proton-pass-cli/**

# Home Manager shares the editable OpenCode skills with Codex and Hermes.
.agents/skills
.agents/skills/**
# Codex installs its built-in skills itself.
.codex/skills/.system/
.codex/skills/.system/**

# Handy rewrites its settings at runtime; managing it is pure churn.
.local/share/com.pais.handy/settings_store.json

# T3's portable bundle is captured explicitly. Raw state includes credentials and history.
.t3/
.t3/**
.config/t3code-v2/
.config/t3code-v2/**

# Never manage dependency trees.
node_modules/
