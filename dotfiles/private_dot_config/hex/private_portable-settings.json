{
  "avoid_bluetooth_microphone": true,
  "capture": {
    "bundle_days": 30,
    "capsule_flow": "list",
    "enabled": true,
    "hotkey": {
      "keys": [
        {
          "code": 0,
          "label": "F9"
        }
      ]
    },
    "media_days": 7,
    "show_overlays_in_recordings": false,
    "transcriber": "parakeet"
  },
  "dictation_hotkey": {
    "keys": [
      {
        "modifier": "command",
        "side": "any"
      },
      {
        "code": 0,
        "label": "Space"
      }
    ]
  },
