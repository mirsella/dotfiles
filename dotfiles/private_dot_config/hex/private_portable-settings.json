  "history_retention": "week",
  "indicator_position": "top",
  "labs": {
    "benchmark_details": true,
    "copy_only": false,
    "filler_words": false,
    "history_stats": true,
    "keep_on_clipboard": false,
    "live_chapters": false,
    "live_text": true,
    "mouse_shortcuts": false,
    "output_fixes": false,
    "parakeet_ultra": true,
    "picker_sort_filter": false,
    "playground": false,
    "recent_dictations": false,
    "restore_shortcut_default": false,
