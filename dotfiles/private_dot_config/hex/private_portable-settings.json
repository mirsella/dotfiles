    "sided_modifier_chords": false,
    "skip_pauses": true,
    "smart_spacing": false,
    "spoken_formatting": false,
    "spoken_symbols": false,
    "standalone_special_keys": false,
    "stop_when_call_ends": false,
    "subtitle_export": false,
    "tap_or_hold": false,
    "unload_idle": true,
    "unload_idle_minutes": 5,
    "vocabulary_biasing": false
