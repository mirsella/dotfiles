{{- $llamaModel := "" -}}
{{- if eq .chezmoi.hostname "main" -}}
  {{- $llamaModel = "qwen3.6-27b-ablit" -}}
{{- else if eq .chezmoi.hostname "laptop" -}}
  {{- $llamaModel = "qwen3.6-35b-a3b-abliterated-v4" -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/v2/config.json",
  "plugins": [
    "opencode-queue@2.0.2",
    "@mirsella/browser-mcp",
    "@mirsella/computer-use-mcp"
  ],
  "update": "disable",
  "formatter": {
    "rustfmt": {
      "command": [
        "rustfmt",
        "$FILE"
      ],
      "extensions": [
        ".rs"
      ]
    }
  },
  "mcp": {
    "servers": {
      "context7-broker": {
        "type": "local",
        "command": [
          "/home/mirsella/.local/bin/context7-account-broker",
          "mcp"
        ],
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        },
        "disabled": false
      },
      "blender-mcp": {
        "type": "local",
        "command": [
          "/home/mirsella/.local/bin/uvx",
          "blender-mcp"
        ],
        "environment": {
          "BLENDER_HOST": "localhost",
          "BLENDER_PORT": "9876"
        },
        "disabled": true
      },
      "composio": {
        "type": "remote",
        "url": "https://backend.composio.dev/tool_router/trs_uiw6Hb4fJ8rr/mcp",
        "oauth": false,
        "headers": {
          "x-org-id": "ok_UWjDVhCpLy46",
          "x-project-id": "pr_ZEY9cNibczW1"
        },
        "disabled": false
      },
      "planetscale": {
        "type": "remote",
        "url": "https://mcp.pscale.dev/mcp/planetscale",
        "disabled": true
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "websearch": {
    "provider": "random"
  },
  "providers": {
    {{- if $llamaModel }}
    "llama.cpp": {
      "name": "Local llama.cpp",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "{{ $llamaModel }}": {
          "name": "{{ $llamaModel }}",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "settings": {
            "reasoning_format": "deepseek"
          },
          "variants": [
            {
              "id": "thinking",
              "settings": {
                "chat_template_kwargs": {
                  "enable_thinking": true
                }
              }
            }
          ],
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "google": {
      "models": {
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
