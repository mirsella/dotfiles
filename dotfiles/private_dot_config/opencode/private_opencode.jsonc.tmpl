{{- $mcp := include "private_dot_config/agent-tools/mcp.json" | fromJson -}}
{{- $servers := dict -}}
{{- range $name, $server := $mcp.servers -}}
  {{- $entry := dict "disabled" (not $server.enabled) -}}
  {{- if eq $server.type "stdio" -}}
    {{- $_ := set $entry "type" "local" -}}
    {{- $_ := set $entry "command" (prepend $server.args $server.command) -}}
    {{- if hasKey $server "env" -}}{{- $_ := set $entry "environment" $server.env -}}{{- end -}}
  {{- else -}}
    {{- $_ := set $entry "type" "remote" -}}
    {{- $_ := set $entry "url" $server.url -}}
    {{- if hasKey $server "headers" -}}{{- $_ := set $entry "headers" $server.headers -}}{{- end -}}
    {{- if hasKey $server "oauth" -}}{{- $_ := set $entry "oauth" $server.oauth -}}{{- end -}}
  {{- end -}}
  {{- if hasKey $server "toolTimeoutSec" -}}
    {{- $milliseconds := mul $server.toolTimeoutSec 1000 -}}
    {{- $_ := set $entry "timeout" (dict "catalog" $milliseconds "execution" $milliseconds) -}}
  {{- end -}}
  {{- $_ := set $servers $name $entry -}}
{{- end -}}
{{- $llamaModel := "" -}}
{{- if eq .chezmoi.hostname "main" -}}
  {{- $llamaModel = "qwen3.6-27b-ablit" -}}
{{- else if eq .chezmoi.hostname "laptop" -}}
  {{- $llamaModel = "qwen3.6-35b-a3b-abliterated-v4" -}}
{{- end -}}
{{- $allowedProviders := list "claude-agent" "openai" "opencode" "opencode-go" -}}
{{- if $llamaModel -}}
  {{- $allowedProviders = append $allowedProviders "llama.cpp" -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/v2/config.json",
  "plugins": [
{{ if or (eq .chezmoi.hostname "main") (eq .chezmoi.hostname "laptop") }}    { "package": "{file:~/.config/opencode/credit-routing/claude.path}" },
    { "package": "{file:~/.config/opencode/credit-routing/openai.path}" },
{{ end }}    "opencode-queue@2.0.2",
    "{{ $mcp.browser.package }}@{{ $mcp.browser.version }}",
    {
      "package": "@mirsella/computer-use-mcp@2.2.0",
      "options": { "enabled": true }
    }
  ],
  "update": "disable",
  "formatter": {
    "rustfmt": {
      "command": [
        "rustfmt",
        "$FILE"
      ],
      "extensions": [
        ".rs"
      ]
    }
  },
  "mcp": {
    "servers": {{ $servers | toPrettyJson | indent 4 | trim }}
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" }{{ range $allowedProviders }},
    { "action": "provider.use", "resource": "{{ . }}", "effect": "allow" }{{ end }}
  ],
  "websearch": {
    "provider": "random"
  },
  "providers": {
    {{- if $llamaModel }}
    "llama.cpp": {
      "name": "Local llama.cpp",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "{{ $llamaModel }}": {
          "name": "{{ $llamaModel }}",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "settings": {
            "reasoning_format": "deepseek"
          },
          "variants": [
            {
              "id": "thinking",
              "settings": {
                "chat_template_kwargs": {
                  "enable_thinking": true
                }
              }
            }
          ],
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    {{- end }}
    "openai": {
      "settings": {
        "chunkTimeout": 180000,
        "baseURL": "http://127.0.0.1:17321/sleev/opencode/codex"
      },
      "models": {
        "gpt-6-luna": {},
        "gpt-6-sol-fast": {},
        "gpt-6-sol": {}
      }
    },
    // Keep OpenCode's free models direct; Sleev support remains unverified.
    // Keep opencode free of Sleev headers and baseURL overrides; openai,
    // opencode-go and claude-agent still route through the gateway.
    "opencode-go": {
      "settings": {
        "baseURL": "http://127.0.0.1:17321/sleev/opencode/opencode-go"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "settings": {
            "baseURL": "http://127.0.0.1:17321/sleev/opencode/opencode-go"
          }
        },
        "muse-spark-1.3-contributor": {
          "settings": {
            "baseURL": "http://127.0.0.1:17321/sleev/opencode/opencode-go"
          }
        },
        "beam-free": {
          "settings": {
            "baseURL": "http://127.0.0.1:17321/sleev/opencode/opencode-go"
          }
        }
      }
    },
    "claude-agent": {
      "settings": {
        "baseURL": "http://127.0.0.1:17321/sleev/opencode/anthropic"
      },
      "models": {
        "opus": {
          "name": "Opus 5.5"
        },
        "claude-fable-5-1[1m]": {
          "disabled": true
        },
        // Claude Code's gateway-mode catalog still lists 5.1; 5.2 works by explicit ID.
        "claude-fable-5-2": {
          "name": "Fable 5.2",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "variants": [
            { "id": "low", "settings": { "effort": "low" } },
            { "id": "medium", "settings": { "effort": "medium" } },
            { "id": "high", "settings": { "effort": "high" } },
            { "id": "xhigh", "settings": { "effort": "xhigh" } },
            { "id": "max", "settings": { "effort": "max" } }
          ]
        }
      }
    }
  }
}
