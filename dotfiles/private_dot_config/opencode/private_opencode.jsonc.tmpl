{{- $llamaModel := "" -}}
{{- if eq .chezmoi.hostname "main" -}}
  {{- $llamaModel = "qwen3.6-27b-ablit" -}}
{{- else if eq .chezmoi.hostname "laptop" -}}
  {{- $llamaModel = "qwen3.6-35b-a3b-abliterated-v4" -}}
{{- end -}}
{{- $allowedProviders := list "claude-agent" "openai" "opencode" "opencode-go" -}}
{{- if $llamaModel -}}
  {{- $allowedProviders = append $allowedProviders "llama.cpp" -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/v2/config.json",
  "plugins": [
    "opencode-queue@2.0.2",
    "/home/mirsella/.local/share/browser-mcp/2.1.0",
    {
      "package": "@mirsella/computer-use-mcp",
      "options": { "enabled": false }
    }
  ],
  "update": "disable",
  "formatter": {
    "rustfmt": {
      "command": [
        "rustfmt",
        "$FILE"
      ],
      "extensions": [
        ".rs"
      ]
    }
  },
  "mcp": {
    "servers": {
      "context7-broker": {
        "type": "local",
        "command": [
          "/home/mirsella/.local/bin/context7-account-broker",
          "mcp"
        ],
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        },
        "disabled": false
      },
      "blender-mcp": {
        "type": "local",
        "command": [
          "/home/mirsella/.local/bin/uvx",
          "blender-mcp"
        ],
        "environment": {
          "BLENDER_HOST": "localhost",
          "BLENDER_PORT": "9876"
        },
        "disabled": true
      },
      "composio": {
        "type": "remote",
        "url": "https://backend.composio.dev/tool_router/trs_uiw6Hb4fJ8rr/mcp",
        "oauth": false,
        "headers": {
          "x-org-id": "ok_UWjDVhCpLy46",
          "x-project-id": "pr_ZEY9cNibczW1"
        },
        "disabled": false
      },
      "planetscale": {
        "type": "remote",
        "url": "https://mcp.pscale.dev/mcp/planetscale",
        "disabled": true
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" }{{ range $allowedProviders }},
    { "action": "provider.use", "resource": "{{ . }}", "effect": "allow" }{{ end }}
  ],
  "websearch": {
    "provider": "random"
  },
  "providers": {
    {{- if $llamaModel }}
    "llama.cpp": {
      "name": "Local llama.cpp",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "{{ $llamaModel }}": {
          "name": "{{ $llamaModel }}",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "settings": {
            "reasoning_format": "deepseek"
          },
          "variants": [
            {
              "id": "thinking",
              "settings": {
                "chat_template_kwargs": {
                  "enable_thinking": true
                }
              }
            }
          ],
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    {{- end }}
    "openai": {
      "settings": {
        "chunkTimeout": 180000,
        "baseURL": "http://127.0.0.1:17321/sleev/opencode/codex"
      },
      "models": {
        "gpt-6-luna": {},
        "gpt-6-sol-fast": {},
        "gpt-6-sol": {}
      }
    },
    // Keep OpenCode's free models direct; Sleev support remains unverified.
    // Keep opencode free of Sleev headers and baseURL overrides; openai,
    // opencode-go and claude-agent still route through the gateway.
    "opencode-go": {
      "settings": {
        "baseURL": "http://127.0.0.1:17321/sleev/opencode/opencode-go"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "settings": {
            "baseURL": "http://127.0.0.1:17321/sleev/opencode/opencode-go"
          }
        },
        "muse-spark-1.3-contributor": {
          "settings": {
            "baseURL": "http://127.0.0.1:17321/sleev/opencode/opencode-go"
          }
        },
        "beam-free": {
          "settings": {
            "baseURL": "http://127.0.0.1:17321/sleev/opencode/opencode-go"
          }
        }
      }
    },
    "claude-agent": {
      "settings": {
        "baseURL": "http://127.0.0.1:17321/sleev/opencode/anthropic"
      }
    }
  }
}
