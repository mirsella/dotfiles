{{- $llamaModel := "" -}}
{{- if eq .chezmoi.hostname "main" -}}
  {{- $llamaModel = "qwen3.6-27b-ablit" -}}
{{- else if eq .chezmoi.hostname "laptop" -}}
  {{- $llamaModel = "qwen3.6-35b-a3b-abliterated-v4" -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@pieliesdie/opencode-antigravity-auth@latest",
    "opencode-queue",
    "opencode-goal",
    "@mirsella/opencode-browser-mcp",
    "@mirsella/opencode-computer-use-mcp",
    "@mirsella/context7-account-broker",
  ],
  "autoupdate": false,
  "experimental": {
    "disable_paste_summary": true,
  },
  "formatter": {
    "rustfmt": {
      "command": ["rustfmt", "$FILE"],
      "extensions": [".rs"],
    },
  },
  "mcp": {
    "blender-mcp": {
      "type": "local",
      "command": ["/home/mirsella/.local/bin/uvx", "blender-mcp"],
      "enabled": false,
      "environment": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
      },
    },
    "composio": {
      "type": "remote",
      "url": "https://backend.composio.dev/tool_router/trs_uiw6Hb4fJ8rr/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "x-org-id": "ok_UWjDVhCpLy46",
        "x-project-id": "pr_ZEY9cNibczW1",
      },
    },
    "planetscale": {
      "type": "remote",
      "url": "https://mcp.pscale.dev/mcp/planetscale",
      "enabled": false,
    },
    "rea": {
      "type": "local",
      "command": ["rea", "mcp"],
      "enabled": false,
    },
  },
  "lsp": false,
  "permission": {
    "external_directory": "allow",
    "read": "allow",
  },
  "tools": {
    "todowrite": false,
    "lsp": false,
  },
  "compaction": {
    "prune": false,
  },
  "provider": {
    {{- if $llamaModel }}
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
      },
      "models": {
        "{{ $llamaModel }}": {
          "name": "{{ $llamaModel }}",
          "tool_call": true,
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "options": { "reasoning_format": "deepseek" },
          "variants": {
            "thinking": { "chat_template_kwargs": { "enable_thinking": true } },
            "low": { "disabled": true },
            "medium": { "disabled": true },
            "high": { "disabled": true },
          },
          "limit": { "context": 32768, "output": 8192 },
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
      },
    },
    {{- end }}
    "google": {
