    "openai": {
      "headers": {
        "sleev-provider": "codex",
        "sleev-harness": "opencode"
      },
      "settings": {
        "chunkTimeout": 180000,
        "baseURL": "http://127.0.0.1:17321"
      },
      "models": {
        "gpt-6-luna": {},
        "gpt-6-sol-fast": {},
        "gpt-6-sol": {}
      }
    },
    "opencode": {
      "headers": {
        "sleev-provider": "opencode",
        "sleev-harness": "opencode"
      },
      "settings": {
        "baseURL": "http://127.0.0.1:17321"
      },
      // The zen/go catalogs ship a per-model baseURL that beats the provider
      // settings above, bypassing sleev. Until that bug is fixed upstream, every
      // model that must route through sleev needs its own baseURL override.
      "models": {
        "deepseek-v4.1-flash-free": {
          "settings": {
            "baseURL": "http://127.0.0.1:17321"
          }
        },
        "deepseek-v4.1-flash": {
          "settings": {
            "baseURL": "http://127.0.0.1:17321"
          }
        },
        "beam-free": {
          "settings": {
            "baseURL": "http://127.0.0.1:17321"
          }
        }
      }
    },
    "opencode-go": {
      "headers": {
        "sleev-provider": "opencode-go",
        "sleev-harness": "opencode"
      },
      "settings": {
        "baseURL": "http://127.0.0.1:17321"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "settings": {
            "baseURL": "http://127.0.0.1:17321"
          }
        },
        "muse-spark-1.3-contributor": {
          "settings": {
            "baseURL": "http://127.0.0.1:17321"
          }
        },
        "beam-free": {
          "settings": {
            "baseURL": "http://127.0.0.1:17321"
          }
        }
      }
    },
    "deepinfra": {
      "headers": {
        "sleev-harness": "opencode",
        "sleev-base-url": "https://api.deepinfra.com/v1"
      },
      "settings": {
        "baseURL": "http://127.0.0.1:17321"
      }
