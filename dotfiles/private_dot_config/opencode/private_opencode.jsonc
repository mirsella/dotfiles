{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@pieliesdie/opencode-antigravity-auth@latest",
    "@plannotator/opencode",
    "opencode-queue",
    "opencode-goal",
    "@mirsella/opencode-browser-mcp",
    "@mirsella/context7-account-broker",
  ],
  "autoupdate": false,
  "experimental": {
    "disable_paste_summary": true,
  },
  "formatter": {
    "rustfmt": {
      "command": ["rustfmt", "$FILE"],
      "extensions": [".rs"],
    },
  },
  "mcp": {
    "blender-mcp": {
      "type": "local",
      "command": ["/home/mirsella/.local/bin/uvx", "blender-mcp"],
      "enabled": false,
      "environment": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
      },
    },
    "computer_use": {
      "type": "local",
      "command": ["computer-use-mcp", "mcp"],
      "enabled": false,
    },
    // "cloudflare": {
    //   "type": "remote",
    //   "url": "https://mcp.cloudflare.com/mcp",
    //   "enabled": false,
    // },
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true,
    },
    // "deepwiki": {
    //   "type": "remote",
    //   "url": "https://mcp.deepwiki.com/mcp",
    //   "enabled": false,
    // },
    // "posthog": {
    //   "type": "remote",
    //   "url": "https://mcp-eu.posthog.com/mcp",
    //   "enabled": false,
    // },
    // "railway": {
    //   "type": "local",
    //   "command": ["npx", "-y", "@railway/mcp-server"],
    //   "enabled": false,
    // },
    // "linear": {
    //   "type": "remote",
    //   "url": "https://mcp.linear.app/mcp",
    //   "enabled": false,
    // },
    // "google-drive": {
    //   "type": "local",
    //   "command": ["npx", "-y", "@piotr-agier/google-drive-mcp"],
    //   "enabled": false,
    // },
    "planetscale": {
      "type": "remote",
      "url": "https://mcp.pscale.dev/mcp/planetscale",
      "enabled": false,
    },
    // "resend": {
    //   "type": "local",
    //   "command": ["npx", "-y", "resend-mcp"],
    //   "enabled": false,
    //   "environment": {
    //     "RESEND_API_KEY": "{env:RESEND_API_KEY}",
    //   },
    // },
  },
  "lsp": false,
  "permission": {
    "external_directory": "allow",
    "read": "allow",
  },
  "tools": {
    "todowrite": false,
  },
  "compaction": {
    "prune": false,
  },
  "provider": {
    "google": {
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "high": { "thinkingLevel": "high" },
          },
        },
        "antigravity-gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro (Antigravity)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "high": { "thinkingLevel": "high" },
          },
        },
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash (Antigravity)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "variants": {
            "minimal": { "thinkingLevel": "minimal" },
            "low": { "thinkingLevel": "low" },
            "medium": { "thinkingLevel": "medium" },
            "high": { "thinkingLevel": "high" },
          },
        },
        "antigravity-gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash (Antigravity)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "variants": {
            "minimal": { "thinkingLevel": "minimal" },
            "low": { "thinkingLevel": "low" },
            "medium": { "thinkingLevel": "medium" },
            "high": { "thinkingLevel": "high" },
          },
        },
        "antigravity-gemini-3.6-flash": {
          "name": "Gemini 3.6 Flash (Antigravity)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "medium": { "thinkingLevel": "medium" },
            "high": { "thinkingLevel": "high" },
