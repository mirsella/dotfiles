    },
    "openai": {
      "models": {
        "gpt-6-luna": {
          "variants": {
            "none": {
              "disabled": true,
            },
            "minimal": {
              "disabled": true,
            },
            "low": {
              "disabled": true,
            },
            "medium": {
              "disabled": true,
            },
            "high": {
              "disabled": true,
            },
            "xhigh": {
              "disabled": true,
            },
          },
        },
        "gpt-6-sol-fast": {
          "variants": {
            "none": {
              "disabled": true,
            },
            "minimal": {
              "disabled": true,
            },
          },
        },
        "gpt-6-sol": {
          "variants": {
            "none": {
              "disabled": true,
            },
            "minimal": {
              "disabled": true,
            },
          },
        },
      },
      "options": {
        "chunkTimeout": 180000,
        "headers": {
          "sleev-provider": "codex",
          "sleev-harness": "opencode",
        },
        "baseURL": "http://127.0.0.1:17321",
      },
    },
    "opencode": {
      "options": {
        "headers": {
          "sleev-provider": "opencode",
          "sleev-harness": "opencode",
        },
        "baseURL": "http://127.0.0.1:17321",
      },
    },
    "opencode-go": {
      "options": {
        "headers": {
          "sleev-provider": "opencode-go",
          "sleev-harness": "opencode",
        },
        "baseURL": "http://127.0.0.1:17321",
      },
    },
    "github-copilot": {
      "options": {
        "headers": {
          "sleev-provider": "copilot",
          "sleev-harness": "opencode",
        },
        "baseURL": "http://127.0.0.1:17321",
      },
    },
    "deepinfra": {
      "options": {
        "baseURL": "http://127.0.0.1:17321",
        "headers": {
          "sleev-harness": "opencode",
          "sleev-base-url": "https://api.deepinfra.com/v1",
        },
      },
    },
    "abliteration-ai": {
      "options": {
        "baseURL": "http://127.0.0.1:17321",
        "headers": {
          "sleev-harness": "opencode",
          "sleev-base-url": "https://api.abliteration.ai/v1",
        },
      },
    },
    "crof": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nahcrof",
      "options": {
        "baseURL": "http://127.0.0.1:17321",
        "headers": {
          "sleev-harness": "opencode",
          "sleev-base-url": "https://crof.ai/v1",
        },
      },
    },
  },
}
