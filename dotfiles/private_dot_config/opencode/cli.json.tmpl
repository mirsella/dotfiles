{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "mode": "system",
    "name": "rosepine-moon"
  },
  "prompt": {
    "paste": "full",
    "image_preview": false
  },
  "plugins": [
    "file://{{ .chezmoi.homeDir }}/.config/opencode/tui-plugins/cache-timer"
  ],
  "keybinds": {
    "session.move": "ctrl+alt+w"
  },
  "session": {
    "sidebar": "hide",
    "verbosity": "medium",
    "scrollbar": false,
    "thinking": "hide",
    "grouping": "auto",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "mode": "auto",
    "scope": "global"
  },
  "attention": {
    "notifications": true
  }
}
