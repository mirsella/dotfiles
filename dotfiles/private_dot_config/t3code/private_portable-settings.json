{
  "version": 1,
  "client": {
    "browserRecordingShowKeyPresses": true,
    "browserRecordingShowMousePresses": true,
    "favorites": [
      {
        "model": "opencode-go/step-5-preview-free",
        "provider": "opencode"
      }
    ],
    "followUpBehavior": "queue",
    "inAppNotificationsEnabled": true,
    "notificationMode": "notifications",
    "persistComposerContextStrip": true,
    "redesignEnabled": false,
    "snapShotEnabled": true,
    "snapShotPlaySound": false,
    "snapShotShortcut": {
      "altKey": false,
      "ctrlKey": false,
      "key": "t",
      "metaKey": true,
      "modKey": false,
      "shiftKey": true
    },
    "timestampFormat": "24-hour",
    "wordWrap": false
  },
  "server": {
    "addProjectBaseDirectory": "~/dev",
    "autoResumeLimitedThreads": true,
    "branchNamePrefix": "",
    "defaultAutoPull": true,
    "defaultModelSelection": {
      "instanceId": "opencode",
      "model": "openai/gpt-6.1-sol",
      "options": [
        {
          "id": "variant",
          "value": "high"
        }
      ]
    },
    "defaultThreadEnvMode": "local",
    "favorites": [
      {
        "model": "opencode-go/deepseek-v4.1-flash",
        "provider": "opencode"
      },
      {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "provider": "opencode"
      },
      {
        "model": "openai/gpt-6-luna",
        "provider": "opencode"
      },
      {
        "model": "openai/gpt-6-astra",
        "provider": "opencode"
      },
      {
        "model": "openai/gpt-6.1-sol",
        "provider": "opencode"
      }
    ],
    "guestSharingEnabled": true,
    "idleCompaction": "onReturn",
    "removeAgentCreditsOnMerge": true,
    "sidebarAutoSettleAfterDays": null,
    "storageCleanup": {
      "browserArtifactsAfterDays": 8,
      "logsAfterDays": 8,
      "worktreeAfterDays": 3,
      "worktreeOnDelete": true,
      "worktreeOnMerge": true,
      "worktreeSettledAfterDays": 1,
      "worktreeUnchanged": true
    }
  },
  "desktop": {
    "localEnvironmentEnabled": false,
    "serverExposureMode": "network-accessible"
  },
  "providers": {
    "claudeAgent": {
      "driver": "claudeAgent",
      "enabled": false
    },
    "codex": {
      "config": {
        "binaryPath": "~/.local/bin/codex"
      },
      "driver": "codex",
      "enabled": true
    },
    "opencode": {
      "config": {
        "binaryPath": "~/.opencode/bin/opencode"
      },
      "displayName": "OpenCode",
      "driver": "opencode",
      "enabled": true
    }
  },
  "keybindings": [
    {
      "command": "threadPanel.toggle",
      "key": "mod+shift+b",
      "when": "!terminalFocus"
    },
    {
      "command": "rightPanel.new",
      "key": "mod+t",
      "when": "rightPanelOpen && !terminalFocus"
    },
    {
      "command": "view.reopenClosed",
      "key": "mod+shift+t"
    },
    {
      "command": "thread.editQueuedMessage",
      "key": "alt+arrowup",
      "when": "composerFocus"
    },
    {
      "command": "composer.sendAlternate",
      "key": "mod+enter",
      "when": "composerFocus && turnRunning"
    },
    {
      "command": "composer.sendBackground",
      "key": "mod+enter",
      "when": "composerFocus && draftThreadRoute"
    },
    {
      "command": "composer.sendBackground",
      "key": "mod+alt+enter",
      "when": "composerFocus && draftThreadRoute"
    },
    {
      "command": "composer.sendAndNewThread",
      "key": "mod+alt+enter",
      "when": "composerFocus && !draftThreadRoute"
    },
    {
      "command": "chat.find",
      "key": "mod+f",
      "when": "!terminalFocus && !previewFocus"
    },
    {
      "command": "sidebar.toggle",
      "key": "mod+b"
    },
    {
      "command": "navigation.back",
      "key": "mod+[",
      "when": "!terminalFocus"
    },
    {
      "command": "navigation.forward",
      "key": "mod+]",
      "when": "!terminalFocus"
    },
    {
      "command": "terminal.toggle",
      "key": "mod+j"
    },
    {
      "command": "rightPanel.toggle",
      "key": "mod+alt+b"
    },
    {
      "command": "terminal.split",
      "key": "mod+d",
      "when": "terminalFocus"
    },
    {
      "command": "terminal.splitVertical",
      "key": "mod+shift+d",
      "when": "terminalFocus"
    },
    {
      "command": "terminal.new",
      "key": "mod+n",
      "when": "terminalFocus"
    },
    {
      "command": "terminal.close",
      "key": "mod+w",
      "when": "terminalFocus"
    },
    {
      "command": "rightPanel.close",
      "key": "mod+w",
      "when": "!terminalFocus"
    },
    {
      "command": "diff.toggle",
      "key": "mod+d",
      "when": "!terminalFocus"
    },
    {
      "command": "preview.toggle",
      "key": "mod+shift+j"
    },
    {
      "command": "preview.refresh",
      "key": "mod+r",
      "when": "previewFocus"
    },
    {
      "command": "preview.focusUrl",
      "key": "mod+l",
      "when": "previewFocus"
    },
    {
      "command": "preview.zoomIn",
      "key": "mod+=",
      "when": "previewFocus"
    },
    {
      "command": "preview.zoomIn",
      "key": "mod++",
      "when": "previewFocus"
    },
    {
      "command": "preview.zoomOut",
      "key": "mod+-",
      "when": "previewFocus"
    },
    {
      "command": "preview.resetZoom",
      "key": "mod+0",
      "when": "previewFocus"
    },
    {
      "command": "commandPalette.toggle",
      "key": "mod+k",
      "when": "!terminalFocus"
    },
    {
      "command": "filePicker.toggle",
      "key": "mod+p",
      "when": "!terminalFocus"
    },
    {
      "command": "projectSearch.toggle",
      "key": "mod+shift+f",
      "when": "!terminalFocus"
    },
    {
      "command": "usage.open",
      "key": "mod+u",
      "when": "!terminalFocus"
    },
    {
      "command": "theme.select",
      "key": "mod+alt+a",
      "when": "!terminalFocus"
    },
    {
      "command": "appearance.cycle",
      "key": "mod+alt+shift+a",
      "when": "!terminalFocus"
    },
    {
      "command": "themeEditor.toggle",
      "key": "mod+alt+shift+t"
    },
    {
      "command": "composer.stash",
      "key": "mod+s",
      "when": "!terminalFocus"
    },
    {
      "command": "thread.steerQueuedMessage",
      "key": "mod+shift+enter",
      "when": "!terminalFocus"
    },
    {
      "command": "chat.new",
      "key": "mod+n",
      "when": "!terminalFocus"
    },
    {
      "command": "chat.new",
      "key": "mod+shift+o",
      "when": "!terminalFocus"
    },
    {
      "command": "chat.newLocal",
      "key": "mod+shift+n",
      "when": "!terminalFocus"
    },
    {
      "command": "chat.newWithoutProject",
      "key": "mod+alt+n",
      "when": "!terminalFocus"
    },
    {
      "command": "modelPicker.toggle",
      "key": "mod+shift+m",
      "when": "!terminalFocus"
    },
    {
      "command": "composer.host",
      "key": "mod+shift+h",
      "when": "!terminalFocus"
    },
    {
      "command": "composer.effort",
      "key": "mod+shift+e",
      "when": "!terminalFocus"
    },
    {
      "command": "composer.mode",
      "key": "mod+shift+a",
      "when": "!terminalFocus"
    },
    {
      "command": "composer.workspace",
      "key": "mod+shift+x",
      "when": "!terminalFocus"
    },
    {
      "command": "composer.branch",
      "key": "mod+shift+g",
      "when": "!terminalFocus"
    },
    {
      "command": "composer.previousWorktree",
      "key": "mod+shift+l",
      "when": "!terminalFocus"
    },
    {
      "command": "pullRequest.copyNumber",
      "key": "mod+shift+k",
      "when": "!terminalFocus"
    },
    {
      "command": "modelPicker.previousProvider",
      "key": "mod+shift+arrowup",
      "when": "modelPickerOpen"
    },
    {
      "command": "modelPicker.nextProvider",
      "key": "mod+shift+arrowdown",
      "when": "modelPickerOpen"
    },
    {
      "command": "editor.openFavorite",
      "key": "mod+o"
    },
    {
      "command": "thread.previous",
      "key": "mod+shift+["
    },
    {
      "command": "thread.next",
      "key": "mod+shift+]"
    },
    {
      "command": "thread.copyReference",
      "key": "mod+shift+c",
      "when": "!terminalFocus"
    },
    {
      "command": "thread.settle",
      "key": "mod+shift+s",
      "when": "!terminalFocus"
    },
    {
      "command": "thread.pin",
      "key": "mod+shift+p",
      "when": "!terminalFocus"
    },
    {
      "command": "thread.undo",
      "key": "mod+z",
      "when": "!terminalFocus && !editableFocus"
    },
    {
      "command": "thread.jump.1",
      "key": "mod+1",
      "when": "isDesktop"
    },
    {
      "command": "thread.jump.2",
      "key": "mod+2",
      "when": "isDesktop"
    },
    {
      "command": "thread.jump.3",
      "key": "mod+3",
      "when": "isDesktop"
    },
    {
      "command": "thread.jump.4",
      "key": "mod+4",
      "when": "isDesktop"
    },
    {
      "command": "thread.jump.5",
      "key": "mod+5",
      "when": "isDesktop"
    },
    {
      "command": "thread.jump.6",
      "key": "mod+6",
      "when": "isDesktop"
    },
    {
      "command": "thread.jump.7",
      "key": "mod+7",
      "when": "isDesktop"
    },
    {
      "command": "thread.jump.8",
      "key": "mod+8",
      "when": "isDesktop"
    },
    {
      "command": "thread.jump.9",
      "key": "mod+9",
      "when": "isDesktop"
    },
    {
      "command": "modelPicker.jump.1",
      "key": "mod+1",
      "when": "modelPickerOpen && isDesktop"
    },
    {
      "command": "modelPicker.jump.2",
      "key": "mod+2",
      "when": "modelPickerOpen && isDesktop"
    },
    {
      "command": "modelPicker.jump.3",
      "key": "mod+3",
      "when": "modelPickerOpen && isDesktop"
    },
    {
      "command": "modelPicker.jump.4",
      "key": "mod+4",
      "when": "modelPickerOpen && isDesktop"
    },
    {
      "command": "modelPicker.jump.5",
      "key": "mod+5",
      "when": "modelPickerOpen && isDesktop"
    },
    {
      "command": "modelPicker.jump.6",
      "key": "mod+6",
      "when": "modelPickerOpen && isDesktop"
    },
    {
      "command": "modelPicker.jump.7",
      "key": "mod+7",
      "when": "modelPickerOpen && isDesktop"
    },
    {
      "command": "modelPicker.jump.8",
      "key": "mod+8",
      "when": "modelPickerOpen && isDesktop"
    },
    {
      "command": "modelPicker.jump.9",
      "key": "mod+9",
      "when": "modelPickerOpen && isDesktop"
    },
    {
      "command": "usage.cost",
      "key": "c",
      "when": "usagePageOpen"
    },
    {
      "command": "usage.tokens",
      "key": "t",
      "when": "usagePageOpen"
    },
    {
      "command": "usage.limits",
      "key": "l",
      "when": "usagePageOpen"
    },
    {
      "command": "usage.period.day",
      "key": "mod+shift+1",
      "when": "usagePageOpen"
    },
    {
      "command": "usage.period.week",
      "key": "mod+shift+2",
      "when": "usagePageOpen"
    },
    {
      "command": "usage.period.month",
      "key": "mod+shift+3",
      "when": "usagePageOpen"
    },
    {
      "command": "usage.period.quarter",
      "key": "mod+shift+4",
      "when": "usagePageOpen"
    }
  ],
  "projects": [
    {
      "workspace_root": "~/dev/browser-mcp",
      "attributes": {
        "faviconPath": null,
        "projectIcon": null,
        "title": "browser-mcp"
      },
      "settings": {}
    },
    {
      "workspace_root": "~/dev/computer-use-mcp",
      "attributes": {
        "faviconPath": null,
        "projectIcon": null,
        "title": "computer-use-mcp"
      },
      "settings": {}
    },
    {
      "workspace_root": "~/dev/dotfiles",
      "attributes": {
        "faviconPath": null,
        "projectIcon": null,
        "title": "dotfiles"
      },
      "settings": {
        "defaultThreadEnvMode": "local"
      }
    },
    {
      "workspace_root": "~/dev/mightyminions/main",
      "attributes": {
        "faviconPath": "web/public/icons/icon-only.png",
        "projectIcon": null,
        "title": "mightyminions"
      },
      "settings": {
        "defaultProjectScripts": [
          {
            "command": "just bc -m",
            "icon": "play",
            "id": "bc",
            "name": "bc",
            "runOnWorktreeCreate": false
          },
          {
            "command": "just bsp -m",
            "icon": "play",
            "id": "bsp",
            "name": "bsp",
            "runOnWorktreeCreate": false
          },
          {
            "command": "just bc --backend-url http://localhost:3000 -m",
            "icon": "play",
            "id": "bc-local-backend",
            "name": "bc local backend",
            "runOnWorktreeCreate": false
          },
          {
            "command": "just assets",
            "icon": "configure",
            "id": "assets",
            "name": "assets",
            "runOnWorktreeCreate": false
          },
          {
            "async": false,
            "command": "sh -c 'exec sh \"$T3CODE_PROJECT_ROOT/scripts/setup-worktree.sh\"'",
            "icon": "configure",
            "id": "setup-worktree",
            "name": "Setup Worktree",
            "runOnWorktreeCreate": true
          }
        ],
        "defaultThreadEnvMode": "worktree"
      }
    },
    {
      "workspace_root": "~/dev/opencode-queue",
      "attributes": {
        "faviconPath": null,
        "projectIcon": null,
        "title": "opencode-queue"
      },
      "settings": {}
    },
    {
      "workspace_root": "~/dev/voxride-dashboard",
      "attributes": {
        "faviconPath": "~/dev/voxride-dashboard/src/app/icon.svg",
        "projectIcon": null,
        "title": "voxride-dashboard"
      },
      "settings": {
        "defaultThreadEnvMode": "worktree"
      }
    },
    {
      "workspace_root": "~/dev/voxride-website",
      "attributes": {
        "faviconPath": "~/dev/voxride-website/public/favicon.ico",
        "projectIcon": null,
        "title": "voxride-website"
      },
      "settings": {
        "defaultThreadEnvMode": "worktree"
      }
    }
  ]
}
