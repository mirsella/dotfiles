sourceDir = "/home/mirsella/dev/dotfiles"
encryption = "age"

[age]
{{ if eq .chezmoi.hostname "predator" -}}
identity = "/home/mirsella/.ssh/id_ed25519"
{{ else -}}
identity = "~/.ssh/id_ed25519"
{{ end -}}
recipients = [
	"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGkl0CiN6/cLz1OOzBvHaPAMKTnYI0sOlKFDRW25uReF",
	"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMXuc6N//8+RfjUhuRZ+COgynjfwFqAeoKAWMUz6s+Pe",
	"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIO0TM27fa/fDI2DvCsBnVxgVKA7iugQQsSrnsPmyG9Lv",
	"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHALDtwhSj8AF8NdRRjcWcDkD/EeDnRcWYjRSbXSznTo",
	]

[hooks.re-add.pre]
command = "sh"
args = ["-ec", "if command -v t3-settings >/dev/null 2>&1; then t3-settings capture --if-running; fi; if command -v hex-settings >/dev/null 2>&1; then hex-settings capture --if-present; fi"]

[hooks.apply.post]
command = "sh"
args = [
	"-ec",
	"dry=; case \" $CHEZMOI_ARGS \" in *\" --dry-run\"*|*\" -n\"*) dry=--dry-run;; esac; if command -v t3-settings >/dev/null 2>&1; then t3-settings sync --if-running --no-capture $dry; fi; if command -v hex-settings >/dev/null 2>&1; then hex-settings sync --if-present --no-capture $dry; fi",
]

[git]
	autoCommit = true
	autoPush = true
	# .chezmoiroot leaves Nix files outside the paths targetRelPath can handle.
	commitMessageTemplate = {{ `Update dotfiles

{{ output "git" "-C" .chezmoi.workingTree "diff" "--cached" "--name-status" }}` | quote }}
