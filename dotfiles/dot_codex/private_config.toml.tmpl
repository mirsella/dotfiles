{{ $mcp := include "private_dot_config/agent-tools/mcp.json" | fromJson -}}
{{ range $name, $server := $mcp.servers }}
[mcp_servers.{{ $name }}]
{{ if eq $server.type "stdio" -}}
command = {{ $server.command | toJson }}
args = {{ $server.args | toJson }}
{{ else -}}
url = {{ $server.url | toJson }}
{{ end -}}
enabled = {{ $server.enabled }}
{{ if hasKey $server "toolTimeoutSec" -}}
tool_timeout_sec = {{ $server.toolTimeoutSec }}
{{ end -}}
{{ if hasKey $server "headersHelper" -}}
http_headers_helper = {{ $server.headersHelper | toJson }}
{{ end -}}
{{ if hasKey $server "env" }}
[mcp_servers.{{ $name }}.env]
{{ range $key, $value := $server.env -}}
{{ $key }} = {{ $value | toJson }}
{{ end -}}
{{ end -}}
{{ if hasKey $server "headers" }}
[mcp_servers.{{ $name }}.http_headers]
{{ range $key, $value := $server.headers -}}
{{ $key }} = {{ $value | toJson }}
{{ end -}}
{{ end -}}
{{ end }}

