[Unit]
Description=Remove old Nix and Docker trees after verified subvolume boot
After=local-fs.target nix-daemon.service docker.service
Wants=nix-daemon.service docker.service
RequiresMountsFor=/nix /var/lib/docker
ConditionPathExists=!/run/arch-rollback-cleanup-defer

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/cleanup-rollback.py
ExecStartPost=/usr/bin/systemctl disable arch-rollback-cleanup.service
TimeoutStartSec=0
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
